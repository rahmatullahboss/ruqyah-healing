---
import '../styles/global.css';
import BottomNav from '../components/BottomNav.astro';
import AIAgent from '../components/AIAgent.astro';
import Analytics from '../components/Analytics.astro';
import { ClientRouter } from 'astro:transitions';
import { getWhatsappUrl } from '../data/clinic.js';
import { buildSiteSchemas, buildAlternateLinks } from '../lib/seo.js';
import { getLocaleMeta, normalizeLocale } from '../lib/i18n.js';
import { DEFAULT_FLOATING_WHATSAPP } from '../lib/floating-whatsapp.js';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  articleDate?: string;
  articleAuthor?: string;
  articleAuthorUrl?: string;
  articleSection?: string;
  keywords?: string[];
  noindex?: boolean;
  locale?: 'bn' | 'en';
}

const {
  title = 'রুকইয়াহ হিলিং সেন্টার | Ruqyah Healing Center',
  description = 'ইসলামী রুকইয়ার মাধ্যমে হালাল হিলিং সার্ভিস। কুরআন এবং সুন্নাহ ভিত্তিক চিকিৎসা পদ্ধতিতে আপনার আধ্যাত্মিক ও শারীরিক সুস্থতা নিশ্চিত করুন।',
  ogImage = '/images/hero-bg.webp',
  ogType = 'website',
  articleDate,
  articleAuthor = 'মুফতী মুহাম্মাদ আল-আমীন',
  articleAuthorUrl = '/author',
  articleSection,
  keywords = ['রুকইয়াহ', 'ইসলামিক হিলিং', 'জ্বীন', 'বদনজর', 'কালো জাদু', 'ruqyah', 'islamic healing'],
  noindex = false,
  locale = 'bn',
} = Astro.props;

const siteUrl   = Astro.site?.origin || 'https://ruqyahhealing.com';
const currentLocale = normalizeLocale(locale);
const localeMeta = getLocaleMeta(currentLocale);
const alternateLinks = buildAlternateLinks(siteUrl, Astro.url.pathname, currentLocale);
const canonicalUrl = alternateLinks.canonical;
const ogImageFull  = new URL(ogImage, siteUrl).href;
const siteName = 'রুকইয়াহ হিলিং সেন্টার';
const siteSchemas = buildSiteSchemas(siteUrl, siteName, description);
const floatingWhatsappHref = getWhatsappUrl(
  DEFAULT_FLOATING_WHATSAPP.message,
  DEFAULT_FLOATING_WHATSAPP.number,
);
---
<!doctype html>
<html lang={localeMeta.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <meta name="author" content={articleAuthor} />
    <meta name="theme-color" content="#10B981" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="bn-BD" href={`${siteUrl}${alternateLinks.alternates.bn}`} />
    <link rel="alternate" hreflang="en-US" href={`${siteUrl}${alternateLinks.alternates.en}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${alternateLinks.alternates.xDefault}`} />
    <link rel="icon" type="image/png" href="/images/ruqyah-logo.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- AI Context for LLMs -->
    <link rel="author" href="/llms.txt" />

    <!-- Open Graph / Facebook -->
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageFull} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={localeMeta.ogLocale} />
    {ogType === 'article' && articleDate && (
      <meta property="article:published_time" content={articleDate} />
    )}
    {ogType === 'article' && articleAuthor && (
      <meta property="article:author" content={articleAuthor} />
    )}
    {ogType === 'article' && articleSection && (
      <meta property="article:section" content={articleSection} />
    )}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageFull} />

    <!-- Preconnect to Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Async Google Fonts (non-render-blocking) -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;600;700&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Raleway:wght@300;400;500;600;700&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;600;700&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Raleway:wght@300;400;500;600;700&display=swap"
      />
    </noscript>

    <!-- Preload hero background image for fast LCP -->
    <link rel="preload" as="image" href="/images/hero-bg.webp" type="image/webp" fetchpriority="high" />

    <!-- Slot for page-specific head content (e.g. JSON-LD) -->
    {siteSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
    <slot name="head" />

    <!-- Astro View Transitions (official API from astro:transitions) -->
    <ClientRouter fallback="swap" />
    <Analytics />
  </head>
  <body>
    <a href="#main-content" class="skip-to-content">মূল বিষয়বস্তুতে যান</a>
    <div id="main-content">
      <slot />
    </div>
    <BottomNav />

    <!-- WhatsApp Floating Button -->
    <a
      href={floatingWhatsappHref}
      target="_blank"
      rel="noopener noreferrer"
      class="wa-float"
      id="floatingWhatsappBtn"
      aria-label="WhatsApp এ যোগাযোগ করুন"
      title="WhatsApp এ যোগাযোগ করুন"
    >
      <svg width="28" height="28" viewBox="0 0 24 24" fill="white">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
      <span class="wa-tooltip" id="floatingWhatsappLabel">{DEFAULT_FLOATING_WHATSAPP.label}</span>
    </a>
    <AIAgent />
    <script>
      function escapeHtml(value) {
        return String(value)
          .replaceAll('&', '&amp;')
          .replaceAll('<', '&lt;')
          .replaceAll('>', '&gt;')
          .replaceAll('"', '&quot;')
          .replaceAll("'", '&#39;');
      }

      function getPrimaryWhatsappContact(contacts) {
        return contacts.find((contact) => contact.type === 'whatsapp' || contact.type === 'both') || contacts[0] || null;
      }

      function getPrimaryCallContact(contacts) {
        return contacts.find((contact) => contact.type === 'call' || contact.type === 'both') || contacts[0] || null;
      }

      function createWhatsappHref(number, message) {
        if (!number) return '#';
        return `https://wa.me/${number}${message ? `?text=${encodeURIComponent(message)}` : ''}`;
      }

      function renderFooterPhones(contacts) {
        const container = document.getElementById('footerContactPhoneList');
        if (!container) return;

        const isPolishedFooter = container.dataset.footerStyle === 'polished';
        const visibleContacts = isPolishedFooter ? contacts.slice(0, 3) : contacts;

        const phoneItems = visibleContacts.map((contact) => {
          const suffix = contact.type === 'whatsapp' ? ' (WhatsApp)' : contact.type === 'call' ? ' (কল)' : '';

          if (isPolishedFooter) {
            return `
              <li>
                <span class="footer-contact-icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.24h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.18 6.18l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg></span>
                <span>${escapeHtml(contact.label)}: ${escapeHtml(contact.display)}${escapeHtml(suffix)}</span>
              </li>
            `;
          }

          return `
            <li>
              <span class="footer-lottie-icon footer-lottie-icon--phone" data-footer-lottie aria-hidden="true"><span class="footer-lottie-animation"></span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.24h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.18 6.18l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg></span>
              <span>${escapeHtml(contact.label)}: ${escapeHtml(contact.display)}${escapeHtml(suffix)}</span>
            </li>
          `;
        }).join('');

        const preservedItems = isPolishedFooter
          ? Array.from(container.querySelectorAll('[data-footer-static]')).map((item) => item.outerHTML).join('')
          : Array.from(container.querySelectorAll('li')).slice(-4).map((item) => item.outerHTML).join('');

        container.innerHTML = phoneItems + preservedItems;
        if (!isPolishedFooter) window.initFooterLottieIcons?.();
      }

      function renderTeamPhones(contacts) {
        const container = document.getElementById('teamPhoneList');
        if (!container) return;

        container.innerHTML = contacts.map((contact) => {
          const phoneValue = escapeHtml(contact.display);
          const label = escapeHtml(contact.label);
          const supportsCall = contact.type === 'call' || contact.type === 'both';
          const supportsWhatsapp = contact.type === 'whatsapp' || contact.type === 'both';
          const callButton = supportsCall ? `<a href="tel:${phoneValue}" class="phone-call">কল</a>` : '';
          const phoneText = supportsCall
            ? `<a href="tel:${phoneValue}" class="phone-number">${phoneValue}</a>`
            : `<span class="phone-number">${phoneValue}</span>`;
          const whatsappButton = supportsWhatsapp
            ? `<a href="${createWhatsappHref(contact.international, 'আসসালামু আলাইকুম, আমি রাকীর সাথে যোগাযোগ করতে চাই।')}" target="_blank" rel="noopener noreferrer" class="phone-wa">WhatsApp</a>`
            : '';

          return `
            <div class="phone-item">
              <div>
                <p class="phone-label">${label}</p>
                ${phoneText}
              </div>
              <div class="phone-actions">
                ${callButton}
                ${whatsappButton}
              </div>
            </div>
          `;
        }).join('');
      }

      function renderAppointmentPhones(contacts) {
        const container = document.getElementById('appointmentPhoneList');
        if (!container) return;

        container.innerHTML = contacts.map((contact) => {
          const phoneValue = escapeHtml(contact.display);
          const label = escapeHtml(contact.label);
          const supportsCall = contact.type === 'call' || contact.type === 'both';
          const supportsWhatsapp = contact.type === 'whatsapp' || contact.type === 'both';
          const phoneText = supportsCall
            ? `<a href="tel:${phoneValue}" class="contact-value">${phoneValue}</a>`
            : `<span class="contact-value">${phoneValue}</span>`;
          const callButton = supportsCall ? `<a class="contact-call" href="tel:${phoneValue}">কল</a>` : '';
          const whatsappButton = supportsWhatsapp
            ? `<a class="contact-wa" href="${createWhatsappHref(contact.international, 'আসসালামু আলাইকুম, অ্যাপয়েন্টমেন্ট সম্পর্কে জানতে চাই।')}" target="_blank" rel="noopener">WhatsApp</a>`
            : '';

          return `
            <div class="contact-row">
              <div>
                <p class="contact-label">${label}</p>
                ${phoneText}
              </div>
              <div class="contact-actions">
                ${callButton}
                ${whatsappButton}
              </div>
            </div>
          `;
        }).join('');
      }

      function applyText(id, value) {
        const element = document.getElementById(id);
        if (element && value) {
          element.textContent = value;
        }
      }

      async function syncPublicSiteSettings() {
        try {
          const res = await fetch('/api/settings/public');
          if (!res.ok) return;

          const data = await res.json();
          const contacts = Array.isArray(data.clinicPhones) ? data.clinicPhones : [];
          const schedule = data.clinicSchedule || {};
          const payment = data.paymentDetails || {};
          const social = data.socialLinks || {};
          const floatingWhatsapp = data.floatingWhatsapp || {};

          const primaryWhatsapp = getPrimaryWhatsappContact(contacts);
          const primaryCall = getPrimaryCallContact(contacts);

          const floatingButton = document.getElementById('floatingWhatsappBtn');
          const floatingLabel = document.getElementById('floatingWhatsappLabel');
          if (floatingButton && floatingLabel) {
            if (floatingWhatsapp.enabled === false) {
              floatingButton.style.display = 'none';
            } else {
              floatingButton.style.display = '';
              const label = floatingWhatsapp.label || '{DEFAULT_FLOATING_WHATSAPP.label}';
              floatingLabel.textContent = label;
              floatingButton.setAttribute('aria-label', label);
              floatingButton.setAttribute('title', label);
              floatingButton.href = createWhatsappHref(
                floatingWhatsapp.number || '{DEFAULT_FLOATING_WHATSAPP.number}',
                floatingWhatsapp.message || '{DEFAULT_FLOATING_WHATSAPP.message}',
              );
            }
          }

          if (contacts.length) {
            renderFooterPhones(contacts);
            renderTeamPhones(contacts);
            renderAppointmentPhones(contacts);

            applyText('homePrimaryPhoneText', `WhatsApp-এ যোগাযোগ করুন: ${primaryCall?.display || primaryWhatsapp?.display || ''}`);
            applyText('enHomePrimaryPhone', primaryCall?.display || primaryWhatsapp?.display || '');
            applyText('enAppointmentPhoneText', contacts.map((item) => item.display).join(' / '));

            const teamPrimaryWhatsappCta = document.getElementById('teamPrimaryWhatsappCta');
            if (teamPrimaryWhatsappCta && primaryWhatsapp) {
              teamPrimaryWhatsappCta.href = createWhatsappHref(primaryWhatsapp.international, 'আসসালামু আলাইকুম, আমি রাকীর সাথে যোগাযোগ করতে চাই।');
            }

            const footerWhatsappLink = document.getElementById('footerWhatsappLink');
            if (footerWhatsappLink && primaryWhatsapp) {
              footerWhatsappLink.href = createWhatsappHref(primaryWhatsapp.international, 'আসসালামু আলাইকুম, অ্যাপয়েন্টমেন্ট সম্পর্কে জানতে চাই।');
            }

            const appointmentTimeLink = document.getElementById('appointmentTimeLink');
            if (appointmentTimeLink && primaryWhatsapp) {
              appointmentTimeLink.href = createWhatsappHref(primaryWhatsapp.international, 'আসসালামু আলাইকুম, আমি অ্যাপয়েন্টমেন্টের সময় সম্পর্কে জানতে চাই।');
            }

            const appointmentQuickBookingLink = document.getElementById('appointmentQuickBookingLink');
            if (appointmentQuickBookingLink && primaryWhatsapp) {
              appointmentQuickBookingLink.href = createWhatsappHref(primaryWhatsapp.international, 'আসসালামু আলাইকুম, আমি দ্রুত অ্যাপয়েন্টমেন্ট বুক করতে চাই।');
            }

            const enAppointmentWhatsappLink = document.getElementById('enAppointmentWhatsappLink');
            if (enAppointmentWhatsappLink && primaryWhatsapp) {
              enAppointmentWhatsappLink.href = createWhatsappHref(primaryWhatsapp.international, 'Assalamu Alaikum, I want to book an appointment.');
            }

            const enAppointmentTakeLink = document.getElementById('enAppointmentTakeLink');
            if (enAppointmentTakeLink && primaryWhatsapp) {
              enAppointmentTakeLink.href = createWhatsappHref(primaryWhatsapp.international, 'Assalamu Alaikum, I want to book an appointment.');
            }

            const enHomeWhatsappLink = document.getElementById('enHomeWhatsappLink');
            if (enHomeWhatsappLink && primaryWhatsapp) {
              enHomeWhatsappLink.href = createWhatsappHref(primaryWhatsapp.international, 'Assalamu Alaikum, I want to discuss my condition in English.');
            }

            const homePrimaryWhatsappLink = document.getElementById('homePrimaryWhatsappLink');
            if (homePrimaryWhatsappLink && primaryWhatsapp) {
              homePrimaryWhatsappLink.href = createWhatsappHref(primaryWhatsapp.international, 'আসসালামু আলাইকুম, সেবা সম্পর্কে জানতে চাই।');
            }
          }

          applyText('footerScheduleCombined', `${schedule.days || ''} | ${schedule.hours || ''}`.trim());
          applyText('teamScheduleDays', schedule.days || '');
          applyText('teamScheduleHours', schedule.hours || '');
          applyText('appointmentScheduleDays', schedule.days || '');
          applyText('appointmentScheduleHours', schedule.hours || '');
          applyText('enAppointmentScheduleText', `${schedule.days || ''} · ${schedule.hours || ''}`.trim());

          applyText('appointmentBookingFee', payment.bookingFee || '');
          applyText('appointmentBankName', payment.bankName || '');
          applyText('appointmentBankBranch', payment.branch || '');
          applyText('appointmentAccountName', payment.accountName || '');
          applyText('appointmentAccountNumber', payment.accountNumber || '');
          applyText('appointmentAccountPhone', payment.accountPhone || '');

          const footerFacebookLink = document.getElementById('footerFacebookLink');
          if (footerFacebookLink && social.facebook) {
            footerFacebookLink.href = social.facebook;
          }
        } catch {
          // Keep static fallback markup if runtime settings fail.
        }
      }

      syncPublicSiteSettings();
      document.addEventListener('astro:page-load', syncPublicSiteSettings);
    </script>
  </body>
</html>
