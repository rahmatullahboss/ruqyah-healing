---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { getWhatsappUrl } from '../data/clinic.js';
import { DEFAULT_FLOATING_WHATSAPP } from '../lib/floating-whatsapp.js';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'রুকইয়াহ চিকিৎসা বুক করুন | Ruqyah Healing Center',
  description = 'কুরআন ও সুন্নাহ ভিত্তিক রুকইয়াহ চিকিৎসা বুক করুন। জিন, জাদু ও বদনজরের কার্যকর সমাধান।',
} = Astro.props;

const siteUrl = Astro.site?.origin || 'https://ruqyahhealing.com';
const floatingWhatsappHref = getWhatsappUrl(
  DEFAULT_FLOATING_WHATSAPP.message,
  DEFAULT_FLOATING_WHATSAPP.number,
);
---
<!doctype html>
<html lang="bn">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#10B981" />
    <link rel="icon" type="image/png" href="/images/ruqyah-logo.png" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content="/images/hero-bg.webp" />

    <!-- Preconnect to Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;600;700&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Raleway:wght@300;400;500;600;700&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;600;700&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Raleway:wght@300;400;500;600;700&display=swap"
      />
    </noscript>

    <ClientRouter fallback="swap" />
  </head>
  <body class="landing-body">
    <slot />

    <!-- Floating WhatsApp Button -->
    <a
      href={floatingWhatsappHref}
      target="_blank"
      rel="noopener noreferrer"
      class="wa-float"
      id="floatingWhatsappBtn"
      aria-label="WhatsApp এ যোগাযোগ করুন"
      title="WhatsApp এ যোগাযোগ করুন"
    >
      <svg width="28" height="28" viewBox="0 0 24 24" fill="white">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
      <span class="wa-tooltip" id="floatingWhatsappLabel">{DEFAULT_FLOATING_WHATSAPP.label}</span>
    </a>

    <script>
      function createWhatsappHref(number, message) {
        if (!number) return '#';
        return `https://wa.me/${number}${message ? `?text=${encodeURIComponent(message)}` : ''}`;
      }

      async function syncFloatingWhatsapp() {
        try {
          const res = await fetch('/api/settings/public');
          if (!res.ok) return;
          const data = await res.json();
          const floatingWhatsapp = data.floatingWhatsapp || {};
          const contacts = Array.isArray(data.clinicPhones) ? data.clinicPhones : [];
          const primaryWa = contacts.find((c: any) => c.type === 'whatsapp' || c.type === 'both') || contacts[0];

          const btn = document.getElementById('floatingWhatsappBtn');
          const label = document.getElementById('floatingWhatsappLabel');
          if (btn && label) {
            if (floatingWhatsapp.enabled === false) {
              btn.setAttribute('style', 'display:none');
            } else {
              btn.href = createWhatsappHref(
                floatingWhatsapp.number || primaryWa?.international || '',
                floatingWhatsapp.message || 'আসসালামু আলাইকুম, রুকইয়াহ সেবা বুক করতে চাই।',
              );
              const labelText = floatingWhatsapp.label || '{DEFAULT_FLOATING_WHATSAPP.label}';
              label.textContent = labelText;
            }
          }
        } catch {}
      }

      syncFloatingWhatsapp();
      document.addEventListener('astro:page-load', syncFloatingWhatsapp);
    </script>
  </body>
</html>