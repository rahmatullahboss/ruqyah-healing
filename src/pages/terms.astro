---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export const prerender = true;

const lastUpdated = '৪ জুলাই, ২০২৬';

const termsSections = [
  {
    title: '১. সার্ভিস ব্যবহারের সম্মতি',
    items: [
      'এই ওয়েবসাইট ব্যবহার, অ্যাপয়েন্টমেন্ট বুকিং, ডায়াগনোসিস ফর্ম পূরণ বা আমাদের সাথে যোগাযোগ করার মাধ্যমে আপনি এই শর্তাবলির সাথে সম্মত হচ্ছেন।',
      'আপনি যদি এই শর্তাবলির কোনো অংশে সম্মত না হন, তাহলে অনুগ্রহ করে ওয়েবসাইট বা সার্ভিস ব্যবহার করবেন না।',
    ],
  },
  {
    title: '২. আমাদের সেবার ধরন',
    items: [
      'Ruqyah Healing Center রুকইয়াহ, হিজামা, কনসাল্টেশন, ডায়াগনোসিস, সাপ্লিমেন্ট, গাইড, কোর্স এবং সংশ্লিষ্ট সহায়ক সার্ভিস দিতে পারে।',
      'সার্ভিসের ধরন, সময়, ফি, সেশন পদ্ধতি এবং অ্যাভেইলেবিলিটি সময় অনুযায়ী পরিবর্তন হতে পারে।',
      'অনলাইন বা অফলাইন সেশনের ক্ষেত্রে প্রয়োজনীয় প্রস্তুতি, সময়মতো উপস্থিতি এবং সঠিক তথ্য দেওয়া ব্যবহারকারীর দায়িত্ব।',
    ],
  },
  {
    title: '৩. মেডিকেল ও ধর্মীয় ডিসক্লেইমার',
    items: [
      'রুকইয়াহ একটি ইসলামী শরিয়াহসম্মত আমল ও আধ্যাত্মিক সহায়তা; এটি জরুরি চিকিৎসা বা বিশেষজ্ঞ মেডিকেল কেয়ারের বিকল্প নয়।',
      'গুরুতর শারীরিক বা মানসিক সমস্যা, জরুরি অবস্থা, আত্মহানির ঝুঁকি, তীব্র ব্যথা বা বিপজ্জনক উপসর্গ থাকলে দ্রুত যোগ্য ডাক্তার, হাসপাতাল বা জরুরি সেবার সহায়তা নিন।',
      'কোনো ওষুধ, চিকিৎসা বা ডাক্তারের পরামর্শ বন্ধ করার আগে অবশ্যই সংশ্লিষ্ট চিকিৎসকের পরামর্শ নিন।',
    ],
  },
  {
    title: '৪. ব্যবহারকারীর দায়িত্ব',
    items: [
      'আপনাকে সঠিক, আপডেটেড এবং সত্য তথ্য দিতে হবে। ভুল তথ্যের কারণে সেবা, পরামর্শ বা বুকিংয়ে সমস্যা হলে তার দায় ব্যবহারকারীর।',
      'অন্য ব্যক্তির তথ্য ব্যবহার করলে তার সম্মতি নেওয়া আপনার দায়িত্ব।',
      'অশালীন আচরণ, প্রতারণা, ভুয়া বুকিং, হুমকি, হয়রানি বা সার্ভিসের অপব্যবহার করা যাবে না।',
      'ওয়েবসাইটের নিরাপত্তা নষ্ট করা, অননুমোদিত অ্যাক্সেসের চেষ্টা করা বা ডাটা/কন্টেন্ট কপি করে অপব্যবহার করা নিষিদ্ধ।',
    ],
  },
  {
    title: '৫. অ্যাপয়েন্টমেন্ট, পেমেন্ট ও বাতিলকরণ',
    items: [
      'অ্যাপয়েন্টমেন্ট নিশ্চিতকরণ সাধারণত ফোন, WhatsApp, ইমেইল বা ওয়েবসাইটের মাধ্যমে জানানো হতে পারে।',
      'পেমেন্ট, রিফান্ড, রিশিডিউল বা বাতিলকরণের নিয়ম সেবার ধরন অনুযায়ী আলাদা হতে পারে এবং বুকিংয়ের সময় জানানো হতে পারে।',
      'আপনি নির্ধারিত সময়ে উপস্থিত না হলে বা দেরি করলে সেশন সংক্ষিপ্ত, বাতিল বা রিশিডিউল হতে পারে।',
      'বিশেষ পরিস্থিতিতে Ruqyah Healing Center অ্যাপয়েন্টমেন্ট পরিবর্তন, স্থগিত বা বাতিল করার অধিকার রাখে।',
    ],
  },
  {
    title: '৬. কনটেন্ট ও ইন্টেলেকচুয়াল প্রপার্টি',
    items: [
      'ওয়েবসাইটের লেখা, ডিজাইন, লোগো, গাইড, পিডিএফ, কোর্স ম্যাটেরিয়াল, ছবি ও অন্যান্য কনটেন্ট Ruqyah Healing Center বা সংশ্লিষ্ট মালিকের সম্পদ।',
      'ব্যক্তিগত ব্যবহার ছাড়া অনুমতি ছাড়া কপি, রিপাবলিশ, বিক্রি, পরিবর্তন বা বাণিজ্যিকভাবে ব্যবহার করা যাবে না।',
      'শিক্ষামূলক কনটেন্ট ব্যবহার করলে উৎস উল্লেখ করা এবং কপিরাইট সম্মান করা আবশ্যক।',
    ],
  },
  {
    title: '৭. থার্ড-পার্টি লিংক ও সার্ভিস',
    items: [
      'ওয়েবসাইটে তৃতীয় পক্ষের পেমেন্ট, অ্যানালিটিক্স, সোশ্যাল মিডিয়া, ভিডিও, ম্যাপ বা অন্যান্য লিংক থাকতে পারে।',
      'থার্ড-পার্টি সার্ভিসের নিজস্ব নীতি ও শর্তাবলি প্রযোজ্য হবে; তাদের কোনো সমস্যা, ক্ষতি বা ডাটা ব্যবহারের জন্য আমরা দায়ী নই।',
    ],
  },
  {
    title: '৮. দায়সীমা',
    items: [
      'ওয়েবসাইট বা সার্ভিস ব্যবহারের ফলাফল ব্যক্তি, অবস্থা, পরিস্থিতি ও আল্লাহর ইচ্ছার উপর নির্ভরশীল; নির্দিষ্ট ফলাফলের নিশ্চয়তা দেওয়া হয় না।',
      'টেকনিক্যাল সমস্যা, ইন্টারনেট সমস্যা, ভুল তথ্য, বিলম্ব, তৃতীয় পক্ষের সমস্যা বা ব্যবহারকারীর অপব্যবহারের কারণে ক্ষতির জন্য Ruqyah Healing Center দায়ী থাকবে না।',
    ],
  },
];
---

<BaseLayout title="টার্মস অ্যান্ড কন্ডিশনস | Ruqyah Healing Center" description="Ruqyah Healing Center-এর ওয়েবসাইট, অ্যাপয়েন্টমেন্ট, রুকইয়াহ, হিজামা ও সংশ্লিষ্ট সার্ভিস ব্যবহারের নিয়ম ও শর্তাবলি।">
  <Header />

  <main>
    <section class="legal-hero">
      <div class="container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">হোম</a><span>/</span><span>টার্মস অ্যান্ড কন্ডিশনস</span>
        </nav>
        <div class="legal-hero-card">
          <span class="eyebrow">Terms & Conditions</span>
          <h1>টার্মস অ্যান্ড কন্ডিশনস</h1>
          <p>Ruqyah Healing Center-এর ওয়েবসাইট, অ্যাপয়েন্টমেন্ট, রুকইয়াহ, হিজামা, কনসাল্টেশন ও সংশ্লিষ্ট সার্ভিস ব্যবহারের নিয়ম ও শর্তাবলি।</p>
          <div class="updated-pill">সর্বশেষ আপডেট: {lastUpdated}</div>
        </div>
      </div>
    </section>

    <section class="legal-section">
      <div class="container legal-layout">
        <aside class="legal-sidebar">
          <div class="sidebar-card">
            <h2>সংক্ষেপে</h2>
            <p>আমাদের সেবা গ্রহণের আগে শর্তগুলো পড়ে নিন। রুকইয়াহ/হিজামা জরুরি চিকিৎসার বিকল্প নয় এবং ব্যক্তিগত অবস্থাভেদে ফলাফল ভিন্ন হতে পারে।</p>
            <a href="/privacy">প্রাইভেসি পলিসি দেখুন</a>
          </div>
        </aside>

        <article class="legal-content">
          <div class="notice-box">
            <strong>গুরুত্বপূর্ণ:</strong> এই শর্তাবলি ব্যবহারকারীর সাথে Ruqyah Healing Center-এর সাধারণ ব্যবহারিক সম্পর্ক ব্যাখ্যা করে। নির্দিষ্ট সার্ভিস, পেমেন্ট বা বুকিংয়ের ক্ষেত্রে আলাদা নির্দেশনা প্রযোজ্য হতে পারে।
          </div>

          {termsSections.map((section) => (
            <section class="legal-card">
              <h2>{section.title}</h2>
              <ul>
                {section.items.map((item) => <li>{item}</li>)}
              </ul>
            </section>
          ))}

          <section class="legal-card">
            <h2>৯. সার্ভিস পরিবর্তন বা বন্ধ করার অধিকার</h2>
            <p>আমরা প্রয়োজন অনুযায়ী ওয়েবসাইট, কনটেন্ট, ফিচার, সার্ভিস, মূল্য, অ্যাভেইলেবিলিটি বা নিয়ম পরিবর্তন, স্থগিত বা বন্ধ করতে পারি।</p>
          </section>

          <section class="legal-card">
            <h2>১০. শর্তাবলি পরিবর্তন</h2>
            <p>এই টার্মস অ্যান্ড কন্ডিশনস সময়ে সময়ে আপডেট হতে পারে। পরিবর্তনের পর ওয়েবসাইট ব্যবহার করলে আপডেটেড শর্তাবলির সাথে সম্মতি দেওয়া হয়েছে বলে ধরা হবে।</p>
          </section>

          <section class="legal-card contact-card">
            <h2>১১. যোগাযোগ</h2>
            <p>এই শর্তাবলি সম্পর্কে কোনো প্রশ্ন থাকলে আমাদের সাথে যোগাযোগ করুন।</p>
            <div class="contact-actions">
              <a href="mailto:info@ruqyahhealing.com">info@ruqyahhealing.com</a>
              <a href="/appointment">অ্যাপয়েন্টমেন্ট নিন</a>
            </div>
          </section>
        </article>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
.legal-hero {
  padding: 34px 0 42px;
  background:
    radial-gradient(circle at 12% 20%, rgba(16,185,129,0.12), transparent 28%),
    radial-gradient(circle at 88% 4%, rgba(245,158,11,0.12), transparent 30%),
    linear-gradient(180deg, #fbfffd 0%, #edf9f3 100%);
  border-bottom: 1px solid rgba(4,120,87,0.12);
}
.breadcrumb {
  display: flex;
  gap: 8px;
  align-items: center;
  color: var(--text-muted);
  font-size: 14px;
  margin-bottom: 24px;
}
.breadcrumb a { color: var(--primary); text-decoration: none; font-weight: 700; }
.legal-hero-card {
  max-width: 900px;
  border: 1px solid rgba(4,120,87,0.14);
  border-radius: 28px;
  background: rgba(255,255,255,0.72);
  box-shadow: 0 22px 70px rgba(6,78,59,0.08);
  padding: clamp(28px, 5vw, 52px);
}
.eyebrow {
  display: inline-flex;
  margin-bottom: 14px;
  color: #047857;
  font-size: 12px;
  font-weight: 850;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}
.legal-hero h1 {
  margin: 0 0 14px;
  color: #052e24;
  font-size: clamp(34px, 5vw, 62px);
  letter-spacing: -0.04em;
  line-height: 1.05;
}
.legal-hero p {
  max-width: 760px;
  margin: 0 0 18px;
  color: rgba(5,46,36,0.72);
  font-size: 17px;
  line-height: 1.8;
}
.updated-pill {
  display: inline-flex;
  padding: 9px 14px;
  border-radius: 999px;
  background: rgba(16,185,129,0.1);
  color: #047857;
  font-size: 13px;
  font-weight: 800;
}
.legal-section { padding: 52px 0 76px; background: #fbfffd; }
.legal-layout {
  display: grid;
  grid-template-columns: 310px minmax(0, 1fr);
  gap: 30px;
  align-items: start;
}
.legal-sidebar { position: sticky; top: 104px; }
.sidebar-card,
.legal-card,
.notice-box {
  border: 1px solid rgba(4,120,87,0.12);
  border-radius: 22px;
  background: #fff;
  box-shadow: 0 14px 38px rgba(6,78,59,0.06);
}
.sidebar-card { padding: 22px; }
.sidebar-card h2 { margin: 0 0 10px; color: #052e24; font-size: 19px; }
.sidebar-card p { margin: 0 0 16px; color: rgba(5,46,36,0.68); line-height: 1.7; font-size: 14px; }
.sidebar-card a { color: #047857; font-weight: 800; text-decoration: none; }
.legal-content { display: grid; gap: 18px; }
.notice-box {
  padding: 18px 20px;
  background: linear-gradient(135deg, rgba(16,185,129,0.09), rgba(245,158,11,0.08));
  color: rgba(5,46,36,0.8);
  line-height: 1.75;
}
.notice-box strong { color: #047857; }
.legal-card { padding: clamp(22px, 3vw, 30px); }
.legal-card h2 {
  margin: 0 0 14px;
  color: #052e24;
  font-size: clamp(20px, 2vw, 26px);
  letter-spacing: -0.02em;
}
.legal-card p,
.legal-card li {
  color: rgba(5,46,36,0.74);
  font-size: 15px;
  line-height: 1.85;
}
.legal-card p { margin: 0; }
.legal-card ul { margin: 0; padding-left: 22px; display: grid; gap: 8px; }
.contact-card { background: linear-gradient(135deg, #ecfdf5, #ffffff); }
.contact-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 18px; }
.contact-actions a {
  display: inline-flex;
  align-items: center;
  min-height: 42px;
  padding: 10px 16px;
  border-radius: 999px;
  background: var(--primary);
  color: #fff;
  font-weight: 800;
  text-decoration: none;
}
.contact-actions a:first-child { background: #052e24; }
@media (max-width: 900px) {
  .legal-layout { grid-template-columns: 1fr; }
  .legal-sidebar { position: static; }
}
@media (max-width: 600px) {
  .legal-hero { padding: 24px 0 32px; }
  .legal-section { padding: 34px 0 56px; }
  .breadcrumb { font-size: 13px; margin-bottom: 18px; }
  .legal-hero-card { border-radius: 22px; }
  .legal-hero p { font-size: 15px; }
}
</style>
