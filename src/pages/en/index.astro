const videos = [
  { id: 'A60hb-x5VrE', title: 'Ruqyah Healing Video', url: 'https://youtu.be/A60hb-x5VrE' },
  { id: 'NFFmFAZLOl8', title: 'Ruqyah and Islamic Healing Guide', url: 'https://youtu.be/NFFmFAZLOl8' },
  { id: 'AvsAw8F7Q6Y', title: 'Learn About Ruqyah Services', url: 'https://youtu.be/AvsAw8F7Q6Y' },
