---

<BaseLayout
  title="Ruqyah Healing Center | Islamic Ruqyah Healing Center — Dhaka, Bangladesh"
  description="Islamic ruqyah treatment center — Quran and Sunnah-based spiritual and physical wellness. Shariah-compliant Ruqyah, Hijama & Acupuncture healing in Dhaka, Bangladesh."
  keywords={['ruqyah', 'islamic healing', 'ruqyah Dhaka', 'hijama', 'jinn treatment', 'black magic removal', 'evil eye cure', 'spiritual healing Bangladesh']}
  locale="en"
>
  <Header />

  <main class="home-page">
    <!-- ① Hero -->
    <Hero />

    <!-- ①.5 What is Ruqyah? -->
    <section class="section definition-section reveal">
      <div class="container">
        <div class="definition-grid">
          <div class="definition-bn scroll-reveal">
            <h2>What is Ruqyah?</h2>
            <p class="definition-text">
              <strong>Ruqyah</strong> is the treatment of spiritual and physical illnesses through Quranic verses and supplications mentioned in hadith. It is a halal treatment method recognized in Islam and is used for <em>jinn-related affliction, magic, evil eye</em>, and mental distress.
            </p>
          </div>
          <div class="definition-video scroll-reveal" style="--stagger-delay:100ms">
            <div class="definition-video-embed">
              <iframe
                src="https://www.youtube.com/embed/A60hb-x5VrE?rel=0"
                title="Ruqyah Healing Video"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                loading="lazy"
              ></iframe>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ④ Our services (8-card grid) -->
    <section class="section reveal">
      <div class="container">
        <div class="section-header scroll-reveal">
          <h2>Our Services</h2>
          <p>Our specialized services for your wellness through Islamic methods.</p>
        </div>
        <div class="grid-4 services-grid">
          {services.map((service, i) => (
            <div class="scroll-reveal-child svc-wrap" style={`--stagger-delay: ${i * 60}ms`}>
              <ServiceCard {...service} />
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ⑥ Our videos -->
    <section class="section videos-section reveal">
      <div class="container">
        <div class="section-header scroll-reveal">
          <h2>Our Videos</h2>
          <p>Watch service and awareness videos from Ruqyah Healing Center.</p>
        </div>
        <div class="video-grid">
          {videos.map((v, i) => (
            <article class="video-card scroll-reveal-child" style={`--stagger-delay:${i * 60}ms`}>
              <div class="video-embed">
                <iframe
                  src={`https://www.youtube.com/embed/${v.id}?rel=0`}
                  title={v.title}
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  allowfullscreen
                ></iframe>
              </div>
              <a href={v.url} target="_blank" rel="noopener" class="video-title">{v.title}</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Product Section -->
    <section class="section product-section reveal">
      <div class="container">
        <div class="section-header scroll-reveal">
          <span class="section-kicker">Shop</span>
          <h2>Products</h2>
          <p>Some demo products for ruqyah, hijama, and natural care.</p>
        </div>

        <div class="product-grid">
          {demoProducts.map((product, i) => (
            <article class="product-card scroll-reveal-child" style={`--stagger-delay:${i * 70}ms`}>
              <div class="product-media">
                <span class="product-icon" aria-hidden="true">{product.icon}</span>
                <span class="product-badge">{product.badge}</span>
              </div>
              <div class="product-body">
                <span class="product-category">{product.category}</span>
                <h3>{product.title}</h3>
                <p>{product.note}</p>
                <div class="product-footer">
                  <strong>{product.price}</strong>
                  <a href={getWhatsappUrl(`Assalamu Alaikum, I would like to know more about the ${product.title} product.`)} target="_blank" rel="noopener" class="product-order-btn">Order Now</a>
                </div>
              </div>
            </article>
          ))}
        </div>

        <div class="product-cta-wrap">
          <a href="/en/supplements" class="btn btn-primary">View All Products</a>
        </div>
      </div>
    </section>

    <!-- Courses Preview Section -->
    <section class="section courses-preview-section reveal">
      <div class="container">
        <div class="section-header scroll-reveal">
          <span class="section-kicker">Courses</span>
          <h2>Our Courses</h2>
          <p>Gain Islamic knowledge through our training courses.</p>
        </div>

        <div class="courses-preview-grid">
          {coursesList.map((course, i) => {
            const courseSummary = course.shortDescription || course.desc || 'A structured course for learning ruqyah and Islamic healing.';
            return (
              <a href={course.href || `/en/courses/${course.id}`} class="course-preview-card scroll-reveal-child" style={`--stagger-delay:${i * 70}ms`}>
                <div class="course-preview-img">
                  <img src={course.image} alt={course.title} loading="lazy" decoding="async" />
                  <span class="course-card-badge">{course.level}</span>
                </div>
                <div class="course-preview-body">
                  <div class="course-card-meta">
                    <span>{course.category}</span>
                    <span>{course.classCount}</span>
                  </div>
                  <h3>{course.title}</h3>
                  <p>{courseSummary}</p>
                  <div class="course-card-footer">
                    <strong>{getCoursePreviewPrice(course)}</strong>
                    <span class="course-view-more">View Details →</span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>

        <div class="courses-cta-wrap">
          <a href="/en/courses" class="btn btn-outline">View All Courses</a>
        </div>
      </div>
    </section>


    <!-- ⑧ Our packages -->

    <section class="section reveal">
      <div class="container">
        <div class="section-header scroll-reveal">
          <h2>Our Service Packages</h2>
          <p>Take service at your convenience through chamber, home service, or online support.</p>
        </div>
        <div class="pkg-grid">

          <!-- 1. Ruqyah -->
          <div class="pkg-card-v2 scroll-reveal-child" style="--stagger-delay:0ms">
            <div class="pkg-thumb">
              <img src="/images/pkg-ruqyah.webp" alt="Ruqyah package" loading="lazy" width="600" height="600" />
              <span class="pkg-badge">☪️ Ruqyah</span>
            </div>
            <div class="pkg-body">
              <h3>Ruqyah Treatment</h3>
              <p>Quran and Sunnah-based spiritual treatment. Effective support for jinn, magic, and evil eye concerns.</p>
              <div class="pkg-variants">
                <a href={ruqyahBookingLink} target="_blank" rel="noopener" class="pkg-btn pkg-btn--center">
                  🏢 Chamber Service
                </a>
                <a href="/en/appointment" class="pkg-btn pkg-btn--home">
                  📋 View All Options
                </a>
                <a href={getWhatsappUrl('Assalamu Alaikum, I would like to know more about ruqyah home service.')} target="_blank" rel="noopener" class="pkg-btn pkg-btn--home">
                  🏠 Home Service
                </a>
              </div>
            </div>
          </div>

          <!-- 2. Hijama -->
          <div class="pkg-card-v2 scroll-reveal-child" style="--stagger-delay:80ms">
            <div class="pkg-thumb">
              <img src="/images/pkg-hijama.webp" alt="Hijama package" loading="lazy" width="600" height="600" />
              <span class="pkg-badge">🩸 Hijama</span>
            </div>
            <div class="pkg-body">
              <h3>Hijama Therapy</h3>
              <p>Sunnah-compliant cupping therapy. Islamic care support for physical wellness and recovery.</p>
              <div class="pkg-variants">
                <a href={hijamaBookingLink} target="_blank" rel="noopener" class="pkg-btn pkg-btn--center">
                  🏢 Chamber Service
                </a>
                <a href="/en/appointment" class="pkg-btn pkg-btn--home">
