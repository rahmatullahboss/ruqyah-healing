    desc: 'Halal supplement routine guide.',
    href: '/en/supplements',
  },
  {
    id: 'demo-ruqyah-downloads',
    title: 'Ruqyah Reading Resource Guide',
    instructor: 'Ruqyah Healing Team',
    classCount: '3 classes',
    hours: '1.5 hours',
    level: 'Free Resource',
    price: 0,
    salePrice: null,
    category: 'Downloads',
    image: '/images/services/service-download.svg',
