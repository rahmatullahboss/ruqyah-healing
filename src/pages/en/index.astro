const coursesList = liveCoursesList.length > 0 ? liveCoursesList : demoCourses;
const testimonialList = await db.select().from(testimonials).where(eq(testimonials.published, true)).orderBy(desc(testimonials.orderIndex)).limit(6);
const blogs = allPosts
  .slice(0, 6)
  .map((post) => ({
    date: new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }),
    category: post.category ? getEnglishCategoryLabel(post.category) : 'Ruqyah',
    title: getEnglishPostMeta(post.slug, { title: post.title }).title,
    excerpt: getEnglishPostMeta(post.slug, { excerpt: post.excerpt }).excerpt ?? '',
    href: `/en/posts/${post.slug}`,
  }));

const services = [
  {
    title: 'Ruqyah',
