---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/HeroEn.astro';
import Footer from '../../components/Footer.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import BlogCard from '../../components/BlogCard.astro';
import { env as workerEnv } from 'cloudflare:workers';
import { createDb } from '../../db/client.js';
import { getAllPosts } from '../../lib/posts.js';
import { courseLessons, courseModules, courses, testimonials } from '../../db/schema.js';
import { clinicNumbers, clinicSchedule, getWhatsappUrl, primaryPhoneContact } from '../../data/clinic.js';
import { buildFaqSchema } from '../../lib/seo.js';
import { desc, eq, inArray } from 'drizzle-orm';
import { getEnglishCategoryLabel, getEnglishPostMeta } from '../../data/en-content';
import { filterPublicReadyCourses, groupCourseContentRows } from '../../lib/lms-admin.js';

export const prerender = false;

const env = workerEnv || process.env;
const db = createDb(env.DATABASE_URL);

const allPosts = await getAllPosts(db);

const publishedCourses = await db.select()
  .from(courses)
  .where(eq(courses.status, 'published'))
  .orderBy(desc(courses.createdAt));
const publishedCourseIds = publishedCourses.map((course) => course.id);
const [publishedModules, publishedLessons] = publishedCourseIds.length > 0
  ? await Promise.all([
      db.select().from(courseModules).where(inArray(courseModules.courseId, publishedCourseIds)),
      db.select().from(courseLessons).where(inArray(courseLessons.courseId, publishedCourseIds)),
    ])
  : [[], []];
const liveCoursesList = filterPublicReadyCourses(groupCourseContentRows({
  courses: publishedCourses,
  modules: publishedModules,
  lessons: publishedLessons,
})).map((row) => row.course).slice(0, 8);
const formatEnNumber = (value) => new Intl.NumberFormat('en-US').format(value);
const getCoursePreviewPrice = (course) => {
  const basePrice = Number(course.price || 0);
  const salePrice = Number(course.salePrice || 0);
  const effectivePrice = salePrice > 0 && salePrice < basePrice ? salePrice : basePrice;
  return effectivePrice > 0 ? `BDT ${formatEnNumber(effectivePrice)}` : 'Free';
};

const demoCourses = [
  {
    id: 'demo-ruqyah-foundation',
    title: 'Ruqyah Foundation Course',
    instructor: 'Omar Hasan Azmi',
    classCount: '8 classes',
    hours: '6 hours',
    level: 'Beginner',
    price: 0,
    salePrice: null,
    category: 'Ruqyah',
