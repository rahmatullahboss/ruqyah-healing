---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { env as workerEnv } from 'cloudflare:workers';
import { createDb } from '../../../db/client.js';
import { posts as postsTable } from '../../../db/schema.js';
import { eq } from 'drizzle-orm';
import { getPostBySlug, getRelatedPosts } from '../../../lib/posts.js';
import { renderMarkdown, calculateReadingTime, sanitizeHtml, extractTextFromHtml } from '../../../lib/markdown.js';
import { getEnglishCategoryLabel, getEnglishPostBodyHtml, getEnglishPostMeta } from '../../../data/en-content';

export const prerender = true;

export async function getStaticPaths() {
  const env = (workerEnv || process.env) as any;
  const db = createDb(env.DATABASE_URL);
  const rows = await db.select({ slug: postsTable.slug }).from(postsTable).where(eq(postsTable.published, true));
  return rows.map((row) => ({ params: { slug: row.slug } }));
}

const { slug } = Astro.params;
const env = (workerEnv || process.env) as any;
const db = createDb(env.DATABASE_URL);

const post = await getPostBySlug(db, slug);
if (!post) {
  return Astro.redirect('/en/blog');
}

const englishMeta = getEnglishPostMeta(post.slug, {
  title: post.title,
  excerpt: post.excerpt,
});
const categoryLabel = getEnglishCategoryLabel(post.category);
const related = await getRelatedPosts(db, post.category, post.slug, 3);
const englishBodyHtml = getEnglishPostBodyHtml(post.slug);
const contentHtml = englishBodyHtml
  ? englishBodyHtml
  : post.contentHtml
    ? sanitizeHtml(post.contentHtml)
    : renderMarkdown(post.content);
const plainText = englishBodyHtml
  ? extractTextFromHtml(englishBodyHtml)
  : post.contentHtml
    ? extractTextFromHtml(post.contentHtml)
    : post.content;
const wordCount = plainText.trim().split(/\s+/).filter(Boolean).length;
const readingTime = calculateReadingTime(plainText);
const tags = (Array.isArray(post.tags) ? post.tags : []) as string[];
const siteUrl = Astro.site?.origin || 'https://ruqyahhealing.com';
const postUrl = `${siteUrl}/en/posts/${post.slug}`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.excerpt,
  url: postUrl,
  datePublished: post.date,
  dateModified: post.date,
  inLanguage: 'en-US',
  author: {
    '@type': 'Person',
    name: 'Ruqyah Healing Center',
    url: `${siteUrl}/en/author`,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Ruqyah Healing Center',
    url: siteUrl,
    logo: {
      '@type': 'ImageObject',
      url: `${siteUrl}/images/ruqyah-logo.png`,
    },
  },
  keywords: tags.join(', '),
  articleSection: post.category,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': postUrl,
  },
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/en/` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteUrl}/en/blog` },
    { '@type': 'ListItem', position: 3, name: categoryLabel, item: `${siteUrl}/en/category/${post.category}` },
    { '@type': 'ListItem', position: 4, name: englishMeta.title, item: postUrl },
  ],
};
const formattedDate = new Date(post.date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={`${englishMeta.title} | Ruqyah Healing`}
  description={englishMeta.excerpt}
  ogType="article"
  articleDate={post.date}
  articleAuthor="Ruqyah Healing Center"
  articleAuthorUrl="/en/author"
  articleSection={post.category}
  keywords={tags}
  locale="en"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />

  <Header />

  <main>
    <section class="hero">
      <div class="container">
        <nav class="breadcrumb">
          <a href="/en/">Home</a><span>›</span><a href="/en/blog">Blog</a><span>›</span><a href={`/en/category/${post.category}`}>{categoryLabel}</a>
        </nav>
        <span class="badge">{categoryLabel}</span>
        <h1>{englishMeta.title}</h1>
        <p class="meta">
          {formattedDate} · {readingTime} min read · ~{wordCount} words
        </p>
        <p class="excerpt">{englishMeta.excerpt}</p>
      </div>
    </section>

    <section class="section">
      <div class="container content">
        <article class="prose">
          <Fragment set:html={contentHtml} />
        </article>

        {tags.length > 0 && (
          <div class="tags">
            <strong>Tags:</strong>
            {tags.map((tag: string) => <span class="tag">#{tag}</span>)}
          </div>
        )}
      </div>
    </section>

    {related.length > 0 && (
      <section class="section alt">
        <div class="container">
          <h2>Related Posts</h2>
          <div class="grid">
            {related.map((item: (typeof related)[number]) => (
              <a href={`/en/posts/${item.slug}`} class="card">
                <span class="small">{getEnglishCategoryLabel(item.category)}</span>
                <h3>{getEnglishPostMeta(item.slug, { title: item.title }).title}</h3>
                <p>{getEnglishPostMeta(item.slug, { excerpt: item.excerpt }).excerpt.substring(0, 110)}...</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>

  <Footer />
</BaseLayout>

<style>
  .hero { background: linear-gradient(145deg, #022c22 0%, #065f46 100%); color: #fff; padding: 62px 0 50px; }
  .breadcrumb { display: flex; gap: 8px; color: rgba(255,255,255,0.66); font-size: 13px; margin-bottom: 14px; }
  .badge { display: inline-flex; padding: 4px 11px; border-radius: 999px; background: rgba(255,255,255,0.2); font-size: 12px; margin-bottom: 8px; }
  h1 { max-width: 760px; line-height: 1.3; margin-bottom: 8px; }
  .meta { color: rgba(255,255,255,0.72); font-size: 14px; margin-bottom: 8px; }
  .excerpt { max-width: 760px; color: rgba(255,255,255,0.84); }
  .section { padding: 34px 0 56px; }
  .content { max-width: 820px; }
  .tags { margin-top: 18px; display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .tag { border: 1px solid var(--border); border-radius: 999px; padding: 4px 10px; font-size: 12px; }
  .alt { background: var(--bg-light); }
  h2 { margin-bottom: 16px; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .card { border: 1px solid var(--border); border-radius: 12px; padding: 14px; background: #fff; }
  .card .small { font-size: 12px; color: var(--primary-dark); font-weight: 600; }
  .card h3 { margin: 8px 0; font-size: 16px; }
  .card p { color: var(--text-muted); font-size: 14px; line-height: 1.6; }
  @media (max-width: 900px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 620px) { .grid { grid-template-columns: 1fr; } }
</style>
