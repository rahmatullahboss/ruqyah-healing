---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/Header.astro';
import { createDb } from '../../../../db/client.js';
import { courseQuizQuestions, courseQuizAttempts } from '../../../../db/schema.js';
import { eq, and, desc } from 'drizzle-orm';
import { env as workerEnv } from 'cloudflare:workers';
import { ArrowLeft, Clock, Trophy, AlertCircle } from '@lucide/astro';
import { getQuizAccess } from '../../../../lib/lms-access.js';

export const prerender = false;

const { id: courseId, quizId } = Astro.params;
const env = workerEnv || process.env;
const db = createDb((env as any).DATABASE_URL);
const user = (Astro.locals as any).user;

if (!user) return Astro.redirect('/login');

const quizAccess = await getQuizAccess(db, { user, courseId, quizId });
if (!quizAccess.allowed) return Astro.redirect(`/courses/${courseId}/learn`);
const quiz = [quizAccess.quiz];

// Get questions
const questions = await db.select().from(courseQuizQuestions)
  .where(eq(courseQuizQuestions.quizId, quizId))
  .orderBy(courseQuizQuestions.sortOrder);

// Get previous attempts
const attempts = await db.select().from(courseQuizAttempts)
  .where(and(eq(courseQuizAttempts.userId, user.id), eq(courseQuizAttempts.quizId, quizId)))
  .orderBy(desc(courseQuizAttempts.createdAt));

const canAttempt = !quiz[0].maxAttempts || attempts.length < quiz[0].maxAttempts;
const bestScore = attempts.length > 0 ? Math.max(...attempts.map(a => a.score)) : 0;
const hasPassed = attempts.some(a => a.passed);
---

<BaseLayout title={`${quiz[0].title} | কুইজ`}>
  <Header />

  <main class="quiz-page">
    <div class="container">
      <a href={`/courses/${courseId}/learn`} class="back-link">
        <ArrowLeft size={16} /> কোর্সে ফিরে যান
      </a>

      <div class="quiz-header">
        <h1 class="quiz-title">{quiz[0].title}</h1>
        {quiz[0].description && <p class="quiz-desc">{quiz[0].description}</p>}

        <div class="quiz-meta">
          <div class="meta-item">
            <span class="meta-label">প্রশ্ন সংখ্যা</span>
            <span class="meta-value">{questions.length}</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">পাসিং স্কোর</span>
            <span class="meta-value">{quiz[0].passingScore}%</span>
          </div>
          {quiz[0].timeLimit && (
            <div class="meta-item">
              <span class="meta-label">সময়সীমা</span>
              <span class="meta-value">{quiz[0].timeLimit} মিনিট</span>
            </div>
          )}
          {quiz[0].maxAttempts && (
            <div class="meta-item">
              <span class="meta-label">আটেম্পট</span>
              <span class="meta-value">{attempts.length}/{quiz[0].maxAttempts}</span>
            </div>
          )}
        </div>
      </div>

      <!-- Previous Attempts -->
      {attempts.length > 0 && (
        <div class="attempts-section">
          <h2 class="section-title">আগের আটেম্পটসমূহ</h2>
          <div class="attempts-list">
            {attempts.map((attempt, i) => (
              <div class:list={['attempt-card', attempt.passed ? 'passed' : 'failed']}>
                <div class="attempt-info">
                  <span class="attempt-number">#{attempts.length - i}</span>
                  <span class="attempt-score">{attempt.score}%</span>
                  <span class="attempt-detail">{attempt.correctAnswers}/{attempt.totalQuestions} সঠিক</span>
                </div>
                <span class:list={['attempt-status', attempt.passed ? 'pass' : 'fail']}>
                  {attempt.passed ? 'পাস' : 'ফেল'}
                </span>
              </div>
            ))}
          </div>
          <div class="best-score">
            <Trophy size={16} />
            সেরা স্কোর: {bestScore}%
          </div>
        </div>
      )}

      <!-- Quiz Form -->
      {canAttempt && !hasPassed && questions.length > 0 ? (
        <form id="quizForm" class="quiz-form">
          <div id="timer" class="timer" style="display:none;">
            <Clock size={18} />
            <span id="timerText">00:00</span>
          </div>

          <div class="questions-list">
            {questions.map((q, index) => {
              const options = typeof q.options === 'string' ? JSON.parse(q.options) : q.options;
              return (
                <div class="question-card" data-question-id={q.id}>
                  <div class="question-number">প্রশ্ন {index + 1} / {questions.length}</div>
                  <p class="question-text">{q.questionText}</p>
                  <div class="options">
                    {options.map((opt: any, optIndex: number) => (
                      <label class="option-label">
                        <input type="radio" name={`q-${q.id}`} value={optIndex} required />
                        <span class="option-text">{opt.text}</span>
                      </label>
                    ))}
                  </div>
                </div>
              );
            })}
          </div>

          <button type="submit" class="submit-btn" id="submitBtn">জমা দিন</button>
        </form>
      ) : hasPassed ? (
        <div class="passed-message">
          <Trophy size={48} />
          <h2>অভিনন্দন!</h2>
          <p>আপনি এই কুইজে পাস করেছেন।</p>
          <a href={`/courses/${courseId}/learn`} class="back-btn">কোর্সে ফিরে যান</a>
        </div>
      ) : !canAttempt ? (
        <div class="no-attempts">
          <AlertCircle size={48} />
          <h2>আটেম্পট শেষ</h2>
          <p>আপনি সর্বোচ্চ আটেম্পট সংখ্যা পূরণ করেছেন।</p>
          <a href={`/courses/${courseId}/learn`} class="back-btn">কোর্সে ফিরে যান</a>
        </div>
      ) : (
        <div class="no-questions">
          <p>এই কুইজে এখনো কোনো প্রশ্ন যোগ করা হয়নি।</p>
        </div>
      )}

      <!-- Results (hidden by default) -->
      <div id="resultsSection" class="results-section" style="display:none;">
        <h2 class="section-title">ফলাফল</h2>
        <div id="resultsContent"></div>
      </div>
    </div>
  </main>
</BaseLayout>

<script define:vars={{ quizId, courseId, timeLimit: quiz[0]?.timeLimit, questionsCount: questions.length }}>
  const form = document.getElementById('quizForm');
  const submitBtn = document.getElementById('submitBtn');
  const resultsSection = document.getElementById('resultsSection');
  const resultsContent = document.getElementById('resultsContent');
  const timerEl = document.getElementById('timer');
  const timerText = document.getElementById('timerText');

  let timerInterval;
  const quizStartedAt = new Date().toISOString();

  // Start timer if time limit exists
  if (timeLimit) {
    timerEl.style.display = 'flex';
    let seconds = timeLimit * 60;

    function updateTimer() {
      const mins = Math.floor(seconds / 60);
      const secs = seconds % 60;
      timerText.textContent = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
    }

    updateTimer();
    timerInterval = setInterval(() => {
      seconds--;
      updateTimer();
      if (seconds <= 0) {
        clearInterval(timerInterval);
        submitQuiz();
      }
    }, 1000);
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    await submitQuiz();
  });

  async function submitQuiz() {
    if (timerInterval) clearInterval(timerInterval);
    submitBtn.disabled = true;
    submitBtn.textContent = 'জমা হচ্ছে...';

    // Collect answers
    const answers = [];
    const questionCards = form.querySelectorAll('.question-card');
    for (const card of questionCards) {
      const questionId = card.getAttribute('data-question-id');
      const selected = card.querySelector('input:checked');
      answers.push({
        questionId,
        selectedOption: selected ? parseInt(selected.value) : -1,
      });
    }

    try {
      const res = await fetch(`/api/courses/${courseId}/quiz/${quizId}/submit`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ answers, startedAt: quizStartedAt })
      });
      const data = await res.json();

      if (res.ok && data.success) {
        form.style.display = 'none';
        resultsSection.style.display = 'block';

        const resultHtml = document.createElement('div');
        resultHtml.className = `result-summary ${data.passed ? 'passed' : 'failed'}`;

        const scoreDiv = document.createElement('div');
        scoreDiv.className = 'result-score';
        scoreDiv.textContent = `${data.score}%`;
        resultHtml.appendChild(scoreDiv);

        const detailDiv = document.createElement('div');
        detailDiv.className = 'result-detail';
        detailDiv.textContent = `${data.correctAnswers}/${data.totalQuestions} সঠিক উত্তর`;
        resultHtml.appendChild(detailDiv);

        const statusDiv = document.createElement('div');
        statusDiv.className = `result-status ${data.passed ? 'pass' : 'fail'}`;
        statusDiv.textContent = data.passed ? 'পাস!' : 'ফেল';
        resultHtml.appendChild(statusDiv);

        const passingDiv = document.createElement('div');
        passingDiv.className = 'result-passing';
        passingDiv.textContent = `পাসিং স্কোর: ${data.passingScore}%`;
        resultHtml.appendChild(passingDiv);

        resultsContent.appendChild(resultHtml);

        const backLink = document.createElement('a');
        backLink.href = `/courses/${courseId}/learn`;
        backLink.className = 'back-btn';
        backLink.textContent = 'কোর্সে ফিরে যান';
        resultsContent.appendChild(backLink);
      } else {
        throw new Error(data.error || 'সমস্যা হয়েছে।');
      }
    } catch (err) {
      alert(err.message);
      submitBtn.disabled = false;
      submitBtn.textContent = 'জমা দিন';
    }
  }
</script>

<style>
  .quiz-page {
    min-height: calc(100vh - 70px);
    background: #f8fafc;
    padding: 32px;
  }
  .container { max-width: 800px; margin: 0 auto; }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #64748b;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 24px;
  }
  .back-link:hover { color: #0891b2; }

  .quiz-header {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 32px;
    margin-bottom: 24px;
  }
  .quiz-title { font-size: 1.5rem; font-weight: 700; margin: 0 0 8px; }
  .quiz-desc { color: #64748b; margin: 0 0 20px; }
  .quiz-meta { display: flex; gap: 24px; flex-wrap: wrap; }
  .meta-item { display: flex; flex-direction: column; gap: 4px; }
  .meta-label { font-size: 0.8rem; color: #94a3b8; font-weight: 500; }
  .meta-value { font-size: 1.1rem; font-weight: 700; color: #0f172a; }

  .attempts-section {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 24px;
    margin-bottom: 24px;
  }
  .section-title { font-size: 1.1rem; font-weight: 700; margin: 0 0 16px; }
  .attempts-list { display: flex; flex-direction: column; gap: 8px; }
  .attempt-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    border-radius: 8px;
    border: 1px solid #e2e8f0;
  }
  .attempt-card.passed { background: #f0fdf4; border-color: #bbf7d0; }
  .attempt-card.failed { background: #fef2f2; border-color: #fecaca; }
  .attempt-info { display: flex; align-items: center; gap: 16px; }
  .attempt-number { font-weight: 600; color: #64748b; }
  .attempt-score { font-size: 1.1rem; font-weight: 700; }
  .attempt-detail { font-size: 0.85rem; color: #64748b; }
  .attempt-status {
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
  }
  .attempt-status.pass { background: #dcfce7; color: #16a34a; }
  .attempt-status.fail { background: #fee2e2; color: #ef4444; }
  .best-score {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid #e2e8f0;
    font-weight: 600;
    color: #0891b2;
  }

  .timer {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    background: #fef3c7;
    border: 1px solid #fcd34d;
    border-radius: 8px;
    margin-bottom: 24px;
    font-weight: 600;
    color: #92400e;
  }

  .questions-list { display: flex; flex-direction: column; gap: 20px; margin-bottom: 32px; }
  .question-card {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 24px;
  }
  .question-number {
    font-size: 0.8rem;
    font-weight: 600;
    color: #0891b2;
    margin-bottom: 8px;
  }
  .question-text {
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 16px;
    line-height: 1.6;
  }
  .options { display: flex; flex-direction: column; gap: 10px; }
  .option-label {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s;
  }
  .option-label:hover { background: #f1f5f9; }
  .option-label input:checked + .option-text { font-weight: 600; color: #0891b2; }
  .option-label:has(input:checked) { border-color: #0891b2; background: #ecfeff; }
  .option-label input[type="radio"] { width: 18px; height: 18px; cursor: pointer; }
  .option-text { font-size: 0.95rem; }

  .submit-btn {
    display: block;
    width: 100%;
    padding: 14px;
    background: #0891b2;
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 1.05rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
  }
  .submit-btn:hover { background: #06b6d4; }
  .submit-btn:disabled { opacity: 0.7; cursor: not-allowed; }

  .results-section {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 32px;
    text-align: center;
  }
  .result-summary { margin-bottom: 24px; }
  .result-score { font-size: 3rem; font-weight: 800; }
  .result-summary.passed .result-score { color: #16a34a; }
  .result-summary.failed .result-score { color: #ef4444; }
  .result-detail { font-size: 1.1rem; color: #64748b; margin: 8px 0; }
  .result-status {
    display: inline-block;
    padding: 6px 20px;
    border-radius: 20px;
    font-weight: 600;
    margin: 12px 0;
  }
  .result-status.pass { background: #dcfce7; color: #16a34a; }
  .result-status.fail { background: #fee2e2; color: #ef4444; }
  .result-passing { font-size: 0.9rem; color: #94a3b8; }

  .passed-message, .no-attempts, .no-questions {
    text-align: center;
    padding: 60px 32px;
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
  }
  .passed-message h2, .no-attempts h2 { margin: 16px 0 8px; }
  .passed-message p, .no-attempts p { color: #64748b; }

  .back-btn {
    display: inline-block;
    margin-top: 20px;
    padding: 10px 24px;
    background: #0891b2;
    color: white;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 600;
    transition: background 0.2s;
  }
  .back-btn:hover { background: #06b6d4; }
</style>
