---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import { createDb } from '../../../db/client.js';
import { courses, courseModules, courseLessons, courseQuizzes, courseEnrollments, courseProgress } from '../../../db/schema.js';
import { eq, and, asc } from 'drizzle-orm';
import { env as workerEnv } from 'cloudflare:workers';
import { PlayCircle, FileText, ListChecks, CheckCircle, Lock, ChevronLeft, ChevronRight, Menu, X, Maximize2 } from '@lucide/astro';
import { buildLessonLockState, getOrderedLessons, isEnrollmentActive, safeJsonArray } from '../../../lib/lms-access.js';
import { sanitizeHtml } from '../../../lib/markdown.js';

export const prerender = false;

const { id: courseId } = Astro.params;
const env = workerEnv || process.env;
const db = createDb((env as any).DATABASE_URL);
const user = (Astro.locals as any).user;

if (!user) {
  return Astro.redirect('/login');
}

// Get course
const course = await db.select().from(courses).where(eq(courses.id, courseId)).then(r => r[0]);
if (!course) return Astro.redirect('/courses');

// Verify enrollment
const enrollment = await db.select().from(courseEnrollments)
  .where(and(eq(courseEnrollments.userId, user.id), eq(courseEnrollments.courseId, courseId)));
if (enrollment.length === 0 || !isEnrollmentActive(enrollment[0])) {
  return Astro.redirect(`/courses/${courseId}`);
}

// Get content tree
const modules = await db.select().from(courseModules)
  .where(eq(courseModules.courseId, courseId))
  .orderBy(asc(courseModules.sortOrder));

const lessons = await db.select().from(courseLessons)
  .where(eq(courseLessons.courseId, courseId))
  .orderBy(asc(courseLessons.sortOrder));

const quizzes = await db.select().from(courseQuizzes)
  .where(eq(courseQuizzes.courseId, courseId))
  .orderBy(asc(courseQuizzes.sortOrder));

// Get user progress
const progressRecords = await db.select().from(courseProgress)
  .where(and(eq(courseProgress.userId, user.id), eq(courseProgress.courseId, courseId)));

const completedLessonIds = new Set(progressRecords.filter(p => p.completed).map(p => p.lessonId));
const orderedLessons = getOrderedLessons(modules, lessons);

// Determine current lesson from query param or first lesson
const currentLessonId = Astro.url.searchParams.get('lesson') || orderedLessons[0]?.id || '';
let currentLesson = orderedLessons.find(l => l.id === currentLessonId) || orderedLessons[0];

if (currentLesson) {
  const currentLockState = buildLessonLockState({
    lesson: currentLesson,
    orderedLessons,
    completedLessonIds,
    course,
    enrollment: enrollment[0],
    user,
  });

  if (currentLockState.locked) {
    const firstUnlocked = orderedLessons.find((lesson) => !buildLessonLockState({
      lesson,
      orderedLessons,
      completedLessonIds,
      course,
      enrollment: enrollment[0],
      user,
    }).locked);
    if (firstUnlocked && firstUnlocked.id !== currentLesson.id) {
      return Astro.redirect(`/courses/${courseId}/learn?lesson=${firstUnlocked.id}`);
    }
    return Astro.redirect(`/courses/${courseId}`);
  }
}

// Get prev/next lessons
const currentIndex = orderedLessons.findIndex(l => l.id === currentLesson?.id);
const prevLesson = currentIndex > 0 ? orderedLessons[currentIndex - 1] : null;
const nextLesson = currentIndex < orderedLessons.length - 1 ? orderedLessons[currentIndex + 1] : null;
const currentResources = safeJsonArray(currentLesson?.resources);
const sanitizedLessonHtml = currentLesson?.textContent ? sanitizeHtml(currentLesson.textContent) : '';

// Build flat content list for sidebar (modules with their lessons and quizzes)
const contentTree = modules.map(mod => ({
  ...mod,
  items: [
    ...lessons.filter(l => l.moduleId === mod.id).map(l => ({ type: 'lesson', ...l })),
    ...quizzes.filter(q => q.moduleId === mod.id).map(q => ({ type: 'quiz', ...q })),
  ].sort((a, b) => a.sortOrder - b.sortOrder),
}));

const totalLessons = orderedLessons.length;
const completedCount = completedLessonIds.size;
const progressPercent = totalLessons > 0 ? Math.round((completedCount / totalLessons) * 100) : 0;
---

<BaseLayout title={`${currentLesson?.title || 'শেখা শুরু করুন'} | ${course.title}`}>
  <Header />

  <main class="learn-page">
    <!-- Sidebar -->
    <aside class="learn-sidebar" id="learnSidebar">
      <div class="sidebar-header">
        <a href={`/courses/${courseId}`} class="back-to-course">← কোর্সে ফিরে যান</a>
        <button class="close-sidebar" id="closeSidebar"><X size={20} /></button>
      </div>

      <div class="sidebar-progress">
        <div class="progress-summary">
          <div class="progress-ring" style={`--progress:${progressPercent * 3.6}deg;`}>
            <span>{progressPercent}%</span>
          </div>
          <div>
            <strong>{completedCount}/{totalLessons} লেসন</strong>
            <span>শেখার অগ্রগতি</span>
          </div>
        </div>
        <div class="progress-bar">
          <div class="progress-fill" style={`width: ${progressPercent}%`}></div>
        </div>
        <span class="progress-text">{completedCount}/{totalLessons} সম্পন্ন ({progressPercent}%)</span>
      </div>

      <div class="sidebar-modules">
        {contentTree.map(mod => (
          <div class="sidebar-module">
            <div class="module-label">{mod.title}</div>
            <div class="module-items">
              {mod.items.map((item: any) => {
                const isActive = item.type === 'lesson' && item.id === currentLesson?.id;
                const isDone = item.type === 'lesson' && completedLessonIds.has(item.id);
                const lockState = item.type === 'lesson' ? buildLessonLockState({
                  lesson: item,
                  orderedLessons,
                  completedLessonIds,
                  course,
                  enrollment: enrollment[0],
                  user,
                }) : { locked: false };
                return item.type === 'lesson' ? (
                  <a
                    href={lockState.locked ? '#' : `/courses/${courseId}/learn?lesson=${item.id}`}
                    class:list={['sidebar-item', isActive && 'active', isDone && 'completed', lockState.locked && 'locked']}
                    aria-disabled={lockState.locked ? 'true' : 'false'}
                  >
                    {lockState.locked ? (
                      <Lock size={16} class="icon-locked" />
                    ) : isDone ? (
                      <CheckCircle size={16} class="icon-done" />
                    ) : item.contentType === 'video' ? (
                      <PlayCircle size={16} class="icon-video" />
                    ) : (
                      <FileText size={16} class="icon-text" />
                    )}
                    <span class="item-title">{item.title}</span>
                    {item.duration && <span class="item-duration">{item.duration}</span>}
                  </a>
                ) : (
                  <a
                    href={`/courses/${courseId}/quiz/${item.id}`}
                    class:list={['sidebar-item', 'quiz-item']}
                  >
                    <ListChecks size={16} class="icon-quiz" />
                    <span class="item-title">{item.title}</span>
                  </a>
                );
              })}
            </div>
          </div>
        ))}
      </div>
    </aside>

    <!-- Main Content -->
    <div class="learn-content">
      <div class="content-topbar">
        <button class="open-sidebar" id="openSidebar"><Menu size={20} /></button>
        <h1 class="lesson-title-main">{currentLesson?.title || 'কন্টেন্ট নেই'}</h1>
        <button class="focus-mode-btn" id="focusModeBtn" type="button" aria-pressed="false">
          <Maximize2 size={18} />
          <span>ফোকাস</span>
        </button>
      </div>

      {currentLesson ? (
        <div class="lesson-content-area">
          {/* Video Player */}
          {(currentLesson.contentType === 'video' || currentLesson.contentType === 'mixed') && currentLesson.videoUrl && (
            <div class="video-wrapper">
              <iframe
                src={`/api/courses/${courseId}/lessons/${currentLesson.id}/video`}
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                class="video-player"
              ></iframe>
            </div>
          )}

          {currentLesson.description && (
            <p class="lesson-description">{currentLesson.description}</p>
          )}

          {/* Text Content */}
          {(currentLesson.contentType === 'text' || currentLesson.contentType === 'mixed') && currentLesson.textContent && (
            <div class="text-content" set:html={sanitizedLessonHtml} />
          )}

          {currentResources.length > 0 && (
            <div class="resources-panel">
              <h2>রিসোর্স</h2>
              <div class="resource-list">
                {currentResources.map((resource: any) => (
                  <a
                    href={currentLesson.allowResourceDownload ? resource.url : '#'}
                    class:list={['resource-link', !currentLesson.allowResourceDownload && 'disabled']}
                    target={currentLesson.allowResourceDownload ? '_blank' : undefined}
                    rel={currentLesson.allowResourceDownload ? 'noopener noreferrer' : undefined}
                    download={currentLesson.allowResourceDownload ? true : undefined}
                    aria-disabled={!currentLesson.allowResourceDownload ? 'true' : 'false'}
                  >
                    <FileText size={16} />
                    <span>{resource.title}</span>
                    {!currentLesson.allowResourceDownload && <span class="resource-note">ডাউনলোড বন্ধ</span>}
                  </a>
                ))}
              </div>
            </div>
          )}

          {/* Navigation & Complete */}
          <div class="lesson-footer">
            <div class="nav-buttons">
              {prevLesson && (
                <a href={`/courses/${courseId}/learn?lesson=${prevLesson.id}`} class="nav-btn prev">
                  <ChevronLeft size={18} />
                  <span>আগের লেসন</span>
                </a>
              )}
              {!prevLesson && <div></div>}

              {!completedLessonIds.has(currentLesson.id) ? (
                <button class="complete-btn" id="completeBtn" data-lesson-id={currentLesson.id}>
                  <CheckCircle size={18} />
                  সম্পন্ন হিসেবে চিহ্নিত করুন
                </button>
              ) : (
                <span class="completed-badge">
                  <CheckCircle size={18} />
                  সম্পন্ন
                </span>
              )}

              {nextLesson && (
                <a href={`/courses/${courseId}/learn?lesson=${nextLesson.id}`} class="nav-btn next">
                  <span>পরের লেসন</span>
                  <ChevronRight size={18} />
                </a>
              )}
              {!nextLesson && <div></div>}
            </div>
          </div>
        </div>
      ) : (
        <div class="no-content">
          <p>এই কোর্সে এখনো কোনো কন্টেন্ট যোগ করা হয়নি।</p>
        </div>
      )}
    </div>
  </main>
</BaseLayout>

<script define:vars={{ courseId, lessonId: currentLesson?.id }}>
  // Mark complete
  const completeBtn = document.getElementById('completeBtn');
  const learnPage = document.querySelector('.learn-page');
  const focusModeBtn = document.getElementById('focusModeBtn');
  completeBtn?.addEventListener('click', async () => {
    completeBtn.disabled = true;
    completeBtn.textContent = 'সেভ হচ্ছে...';

    try {
      const res = await fetch(`/api/courses/${courseId}/progress`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ lessonId })
      });
      const data = await res.json();
      if (res.ok && data.success) {
        window.location.reload();
      } else {
        throw new Error(data.error || 'সমস্যা হয়েছে।');
      }
    } catch (err) {
      alert(err.message);
      completeBtn.disabled = false;
      completeBtn.textContent = 'সম্পন্ন হিসেবে চিহ্নিত করুন';
    }
  });

  // Mobile sidebar toggle
  const sidebar = document.getElementById('learnSidebar');
  document.getElementById('openSidebar')?.addEventListener('click', () => {
    sidebar.classList.add('open');
  });
  document.getElementById('closeSidebar')?.addEventListener('click', () => {
    sidebar.classList.remove('open');
  });
  document.querySelectorAll('.sidebar-item.locked, .resource-link.disabled').forEach((link) => {
    link.addEventListener('click', (event) => event.preventDefault());
  });

  focusModeBtn?.addEventListener('click', () => {
    if (!learnPage) return;
    const isActive = learnPage.classList.toggle('focus-mode');
    focusModeBtn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
  });
</script>

<style>
  .learn-page {
    display: flex;
    min-height: calc(100vh - 70px);
    background: #f8fafc;
  }

  /* Sidebar */
  .learn-sidebar {
    width: 320px;
    background: white;
    border-right: 1px solid #e2e8f0;
    display: flex;
    flex-direction: column;
    position: fixed;
    top: 70px;
    bottom: 0;
    left: 0;
    z-index: 30;
    overflow-y: auto;
    transition: transform 0.3s ease;
  }

  .sidebar-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 20px;
    border-bottom: 1px solid #e2e8f0;
  }
  .back-to-course {
    font-size: 0.85rem;
    color: #64748b;
    text-decoration: none;
    font-weight: 500;
  }
  .back-to-course:hover { color: #0891b2; }
  .close-sidebar {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    color: #64748b;
    padding: 4px;
  }

  .sidebar-progress {
    padding: 16px 20px;
    border-bottom: 1px solid #e2e8f0;
  }
  .progress-summary {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }
  .progress-summary strong {
    display: block;
    color: #0f172a;
    font-size: 0.95rem;
    line-height: 1.3;
  }
  .progress-summary span {
    display: block;
    color: #64748b;
    font-size: 0.78rem;
  }
  .progress-ring {
    width: 54px;
    height: 54px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at center, #fff 58%, transparent 59%),
      conic-gradient(#0891b2 var(--progress), #e2e8f0 0deg);
    flex-shrink: 0;
  }
  .progress-ring span {
    color: #0f172a;
    font-size: 0.78rem;
    font-weight: 800;
  }
  .progress-bar {
    height: 8px;
    background: #e2e8f0;
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 8px;
  }
  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #0891b2, #06b6d4);
    border-radius: 4px;
    transition: width 0.3s ease;
  }
  .progress-text {
    font-size: 0.8rem;
    color: #64748b;
    font-weight: 500;
  }

  .sidebar-modules { padding: 12px 0; }
  .sidebar-module { margin-bottom: 8px; }
  .module-label {
    padding: 8px 20px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #94a3b8;
    letter-spacing: 0.05em;
  }

  .sidebar-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 20px;
    text-decoration: none;
    color: #475569;
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.2s;
    border-left: 3px solid transparent;
  }
  .sidebar-item:hover {
    background: #f1f5f9;
    color: #0891b2;
  }
  .sidebar-item.active {
    background: #ecfeff;
    color: #0891b2;
    border-left-color: #0891b2;
    font-weight: 600;
  }
  .sidebar-item.completed .item-title {
    color: #10b981;
  }
  .sidebar-item.locked {
    color: #94a3b8;
    cursor: not-allowed;
    background: #f8fafc;
  }
  .sidebar-item.locked:hover {
    color: #94a3b8;
    background: #f8fafc;
  }
  .icon-done { color: #10b981; flex-shrink: 0; }
  .icon-video { color: #3b82f6; flex-shrink: 0; }
  .icon-text { color: #10b981; flex-shrink: 0; }
  .icon-quiz { color: #f59e0b; flex-shrink: 0; }
  .icon-locked { color: #94a3b8; flex-shrink: 0; }
  .item-title { flex: 1; }
  .item-duration {
    font-size: 0.75rem;
    color: #94a3b8;
    flex-shrink: 0;
  }
  .quiz-item { border-left-color: #fbbf24; }

  /* Main Content */
  .learn-content {
    flex: 1;
    margin-left: 320px;
    display: flex;
    flex-direction: column;
  }

  .content-topbar {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 32px;
    background: white;
    border-bottom: 1px solid #e2e8f0;
  }
  .open-sidebar {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    color: #475569;
    padding: 4px;
  }
  .lesson-title-main {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0;
    color: #0f172a;
    flex: 1;
    min-width: 0;
  }
  .focus-mode-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 8px 12px;
    border-radius: 8px;
    border: 1px solid #cbd5e1;
    background: #fff;
    color: #475569;
    font-weight: 700;
  }
  .focus-mode-btn[aria-pressed="true"] {
    border-color: #0891b2;
    background: #ecfeff;
    color: #0e7490;
  }

  .learn-page.focus-mode .learn-sidebar {
    transform: translateX(-100%);
  }
  .learn-page.focus-mode .learn-content {
    margin-left: 0;
  }
  .learn-page.focus-mode .lesson-content-area {
    max-width: 1040px;
  }

  .lesson-content-area {
    flex: 1;
    padding: 32px;
    max-width: 900px;
    width: 100%;
    margin: 0 auto;
  }

  .video-wrapper {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    margin-bottom: 32px;
    border-radius: 12px;
    overflow: hidden;
    background: #000;
  }
  .video-player {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .lesson-description {
    margin: -12px 0 24px;
    color: #64748b;
    line-height: 1.7;
  }

  .text-content {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 32px;
    margin-bottom: 32px;
    line-height: 1.8;
    font-size: 1rem;
    color: #334155;
  }
  .text-content :global(h2) { font-size: 1.4rem; margin-top: 24px; margin-bottom: 12px; color: #0f172a; }
  .text-content :global(h3) { font-size: 1.2rem; margin-top: 20px; margin-bottom: 10px; color: #0f172a; }
  .text-content :global(p) { margin-bottom: 16px; }
  .text-content :global(ul), .text-content :global(ol) { margin-bottom: 16px; padding-left: 24px; }
  .text-content :global(li) { margin-bottom: 8px; }
  .text-content :global(blockquote) {
    border-left: 4px solid #0891b2;
    padding: 12px 20px;
    background: #f0fdfa;
    margin: 16px 0;
    border-radius: 0 8px 8px 0;
  }

  .resources-panel {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 24px;
  }
  .resources-panel h2 {
    margin: 0 0 14px;
    font-size: 1rem;
  }
  .resource-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .resource-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    color: #0f172a;
    text-decoration: none;
    background: #f8fafc;
  }
  .resource-link.disabled {
    color: #94a3b8;
    cursor: not-allowed;
  }
  .resource-note {
    margin-left: auto;
    font-size: 0.75rem;
    color: #94a3b8;
  }

  .lesson-footer {
    margin-top: 24px;
  }
  .nav-buttons {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }
  .nav-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 20px;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    text-decoration: none;
    color: #475569;
    font-weight: 500;
    font-size: 0.9rem;
    background: white;
    transition: all 0.2s;
  }
  .nav-btn:hover {
    border-color: #0891b2;
    color: #0891b2;
  }
  .complete-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    background: #0891b2;
    color: white;
    border: none;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    transition: background 0.2s;
  }
  .complete-btn:hover { background: #06b6d4; }
  .complete-btn:disabled { opacity: 0.7; cursor: not-allowed; }
  .completed-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    background: #dcfce7;
    color: #16a34a;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .no-content {
    text-align: center;
    padding: 80px 32px;
    color: #64748b;
  }

  @media (max-width: 1024px) {
    .learn-sidebar {
      transform: translateX(-100%);
    }
    .learn-sidebar.open {
      transform: translateX(0);
      box-shadow: 4px 0 24px rgba(0,0,0,0.1);
    }
    .close-sidebar { display: block; }
    .open-sidebar { display: flex; }
    .learn-content { margin-left: 0; }
    .lesson-content-area { padding: 20px; }
  }

  @media (max-width: 640px) {
    .content-topbar {
      padding: 12px 16px;
    }
    .lesson-title-main {
      font-size: 1rem;
    }
    .focus-mode-btn span {
      display: none;
    }
    .nav-buttons { flex-direction: column; }
    .nav-btn, .complete-btn, .completed-badge { width: 100%; justify-content: center; }
  }
</style>
