---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { testCategories } from '../data/test-data';
import { HelpCircle, Eye, Wand2, Flame, Wind, Brain, Baby, Clock, Link2, ChevronRight } from '@lucide/astro';
import { buildBreadcrumbSchema, buildFaqSchema, buildWebPageSchema } from '../lib/seo.js';

// Map existing test categories to the card layout from the screenshot
const testCards = [
  {
    id: 'general',
    title: 'অনিদ্রা',
    icon: HelpCircle,
    href: '/ruqyah-diagnosis/general',
  },
  {
    id: 'evil-eye',
    title: 'বদ নজর',
    icon: Eye,
    href: '/ruqyah-diagnosis/evil-eye',
  },
  {
    id: 'magic',
    title: 'ঝাদু সমস্যা',
    icon: Wand2,
    href: '/ruqyah-diagnosis/magic',
  },
  {
    id: 'jinn',
    title: 'জীন সমস্যা',
    icon: Flame,
    href: '/ruqyah-diagnosis/jinn',
  },
  {
    id: 'waswasa',
    title: 'ওয়াসওয়াসা',
    icon: Wind,
    href: '/ruqyah-diagnosis/waswasa',
  },
  {
    id: 'kids',
    title: 'বাচ্চাদের সমস্যা',
    icon: Baby,
    href: '/ruqyah-diagnosis/kids',
  },
  {
    id: 'history',
    title: 'পূর্বের পরীক্ষার ফলাফল',
    icon: Clock,
    href: '/profile',
  },
  {
    id: 'links',
    title: 'প্রয়োজনীয় লিংক',
    icon: Link2,
    href: '/self-ruqyah',
  },
];

const siteUrl = Astro.site?.origin || 'https://ruqyahhealing.com';
const pageUrl = `${siteUrl}/ruqyah-diagnosis`;
const breadcrumbLd = buildBreadcrumbSchema([
  { name: 'হোম', url: siteUrl },
  { name: 'রুকইয়াহ ডায়াগনোসিস', url: pageUrl },
]);
const pageLd = buildWebPageSchema({
  pageUrl,
  name: 'সেলফ রুকইয়াহ ডায়াগনোসিস',
  description: 'সমস্যার ধরন অনুযায়ী স্ব-মূল্যায়নের জন্য রুকইয়াহ ডায়াগনোসিস পেজ। জীন, জাদু, বদনজর, ওয়াসওয়াসা ও অন্যান্য সমস্যা নির্ণয় করুন।',
  inLanguage: 'bn-BD',
});
const faqLd = buildFaqSchema([
  {
    question: 'এই ডায়াগনোসিস কি চূড়ান্ত রায়?',
    answer: 'না। এটি প্রাথমিক self-assessment; গুরুতর অবস্থায় রাকী বা ডাক্তারের সাথে আলোচনা করা উচিত।',
  },
  {
    question: 'রেজাল্টে কি রাকীর সাথে যোগাযোগের পরামর্শ আছে?',
    answer: 'হ্যাঁ। প্রতিটি রেজাল্টে WhatsApp আলোচনা এবং অ্যাপয়েন্টমেন্ট CTA রাখা হয়েছে।',
  },
  {
    question: 'শিশুদের জন্য কি আলাদা মূল্যায়ন আছে?',
    answer: 'হ্যাঁ। বাচ্চাদের জন্য আলাদা question set এবং age-based flow আছে।',
  },
]);
---

<BaseLayout
  title="সেলফ রুকইয়াহ ডায়াগনোসিস | Ruqyah Healing Center"
  description="রুকইয়াহ ডায়াগনোসিস - আপনার সমস্যাটি কি শারীরিক, মানসিক নাকি আসলেই জিন বা জাদুর প্রভাব? বিজ্ঞানসম্মত ও শরয়ী পদ্ধতিতে নিজে নিজে যাচাই করুন।"
  locale="bn"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(pageLd)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <Header />

  <main class="diagnosis-page">
    <div class="container">
      <!-- Breadcrumb -->
      <nav class="breadcrumb" aria-label="breadcrumb">
        <a href="/">হোম</a>
        <ChevronRight size={14} stroke-width={2.5} />
        <span>রুকইয়াহ ডায়াগনোসিস</span>
      </nav>

      <!-- Page Title -->
      <h1 class="page-title">সেলফ রুকইয়াহ ডায়াগনোসিস</h1>

      <!-- Diagnosis Grid -->
      <div class="diagnosis-grid">
        {testCards.map((card) => (
          <a href={card.href} class="diagnosis-card">
            <div class="card-icon">
              <card.icon size={32} stroke-width={1.5} />
            </div>
            <span class="card-label">{card.title}</span>
          </a>
        ))}
      </div>

      <!-- Disclaimer -->
      <div class="disclaimer">
        <HelpCircle size={16} stroke-width={2} />
        <p>এই টেস্ট শুধুমাত্র প্রাথমিক পর্যায়ের মূল্যায়নের জন্য। এটি কোনো মেডিকেল বা ধর্মীয় ফতোয়া নয়। উচ্চ মাত্রার লক্ষণে অবশ্যই অভিজ্ঞ রাকীর শরণাপন্ন হোন।</p>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .diagnosis-page {
    background: linear-gradient(180deg, #f8f7f4 0%, #f0efe9 100%);
    min-height: 100vh;
    padding-bottom: 48px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 16px 0;
    font-size: 13px;
    color: var(--text-muted);
  }
  .breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .breadcrumb a:hover {
    color: var(--primary);
  }
  .breadcrumb svg {
    color: var(--text-muted);
  }

  .page-title {
    text-align: center;
    font-size: clamp(1.2rem, 4vw, 1.6rem);
    font-weight: 800;
    color: var(--text-dark);
    margin: 8px 0 28px;
    letter-spacing: 0.3px;
  }

  /* ── Diagnosis Grid ── */
  .diagnosis-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
    max-width: 520px;
    margin: 0 auto;
  }

  .diagnosis-card {
    background: #fff;
    border-radius: 16px;
    aspect-ratio: 1 / 1.05;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    border: 1.5px solid var(--border);
    padding: 20px;
  }
  .diagnosis-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 36px rgba(0,0,0,0.1);
    border-color: var(--primary);
  }
  .diagnosis-card:active {
    transform: scale(0.97);
  }

  .card-icon {
    color: var(--primary);
    opacity: 0.9;
  }

  .card-label {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-dark);
    text-align: center;
    line-height: 1.4;
  }

  /* ── Disclaimer ── */
  .disclaimer {
    max-width: 520px;
    margin: 28px auto 0;
    display: flex;
    align-items: flex-start;
    gap: 10px;
    background: #fffbeb;
    border: 1px solid #fde68a;
    border-radius: 12px;
    padding: 14px 16px;
  }
  .disclaimer svg {
    color: #d97706;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .disclaimer p {
    font-size: 12px;
    color: #78350f;
    line-height: 1.6;
    margin: 0;
  }

  /* ── Desktop tweaks ── */
  @media (min-width: 640px) {
    .diagnosis-grid {
      grid-template-columns: repeat(4, 1fr);
      max-width: 680px;
      gap: 16px;
    }
    .diagnosis-card {
      aspect-ratio: 1 / 1;
    }
    .card-label {
      font-size: 15px;
    }
    .disclaimer {
      max-width: 680px;
    }
  }
</style>
