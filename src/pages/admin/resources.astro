---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { createDb } from '../../db/client.js';
import { resources } from '../../db/schema.js';
import { desc } from 'drizzle-orm';
import { env as workerEnv } from 'cloudflare:workers';

export const prerender = false;

const env = (workerEnv || process.env) as any;
const db = createDb(env.DATABASE_URL);
const resourceList = await db.select().from(resources).orderBy(desc(resources.createdAt));
---

<AdminLayout title="রিসোর্স ম্যানেজমেন্ট | Admin - Ruqyah Healing">
  <div class="page-header">
    <div>
      <h1 class="page-title">পিডিএফ রিসোর্স ম্যানেজমেন্ট</h1>
      <p class="page-desc">পিডিএফ বই, গাইড ও দোয়া সংকলন পরিচালনা করুন</p>
    </div>
    <a href="/admin/resource-edit" class="btn-primary">+ নতুন রিসোর্স</a>
  </div>

  <div class="admin-card">
    <div class="table-container">
      <table class="admin-table">
        <thead>
          <tr>
            <th>শিরোনাম</th>
            <th>ক্যাটাগরি</th>
            <th>পৃষ্ঠা</th>
            <th>আকার</th>
            <th>ভাষা</th>
            <th>প্রকাশিত</th>
            <th>অ্যাকশন</th>
          </tr>
        </thead>
        <tbody>
          {resourceList.length === 0 ? (
            <tr><td colspan="7" style="text-align:center; padding:32px 0;">কোনো রিসোর্স নেই। নতুন যোগ করুন।</td></tr>
          ) : (
            resourceList.map(r => (
              <tr>
                <td style="font-weight:500; color:var(--admin-text);">{r.title}</td>
                <td>{r.category}</td>
                <td>{r.pages}</td>
                <td>{r.fileSize}</td>
                <td>{r.language}</td>
                <td>{r.published ? '✅' : '❌'}</td>
                <td>
                  <div class="action-btns">
                    <a href={`/admin/resource-edit?id=${r.id}`} class="btn-edit">এডিট</a>
                    <button class="btn-delete" data-id={r.id}>মুছুন</button>
                  </div>
                </td>
              </tr>
            ))
          )}
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>

<script>
  document.querySelectorAll('.btn-delete').forEach(btn => {
    btn.addEventListener('click', async () => {
      if (!confirm('রিসোর্সটি মুছে ফেলতে চান?')) return;
      const id = (btn as HTMLElement).dataset.id;
      const res = await fetch('/api/admin/resources/delete', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id }) });
      if (res.ok) window.location.reload();
    });
  });
</script>

<style>
  .btn-primary { display: inline-flex; align-items: center; gap: 6px; padding: 10px 20px; background: var(--admin-primary); color: #fff; border-radius: 8px; font-weight: 600; font-size: 0.9rem; text-decoration: none; }
  .btn-primary:hover { opacity: 0.9; }
  .table-container { overflow-x: auto; }
  .admin-table { width: 100%; border-collapse: collapse; text-align: left; }
  .admin-table th { padding: 12px 16px; background: #f8fafc; color: var(--admin-text-light); font-weight: 600; font-size: 0.85rem; border-bottom: 1px solid var(--admin-border); text-transform: uppercase; letter-spacing: 0.5px; }
  .admin-table td { padding: 14px 16px; border-bottom: 1px solid var(--admin-border); color: var(--admin-text-light); font-size: 0.95rem; vertical-align: middle; }
  .admin-table tr:last-child td { border-bottom: none; }
  .action-btns { display: flex; gap: 8px; }
  .btn-edit { padding: 6px 14px; background: #f0f9ff; color: var(--admin-primary); border-radius: 6px; font-size: 0.85rem; font-weight: 600; text-decoration: none; }
  .btn-edit:hover { background: #e0f2fe; }
  .btn-delete { padding: 6px 14px; background: #fef2f2; color: #ef4444; border: none; border-radius: 6px; font-size: 0.85rem; font-weight: 600; cursor: pointer; font-family: inherit; }
  .btn-delete:hover { background: #fee2e2; }
</style>
