---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { createDb } from '../../db/client.js';
import { resources } from '../../db/schema.js';
import { eq } from 'drizzle-orm';
import { env as workerEnv } from 'cloudflare:workers';

export const prerender = false;

const env = (workerEnv || process.env) as any;
const db = createDb(env.DATABASE_URL);

const editId = Astro.url.searchParams.get('id');
let resource: any = null;
if (editId) {
  const rows = await db.select().from(resources).where(eq(resources.id, editId));
  resource = rows[0] || null;
}
const isEdit = !!resource;
---

<AdminLayout title={isEdit ? 'রিসোর্স এডিট' : 'নতুন রিসোর্স' + ' | Admin'}>
  <div class="page-header">
    <div>
      <h1 class="page-title">{isEdit ? 'রিসোর্স এডিট করুন' : 'নতুন রিসোর্স যোগ করুন'}</h1>
      <p class="page-desc"><a href="/admin/resources" class="back-link">← রিসোর্স লিস্টে ফিরুন</a></p>
    </div>
  </div>

  <div id="formMsg" class="save-msg" style="display:none;"></div>

  <form id="resourceForm" class="admin-card">
    <input type="hidden" id="resourceId" value={resource?.id || ''} />

    <div class="form-row">
      <div class="form-group">
        <label for="title">শিরোনাম *</label>
        <input type="text" id="title" class="form-input" value={resource?.title || ''} required />
      </div>
      <div class="form-group">
        <label for="category">ক্যাটাগরি</label>
        <select id="category" class="form-input">
          <option value="গাইড" selected={resource?.category === 'গাইড'}>গাইড</option>
          <option value="দোয়া" selected={resource?.category === 'দোয়া'}>দোয়া</option>
          <option value="সুরক্ষা" selected={resource?.category === 'সুরক্ষা'}>সুরক্ষা</option>
          <option value="কুরআন" selected={resource?.category === 'কুরআন'}>কুরআন</option>
          <option value="পরিবার" selected={resource?.category === 'পরিবার'}>পরিবার</option>
          <option value="ডায়াগনোসিস" selected={resource?.category === 'ডায়াগনোসিস'}>ডায়াগনোসিস</option>
        </select>
      </div>
    </div>

    <div class="form-group" style="margin-bottom:16px;">
      <label for="description">বিবরণ *</label>
      <textarea id="description" class="form-input" rows="2" required>{resource?.description || ''}</textarea>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="fileUrl">ফাইল URL</label>
        <input type="text" id="fileUrl" class="form-input" value={resource?.fileUrl || ''} placeholder="/pdfs/guide.pdf" />
      </div>
      <div class="form-group">
        <label for="fileSize">ফাইলের আকার</label>
        <input type="text" id="fileSize" class="form-input" value={resource?.fileSize || ''} placeholder="2.5 MB" />
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="pages">পৃষ্ঠা সংখ্যা</label>
        <input type="number" id="pages" class="form-input" value={resource?.pages || 0} />
      </div>
      <div class="form-group">
        <label for="language">ভাষা</label>
        <select id="language" class="form-input">
          <option value="বাংলা" selected={resource?.language === 'বাংলা'}>বাংলা</option>
          <option value="বাংলা-আরবি" selected={resource?.language === 'বাংলা-আরবি'}>বাংলা-আরবি</option>
          <option value="আরবি" selected={resource?.language === 'আরবি'}>আরবি</option>
          <option value="ইংরেজি" selected={resource?.language === 'ইংরেজি'}>ইংরেজি</option>
        </select>
      </div>
    </div>

    <div class="form-group" style="margin-bottom:16px;">
      <label class="checkbox-label">
        <input type="checkbox" id="published" checked={resource?.published !== false} /> প্রকাশিত
      </label>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn-save">{isEdit ? '💾 আপডেট করুন' : '✅ রিসোর্স যোগ করুন'}</button>
    </div>
  </form>
</AdminLayout>

<script>
  document.getElementById('resourceForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const msg = document.getElementById('formMsg')!;
    const id = (document.getElementById('resourceId') as HTMLInputElement).value;
    const isEdit = !!id;

    const payload: any = {
      title: (document.getElementById('title') as HTMLInputElement).value,
      description: (document.getElementById('description') as HTMLTextAreaElement).value,
      category: (document.getElementById('category') as HTMLSelectElement).value,
      fileUrl: (document.getElementById('fileUrl') as HTMLInputElement).value,
      fileSize: (document.getElementById('fileSize') as HTMLInputElement).value,
      pages: (document.getElementById('pages') as HTMLInputElement).value,
      language: (document.getElementById('language') as HTMLSelectElement).value,
      published: (document.getElementById('published') as HTMLInputElement).checked,
    };
    if (isEdit) payload.id = id;

    const url = isEdit ? '/api/admin/resources/update' : '/api/admin/resources/create';
    try {
      const res = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      if (res.ok) {
        msg.textContent = isEdit ? '✅ রিসোর্স আপডেট হয়েছে!' : '✅ রিসোর্স যোগ হয়েছে!';
        msg.className = 'save-msg success'; msg.style.display = 'block';
        if (!isEdit) setTimeout(() => window.location.href = '/admin/resources', 1000);
      } else { throw new Error('Failed'); }
    } catch {
      msg.textContent = '❌ সমস্যা হয়েছে'; msg.className = 'save-msg error'; msg.style.display = 'block';
    }
  });
</script>

<style>
  .back-link { color: var(--admin-primary); text-decoration: none; font-weight: 500; }
  .back-link:hover { text-decoration: underline; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px; }
  .form-group { display: flex; flex-direction: column; gap: 6px; }
  .form-group label { font-size: 0.85rem; font-weight: 600; color: var(--admin-text-light); }
  .form-input { padding: 10px 14px; border: 1px solid var(--admin-border); border-radius: 8px; font-size: 0.95rem; font-family: inherit; background: #fff; }
  .form-input:focus { outline: none; border-color: var(--admin-primary); }
  .checkbox-label { display: flex; align-items: center; gap: 6px; font-size: 0.9rem; cursor: pointer; }
  .form-actions { margin-top: 20px; text-align: right; }
  .btn-save { padding: 12px 32px; background: var(--admin-primary); color: #fff; border: none; border-radius: 10px; font-size: 1rem; font-weight: 700; cursor: pointer; font-family: inherit; }
  .btn-save:hover { opacity: 0.9; }
  .save-msg { padding: 12px 20px; border-radius: 10px; font-weight: 600; margin-bottom: 16px; }
  .save-msg.success { background: #dcfce7; color: #15803d; }
  .save-msg.error { background: #fee2e2; color: #dc2626; }
  @media (max-width: 768px) { .form-row { grid-template-columns: 1fr; } }
</style>
