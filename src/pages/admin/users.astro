---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { createDb } from '../../db/client.js';
import { users } from '../../db/schema.js';
import { desc } from 'drizzle-orm';
import { env as workerEnv } from 'cloudflare:workers';
import { Shield, User, MoreVertical } from '@lucide/astro';

export const prerender = false;

const env = workerEnv || process.env;
const db = createDb(env.DATABASE_URL);

const allUsers = await db.select().from(users).orderBy(desc(users.createdAt));
---

<AdminLayout title="ইউজার ম্যানেজমেন্ট | Admin - Ruqyah Healing">
  <div class="page-header">
    <div>
      <h1 class="page-title">ইউজার ম্যানেজমেন্ট</h1>
      <p class="page-desc">সকল নিবন্ধিত ব্যবহারকারী এবং তাদের অ্যাক্সেস নিয়ন্ত্রণ করুন</p>
    </div>
  </div>

  <div class="admin-card">
    <div class="table-container">
      <table class="admin-table">
        <thead>
          <tr>
            <th>নাম</th>
            <th>যোগাযোগ</th>
            <th>ভূমিকা (Role)</th>
            <th>যোগদানের তারিখ</th>
            <th>অ্যাকশন</th>
          </tr>
        </thead>
        <tbody>
          {allUsers.length === 0 ? (
            <tr><td colspan="5" style="text-align:center; padding:32px 0;">কোনো ইউজার নেই</td></tr>
          ) : (
            allUsers.map((u) => (
              <tr>
                <td>
                  <div style="display:flex; align-items:center; gap:8px;">
                     {u.role === 'admin' ? <Shield size={16} color="#0891B2" /> : <User size={16} color="#64748b" />}
                     <span style="font-weight:500; color:var(--admin-text);">{u.fullName}</span>
                  </div>
                </td>
                <td>
                  <div style="font-size:0.85rem;">{u.phone || 'N/A'}</div>
                  <div style="font-size:0.8rem; color:var(--admin-text-light);">{u.email || 'N/A'}</div>
                </td>
                <td>
                  <span class={`status-badge role-${u.role === 'admin' ? 'admin' : 'user'}`}>
                    {u.role}
                  </span>
                </td>
                <td>
                  {new Date(u.createdAt).toLocaleDateString('bn-BD', { year: 'numeric', month: 'short', day: 'numeric' })}
                </td>
                <td>
                   <select 
                    class="role-select" 
                    data-user-id={u.id}
                    data-current-role={u.role}
                   >
                     <option value="patient" selected={u.role === 'patient'}>Patient</option>
                     <option value="admin" selected={u.role === 'admin'}>Admin</option>
                   </select>
                </td>
              </tr>
            ))
          )}
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>

<script>
  const selects = document.querySelectorAll('.role-select');
  selects.forEach(select => {
    select.addEventListener('change', async (e) => {
      const target = e.target as HTMLSelectElement;
      const userId = target.getAttribute('data-user-id');
      const currentRole = target.getAttribute('data-current-role');
      const newRole = target.value;

      if (newRole === currentRole) return;
      
      const confirmMsg = `আপনি কি নিশ্চিত যে এই ইউজারের ভূমিকা '${newRole}' করতে চান?`;
      if (!confirm(confirmMsg)) {
        target.value = currentRole || 'patient';
        return;
      }

      target.disabled = true;

      try {
        const res = await fetch('/api/admin/users/update-role', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ userId, role: newRole })
        });
        
        const data = await res.json();
        if (res.ok && data.success) {
          alert('সাফল্যের সাথে আপডেট করা হয়েছে!');
          window.location.reload();
        } else {
          throw new Error(data.error || 'আপডেট ব্যর্থ হয়েছে।');
        }
      } catch (err: any) {
        alert(err.message);
        target.value = currentRole || 'patient';
        target.disabled = false;
      }
    });
  });
</script>

<style>
  .role-select {
    padding: 6px 12px;
    border: 1px solid var(--admin-border);
    border-radius: 6px;
    background: var(--admin-surface);
    color: var(--admin-text);
    font-size: 0.85rem;
    cursor: pointer;
    outline: none;
  }
  
  .role-select:focus {
    border-color: var(--admin-primary);
  }
  
  .role-select:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  
  .status-badge {
    display: inline-flex;
    align-items: center;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: capitalize;
  }

  .role-admin {
    background: #cffafe;
    color: #0891b2;
  }

  .role-user {
    background: #f1f5f9;
    color: #475569;
  }

  .table-container {
    overflow-x: auto;
  }
  
  .admin-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }
  
  .admin-table th {
    padding: 12px 16px;
    background: #f8fafc;
    color: var(--admin-text-light);
    font-weight: 600;
    font-size: 0.85rem;
    border-bottom: 1px solid var(--admin-border);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  
  .admin-table td {
    padding: 16px;
    border-bottom: 1px solid var(--admin-border);
    color: var(--admin-text-light);
    font-size: 0.95rem;
    vertical-align: middle;
  }
  
  .admin-table tr:last-child td {
    border-bottom: none;
  }
</style>
