---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { createDb } from '../../db/client.js';
import { courseQuizzes, courses } from '../../db/schema.js';
import { desc, eq } from 'drizzle-orm';
import { env as workerEnv } from 'cloudflare:workers';
import { Plus, Edit, Trash2, ListChecks } from '@lucide/astro';

export const prerender = false;

const env = (workerEnv || process.env) as any;
const db = createDb(env.DATABASE_URL);

const allQuizzes = await db.select({
  id: courseQuizzes.id,
  title: courseQuizzes.title,
  courseId: courseQuizzes.courseId,
  passingScore: courseQuizzes.passingScore,
  timeLimit: courseQuizzes.timeLimit,
  maxAttempts: courseQuizzes.maxAttempts,
  createdAt: courseQuizzes.createdAt,
  courseTitle: courses.title,
})
.from(courseQuizzes)
.leftJoin(courses, eq(courseQuizzes.courseId, courses.id))
.orderBy(desc(courseQuizzes.createdAt));
---

<AdminLayout title="কুইজ ম্যানেজমেন্ট | Admin">
  <div class="page-header">
    <div>
      <h1 class="page-title">কুইজ ম্যানেজমেন্ট</h1>
      <p class="page-desc">সকল কুইজের তালিকা দেখুন এবং পরিচালনা করুন</p>
    </div>
  </div>

  <div class="admin-card">
    <div class="table-container">
      <table class="admin-table">
        <thead>
          <tr>
            <th>কুইজের নাম</th>
            <th>কোর্স</th>
            <th>পাসিং স্কোর</th>
            <th>সময়সীমা</th>
            <th>আটেম্পট</th>
            <th>অ্যাকশন</th>
          </tr>
        </thead>
        <tbody>
          {allQuizzes.length === 0 ? (
            <tr><td colspan="6" style="text-align:center; padding:32px 0;">কোনো কুইজ নেই</td></tr>
          ) : (
            allQuizzes.map((q) => (
              <tr>
                <td>
                  <div style="font-weight:600; color:var(--admin-text);">{q.title}</div>
                </td>
                <td style="font-size:0.85rem; color:var(--admin-text-light);">{q.courseTitle || 'N/A'}</td>
                <td>{q.passingScore}%</td>
                <td>{q.timeLimit ? `${q.timeLimit} মিনিট` : 'অসীম'}</td>
                <td>{q.maxAttempts || 'অসীম'}</td>
                <td>
                  <div style="display:flex; gap:8px;">
                    <a href={`/admin/quiz-edit?id=${q.id}&courseId=${q.courseId}`} class="action-btn edit" title="Edit">
                      <Edit size={16} />
                    </a>
                    <button class="action-btn delete delete-quiz-btn" data-id={q.id} title="Delete">
                      <Trash2 size={16} />
                    </button>
                  </div>
                </td>
              </tr>
            ))
          )}
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>

<script>
  document.querySelectorAll('.delete-quiz-btn').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const quizId = target.getAttribute('data-id');
      if (!confirm('এই কুইজ ডিলিট হবে। নিশ্চিত?')) return;

      try {
        const res = await fetch('/api/admin/quizzes/delete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: quizId })
        });
        const data = (await res.json()) as any;
        if (res.ok && data.success) {
          target.closest('tr')?.remove();
        } else {
          throw new Error(data.error || 'ডিলিট সমস্যা।');
        }
      } catch (err: any) {
        alert(err.message);
      }
    });
  });
</script>

<style>
  .table-container { overflow-x: auto; }
  .admin-table { width: 100%; border-collapse: collapse; text-align: left; }
  .admin-table th {
    padding: 12px 16px;
    background: #f8fafc;
    color: var(--admin-text-light);
    font-weight: 600;
    font-size: 0.85rem;
    border-bottom: 1px solid var(--admin-border);
    text-transform: uppercase;
  }
  .admin-table td {
    padding: 16px;
    border-bottom: 1px solid var(--admin-border);
    color: var(--admin-text-light);
    font-size: 0.9rem;
    vertical-align: middle;
  }
  .admin-table tr:last-child td { border-bottom: none; }

  .action-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
  }
  .action-btn.edit { color: #3b82f6; background: #eff6ff; }
  .action-btn.edit:hover { background: #dbeafe; }
  .action-btn.delete { color: #ef4444; background: #fef2f2; }
  .action-btn.delete:hover { background: #fee2e2; }
</style>
