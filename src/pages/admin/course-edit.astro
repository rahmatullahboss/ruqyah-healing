---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { createDb } from '../../db/client.js';
import { courses } from '../../db/schema.js';
import { eq } from 'drizzle-orm';
import { env as workerEnv } from 'cloudflare:workers';
import { ArrowLeft, Save } from '@lucide/astro';

export const prerender = false;

const env = workerEnv || process.env;
const db = createDb((env as any).DATABASE_URL);

const id = Astro.url.searchParams.get('id');
let course: any = null;

if (id && id !== 'new') {
  const result = await db.select().from(courses).where(eq(courses.id, id));
  if (result.length > 0) course = result[0];
}

// Handle form submission on the server to make it work without JS API entirely if preferred, 
// using Astro's request method, but keeping API style for consistency. We will use JS fetch in client.
---

<AdminLayout title={course ? 'কোর্স আপডেট' : 'নতুন কোর্স'}>
  <div class="page-header">
    <div>
      <a href="/admin/courses" class="back-link">
        <ArrowLeft size={16} /> ফিরে যান
      </a>
      <h1 class="page-title">{course ? 'কোর্স আপডেট করুন' : 'নতুন কোর্স তৈরি করুন'}</h1>
    </div>
  </div>

  <div class="admin-card max-w-3xl">
    <form id="courseForm">
      <input type="hidden" name="id" value={course?.id || 'new'} />
      
      <div class="form-grid">
        <div class="form-group full-width">
          <label>কোর্সের নাম *</label>
          <input type="text" name="title" required value={course?.title || ''} placeholder="যেমন: বেসিক রুকইয়াহ ফ্রি কোর্স" />
        </div>

        <div class="form-group">
          <label>ইন্সট্রাক্টর *</label>
          <input type="text" name="instructor" required value={course?.instructor || ''} placeholder="ইন্সট্রাক্টরের নাম" />
        </div>

        <div class="form-group">
          <label>মোট শিক্ষার্থী (Optional)</label>
          <input type="number" name="students" value={course?.students || 0} />
        </div>

        <div class="form-group">
          <label>ক্লাস সংখ্যা ও টেক্সট *</label>
          <input type="text" name="classCount" required value={course?.classCount || ''} placeholder="যেমন: ৬ টি ক্লাস" />
        </div>

        <div class="form-group">
          <label>কোর্সের সময়কাল *</label>
          <input type="text" name="hours" required value={course?.hours || ''} placeholder="যেমন: ৮ সপ্তাহ" />
        </div>

        <div class="form-group">
          <label>স্তর (Level) *</label>
          <select name="level" required>
            <option value="শুরুর স্তর" selected={course?.level === 'শুরুর স্তর'}>শুরুর স্তর</option>
            <option value="মধ্যম স্তর" selected={course?.level === 'মধ্যম স্তর'}>মধ্যম স্তর</option>
            <option value="উন্নত স্তর" selected={course?.level === 'উন্নত স্তর'}>উন্নত স্তর</option>
          </select>
        </div>

        <div class="form-group">
          <label>মূল্য (বিনা মূল্যের জন্য ফাঁকা বা 0 রাখুন)</label>
          <input type="number" name="price" value={course?.price || ''} placeholder="0" />
        </div>

        <div class="form-group">
          <label>রেটিং</label>
          <input type="number" step="0.1" max="5" name="rating" value={course?.rating || '5.0'} />
        </div>
        <div class="form-group full-width">
          <label>ভিডিও লিংক (Google Drive / YouTube) (Optional)</label>
          <input type="url" name="videoLink" value={course?.videoLink || ''} placeholder="যেমন: https://drive.google.com/... বা https://youtube.com/..." />
          <small class="hint">কোর্সে এনরোল করা শিক্ষার্থীরা এই লিংকটি দেখতে পাবে।</small>
        </div>

        <div class="form-group full-width">
          <label>কোর্সের কভার ছবি *</label>
          <div class="image-upload-wrapper">
            <input type="hidden" name="image" id="imageUrl" value={course?.image || '/images/courses/default.webp'} />
            
            <div id="imagePreview" class="image-preview" style={`background-image: url(${course?.image || '/images/courses/default.webp'})`}>
              <div class="preview-overlay">
                <span id="uploadText">ছবি পরিবর্তন করুন</span>
              </div>
              <input type="file" id="imageFile" accept="image/*" class="file-input" />
            </div>
            
            <div class="upload-status" id="uploadStatus" style="display: none;">
              <span class="upload-spinner"></span> আপলোড হচ্ছে...
            </div>
          </div>
          <small class="hint">ছবি নির্বাচন করলে স্বয়ংক্রিয়ভাবে কম্প্রেস হয়ে সেভ হবে। (সর্বোচ্চ ১০MB)</small>
        </div>

        <div class="form-group full-width">
          <label>সংক্ষিপ্ত বিবরণ *</label>
          <textarea name="desc" required rows="3">{course?.desc || ''}</textarea>
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn-save">
          <Save size={18} />
          সেভ করুন
        </button>
      </div>
    </form>
  </div>
</AdminLayout>

<script>
  const form = document.getElementById('courseForm') as HTMLFormElement;
  const submitBtn = form.querySelector('.btn-save') as HTMLButtonElement;
  const imageFile = document.getElementById('imageFile') as HTMLInputElement;
  const imagePreview = document.getElementById('imagePreview') as HTMLDivElement;
  const imageUrl = document.getElementById('imageUrl') as HTMLInputElement;
  const uploadText = document.getElementById('uploadText') as HTMLSpanElement;
  const uploadStatus = document.getElementById('uploadStatus') as HTMLDivElement;

  function compressImage(file: File, maxWidth = 1000, quality = 0.8): Promise<File> {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.readAsDataURL(file);
      reader.onload = (e) => {
        const img = new Image();
        img.onload = () => {
          const canvas = document.createElement('canvas');
          let width = img.width;
          let height = img.height;
          
          if (width > maxWidth) {
            height = Math.round((height * maxWidth) / width);
            width = maxWidth;
          }
          
          canvas.width = width;
          canvas.height = height;
          const ctx = canvas.getContext('2d');
          if (!ctx) return reject(new Error('Canvas ctx null'));
          
          ctx.drawImage(img, 0, 0, width, height);
          canvas.toBlob((blob) => {
            if (blob) {
              resolve(new File([blob], file.name.replace(/\.[^/.]+$/, "") + ".webp", { type: 'image/webp' }));
            } else {
              reject(new Error('Canvas toBlob failed'));
            }
          }, 'image/webp', quality);
        };
        img.src = e.target?.result as string;
      };
      reader.onerror = error => reject(error);
    });
  }

  imageFile?.addEventListener('change', async () => {
    const file = imageFile.files?.[0];
    if (!file) return;

    submitBtn.disabled = true;
    uploadStatus.style.display = 'flex';
    uploadText.style.display = 'none';
    
    try {
      const compressed = await compressImage(file, 1200, 0.85);
      
      const formData = new FormData();
      formData.append('file', compressed);

      const res = await fetch('/api/admin/upload', {
        method: 'POST',
        body: formData
      });

      const result = await res.json() as Record<string, any>;
      if (res.ok && result.success) {
        imageUrl.value = result.url;
        imagePreview.style.backgroundImage = `url(${result.url})`;
      } else {
        alert('ছবি আপলোড ব্যর্থ হয়েছে: ' + (result.error || 'অজানা ত্রুটি'));
      }
    } catch (err) {
      console.error(err);
      alert('ছবি প্রসেসিং করতে সমস্যা হয়েছে।');
    } finally {
      submitBtn.disabled = false;
      uploadStatus.style.display = 'none';
      uploadText.style.display = 'block';
    }
  });

  
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;
    submitBtn.innerHTML = 'সেভ হচ্ছে...';

    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());
    
    // Formatting data properly
    const payload = {
      ...data,
      students: parseInt(data.students as string) || 0,
      price: data.price ? parseInt(data.price as string) : null,
      rating: parseFloat(data.rating as string) || 0.0
    };

    const endpoint = data.id === 'new' 
      ? '/api/admin/courses/create' 
      : '/api/admin/courses/update';

    try {
      const res = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      
      const result = await res.json() as Record<string, any>;
      
      if (res.ok && result.success) {
        alert('সফলভাবে সেভ হয়েছে!');
        window.location.href = '/admin/courses';
      } else {
        throw new Error(result.error || 'সেভ করতে সমস্যা হয়েছে।');
      }
    } catch (err: any) {
      alert(err.message);
      submitBtn.disabled = false;
      submitBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg> সেভ করুন';
    }
  });
</script>

<style>
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--admin-text-light);
    text-decoration: none;
    font-size: 0.9rem;
    margin-bottom: 8px;
    font-weight: 500;
  }
  .back-link:hover {
    color: var(--admin-primary);
  }

  .max-w-3xl {
    max-width: 800px;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .full-width {
    grid-column: 1 / -1;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--admin-text);
  }

  input, select, textarea {
    padding: 10px 14px;
    border: 1px solid var(--admin-border);
    border-radius: 8px;
    font-size: 0.95rem;
    background: #f8fafc;
    outline: none;
    transition: all 0.2s;
    font-family: inherit;
  }

  input:focus, select:focus, textarea:focus {
    background: #fff;
    border-color: var(--admin-primary);
    box-shadow: 0 0 0 3px var(--admin-primary-light);
  }

  .hint {
    font-size: 0.8rem;
    color: var(--admin-text-light);
  }

  .form-actions {
    margin-top: 32px;
    display: flex;
    justify-content: flex-end;
    padding-top: 24px;
    border-top: 1px solid var(--admin-border);
  }

  .btn-save {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--admin-primary);
    color: white;
    border: none;
    padding: 10px 24px;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
  }
  .btn-save:hover {
    background: #06b6d4;
  }
  .btn-save:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  @media (max-width: 640px) {
    .form-grid {
      grid-template-columns: 1fr;
    }
  }

  .image-upload-wrapper {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .image-preview {
    position: relative;
    width: 100%;
    max-width: 400px;
    height: 225px;
    background-color: var(--admin-surface);
    background-size: cover;
    background-position: center;
    border: 2px dashed var(--admin-border);
    border-radius: 12px;
    overflow: hidden;
    cursor: pointer;
    transition: all 0.2s;
  }

  .image-preview:hover {
    border-color: var(--admin-primary);
  }

  .preview-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .image-preview:hover .preview-overlay {
    opacity: 1;
  }

  .preview-overlay span {
    color: white;
    font-weight: 600;
    padding: 8px 16px;
    background: rgba(0, 0, 0, 0.6);
    border-radius: 8px;
    font-size: 0.9rem;
  }

  .file-input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    z-index: 2;
  }

  .upload-status {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--admin-primary);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .upload-spinner {
    width: 16px;
    height: 16px;
    border: 2px solid var(--admin-primary-light);
    border-top-color: var(--admin-primary);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }
</style>
