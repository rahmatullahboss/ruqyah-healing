---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { createDb } from '../../db/client.js';
import { courses, courseModules, courseLessons, courseQuizzes } from '../../db/schema.js';
import { eq, asc } from 'drizzle-orm';
import { env as workerEnv } from 'cloudflare:workers';
import { ArrowLeft, Save, Plus, Edit, Trash2, GripVertical, ChevronDown, ChevronRight, PlayCircle, FileText, ListChecks } from '@lucide/astro';
import { safeJsonArray } from '../../lib/lms-access.js';

export const prerender = false;

const env = workerEnv || process.env;
const db = createDb((env as any).DATABASE_URL);

const id = Astro.url.searchParams.get('id');
let course: any = null;
let modules: any[] = [];
let lessons: any[] = [];
let quizzes: any[] = [];
let outcomesText = '';
let requirementsText = '';
let faqText = '';

if (id && id !== 'new') {
  const result = await db.select().from(courses).where(eq(courses.id, id));
  if (result.length > 0) course = result[0];

  if (course) {
    outcomesText = safeJsonArray(course.outcomes).join('\n');
    requirementsText = safeJsonArray(course.requirements).join('\n');
    faqText = safeJsonArray(course.faq)
      .map((item: any) => `${item.question || ''}\n${item.answer || ''}`.trim())
      .filter(Boolean)
      .join('\n\n');

    modules = await db.select().from(courseModules)
      .where(eq(courseModules.courseId, course.id))
      .orderBy(asc(courseModules.sortOrder));

    lessons = await db.select().from(courseLessons)
      .where(eq(courseLessons.courseId, course.id))
      .orderBy(asc(courseLessons.sortOrder));

    quizzes = await db.select().from(courseQuizzes)
      .where(eq(courseQuizzes.courseId, course.id))
      .orderBy(asc(courseQuizzes.sortOrder));
  }
}
---

<AdminLayout title={course ? 'কোর্স আপডেট' : 'নতুন কোর্স'}>
  <div class="page-header">
    <div>
      <a href="/admin/courses" class="back-link">
        <ArrowLeft size={16} /> ফিরে যান
      </a>
      <h1 class="page-title">{course ? 'কোর্স আপডেট করুন' : 'নতুন কোর্স তৈরি করুন'}</h1>
    </div>
  </div>

  <!-- Course Metadata Form -->
  <div class="admin-card max-w-3xl">
    <form id="courseForm">
      <input type="hidden" name="id" value={course?.id || 'new'} />

      <div class="form-grid">
        <div class="form-group full-width">
          <label>কোর্সের নাম *</label>
          <input type="text" name="title" required value={course?.title || ''} placeholder="যেমন: বেসিক রুকইয়াহ ফ্রি কোর্স" />
        </div>

        <div class="form-group">
          <label>ইন্সট্রাক্টর *</label>
          <input type="text" name="instructor" required value={course?.instructor || ''} placeholder="ইন্সট্রাক্টরের নাম" />
        </div>

        <div class="form-group">
          <label>মোট শিক্ষার্থী (Optional)</label>
          <input type="number" name="students" value={course?.students || 0} />
        </div>

        <div class="form-group">
          <label>ক্লাস সংখ্যা ও টেক্সট *</label>
          <input type="text" name="classCount" required value={course?.classCount || ''} placeholder="যেমন: ৬ টি ক্লাস" />
        </div>

        <div class="form-group">
          <label>কোর্সের সময়কাল *</label>
          <input type="text" name="hours" required value={course?.hours || ''} placeholder="যেমন: ৮ সপ্তাহ" />
        </div>

        <div class="form-group">
          <label>স্তর (Level) *</label>
          <select name="level" required>
            <option value="শুরুর স্তর" selected={course?.level === 'শুরুর স্তর'}>শুরুর স্তর</option>
            <option value="মধ্যম স্তর" selected={course?.level === 'মধ্যম স্তর'}>মধ্যম স্তর</option>
            <option value="উন্নত স্তর" selected={course?.level === 'উন্নত স্তর'}>উন্নত স্তর</option>
          </select>
        </div>

        <div class="form-group">
          <label>ক্যাটাগরি</label>
          <select name="category">
            <option value="রুকইয়াহ শারইয়াহ" selected={course?.category === 'রুকইয়াহ শারইয়াহ'}>রুকইয়াহ শারইয়াহ</option>
            <option value="তিব্বে নববী" selected={course?.category === 'তিব্বে নববী'}>তিব্বে নববী</option>
            <option value="মাসনূন দুআ" selected={course?.category === 'মাসনূন দুআ'}>মাসনূন দুআ</option>
            <option value="ইসলামিক স্টাডিজ" selected={course?.category === 'ইসলামিক স্টাডিজ'}>ইসলামিক স্টাডিজ</option>
          </select>
        </div>

        <div class="form-group">
          <label>স্ট্যাটাস</label>
          <select name="status">
            <option value="draft" selected={(course?.status || 'draft') === 'draft'}>ড্রাফট</option>
            <option value="published" selected={course?.status === 'published'}>পাবলিশড</option>
            <option value="unpublished" selected={course?.status === 'unpublished'}>আনপাবলিশড</option>
          </select>
        </div>

        <div class="form-group">
          <label>ভাষা</label>
          <input type="text" name="language" value={course?.language || 'বাংলা'} placeholder="বাংলা" />
        </div>

        <div class="form-group">
          <label>অ্যাক্সেস মোড</label>
          <select name="accessMode">
            <option value="open" selected={(course?.accessMode || 'open') === 'open'}>সব লেসন একসাথে</option>
            <option value="sequential" selected={course?.accessMode === 'sequential'}>একটার পর একটা আনলক</option>
          </select>
        </div>

        <div class="form-group">
          <label>সার্টিফিকেট</label>
          <select name="certificateEnabled">
            <option value="true" selected={course?.certificateEnabled !== false}>চালু</option>
            <option value="false" selected={course?.certificateEnabled === false}>বন্ধ</option>
          </select>
        </div>

        <div class="form-group">
          <label>মূল্য (বিনা মূল্যের জন্য ফাঁকা বা 0 রাখুন)</label>
          <input type="number" name="price" value={course?.price || ''} placeholder="0" />
        </div>

        <div class="form-group">
          <label>ডিসকাউন্ট মূল্য</label>
          <input type="number" name="salePrice" value={course?.salePrice || ''} placeholder="Optional" />
        </div>

        <div class="form-group">
          <label>রেটিং</label>
          <input type="number" step="0.1" max="5" name="rating" value={course?.rating || '5.0'} />
        </div>

        <div class="form-group full-width">
          <label>ভিডিও লিংক (Google Drive / YouTube) (Optional)</label>
          <input type="url" name="videoLink" value={course?.videoLink || ''} placeholder="যেমন: https://drive.google.com/... বা https://youtube.com/..." />
          <small class="hint">শুধু পাবলিক ট্রেইলার/প্রোমো ভিডিওর জন্য। লেসন ভিডিও লেসনের ভিতরে দিন।</small>
        </div>

        <div class="form-group full-width">
          <label>কোর্সের কভার ছবি *</label>
          <div class="image-upload-wrapper">
            <input type="hidden" name="image" id="imageUrl" value={course?.image || '/images/courses/default.webp'} />

            <div id="imagePreview" class="image-preview" style={`background-image: url(${course?.image || '/images/courses/default.webp'})`}>
              <div class="preview-overlay">
                <span id="uploadText">ছবি পরিবর্তন করুন</span>
              </div>
              <input type="file" id="imageFile" accept="image/*" class="file-input" />
            </div>

            <div class="upload-status" id="uploadStatus" style="display: none;">
              <span class="upload-spinner"></span> আপলোড হচ্ছে...
            </div>
          </div>
        </div>

        <div class="form-group full-width">
          <label>সংক্ষিপ্ত বিবরণ *</label>
          <textarea name="desc" required rows="3">{course?.desc || ''}</textarea>
        </div>

        <div class="form-group full-width">
          <label>পাবলিক পেজের সংক্ষিপ্ত কপি</label>
          <textarea name="shortDescription" rows="2" placeholder="কার্ড/হিরোতে দেখানোর সংক্ষিপ্ত কপি">{course?.shortDescription || ''}</textarea>
        </div>

        <div class="form-group full-width">
          <label>বিস্তারিত বর্ণনা</label>
          <textarea name="fullDescription" rows="5" placeholder="কোর্স ডিটেইল পেজের বিস্তারিত কপি">{course?.fullDescription || ''}</textarea>
        </div>

        <div class="form-group full-width">
          <label>কোর্স আউটকাম (প্রতি লাইনে একটি)</label>
          <textarea name="outcomes" rows="4" placeholder="এই কোর্স শেষে শিক্ষার্থী কী শিখবে">{outcomesText}</textarea>
        </div>

        <div class="form-group full-width">
          <label>রিকোয়ারমেন্ট (প্রতি লাইনে একটি)</label>
          <textarea name="requirements" rows="3" placeholder="কোর্স শুরু করার আগে যা জানা/থাকা দরকার">{requirementsText}</textarea>
        </div>

        <div class="form-group full-width">
          <label>FAQ</label>
          <textarea name="faq" rows="5" placeholder={`প্রশ্ন লিখুন\nউত্তর লিখুন\n\nআরেকটি প্রশ্ন\nআরেকটি উত্তর`}>{faqText}</textarea>
          <small class="hint">প্রতিটি FAQ ব্লক ফাঁকা লাইন দিয়ে আলাদা করুন। প্রথম লাইন প্রশ্ন, পরের লাইনগুলো উত্তর।</small>
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn-save" id="saveBtn">
          <Save size={18} />
          সেভ করুন
        </button>
      </div>
    </form>
  </div>

  <!-- Course Content Management (only for existing courses) -->
  {course && (
    <div class="content-section">
      <div class="section-header">
        <h2 class="section-title">কোর্স কন্টেন্ট</h2>
        <button class="btn-primary" id="addModuleBtn">
          <Plus size={16} />
          নতুন মডিউল
        </button>
      </div>

      <div id="modulesContainer" class="modules-container">
        {modules.map((mod) => (
          <div class="module-card" data-module-id={mod.id}>
            <div class="module-header" data-toggle={mod.id}>
              <div class="module-info">
                <GripVertical size={16} class="drag-handle" />
                <ChevronDown size={16} class="module-chevron" id={`chevron-${mod.id}`} />
                <span class="module-title">{mod.title}</span>
                <span class="module-count">
                  {lessons.filter(l => l.moduleId === mod.id).length} টি লেসন
                  {quizzes.filter(q => q.moduleId === mod.id).length > 0 &&
                    `, ${quizzes.filter(q => q.moduleId === mod.id).length} টি কুইজ`}
                </span>
              </div>
              <div class="module-actions">
                <button class="action-btn edit" title="এডিট" data-edit-module={mod.id} data-title={mod.title} data-desc={mod.description || ''}>
                  <Edit size={14} />
                </button>
                <button class="action-btn delete" title="ডিলিট" data-delete-module={mod.id}>
                  <Trash2 size={14} />
                </button>
              </div>
            </div>

            <div class="module-body" id={`module-body-${mod.id}`} style="display:none;">
              {lessons.filter(l => l.moduleId === mod.id).map((lesson) => (
                <div class="lesson-item" data-lesson-id={lesson.id}>
                  <div class="lesson-info">
                    {lesson.contentType === 'video' ? (
                      <PlayCircle size={16} class="lesson-icon video" />
                    ) : (
                      <FileText size={16} class="lesson-icon text" />
                    )}
                    <span class="lesson-title">{lesson.title}</span>
                    {lesson.duration && <span class="lesson-duration">{lesson.duration}</span>}
                    {lesson.isFreePreview && <span class="free-badge">ফ্রি</span>}
                  </div>
                  <div class="lesson-actions">
                    <a href={`/admin/lesson-edit?id=${lesson.id}&courseId=${course.id}`} class="action-btn edit" title="এডিট">
                      <Edit size={14} />
                    </a>
                    <button class="action-btn delete" title="ডিলিট" data-delete-lesson={lesson.id}>
                      <Trash2 size={14} />
                    </button>
                  </div>
                </div>
              ))}

              {quizzes.filter(q => q.moduleId === mod.id).map((quiz) => (
                <div class="lesson-item quiz-item" data-quiz-id={quiz.id}>
                  <div class="lesson-info">
                    <ListChecks size={16} class="lesson-icon quiz" />
                    <span class="lesson-title">{quiz.title}</span>
                    <span class="quiz-meta">পাস: {quiz.passingScore}%</span>
                  </div>
                  <div class="lesson-actions">
                    <a href={`/admin/quiz-edit?id=${quiz.id}&courseId=${course.id}`} class="action-btn edit" title="এডিট">
                      <Edit size={14} />
                    </a>
                    <button class="action-btn delete" title="ডিলিট" data-delete-quiz={quiz.id}>
                      <Trash2 size={14} />
                    </button>
                  </div>
                </div>
              ))}

              <div class="add-buttons">
                <a href={`/admin/lesson-edit?moduleId=${mod.id}&courseId=${course.id}`} class="add-lesson-btn">
                  <Plus size={14} /> লেসন যোগ করুন
                </a>
                <a href={`/admin/quiz-edit?moduleId=${mod.id}&courseId=${course.id}`} class="add-quiz-btn">
                  <Plus size={14} /> কুইজ যোগ করুন
                </a>
              </div>
            </div>
          </div>
        ))}

        {modules.length === 0 && (
          <div class="empty-state">
            <p>এখনো কোনো মডিউল যোগ করা হয়নি। "নতুন মডিউল" বাটনে ক্লিক করে শুরু করুন।</p>
          </div>
        )}
      </div>
    </div>
  )}

  <!-- Module Add/Edit Modal -->
  <div id="moduleModal" class="modal-overlay" style="display:none;">
    <div class="modal">
      <h3 id="moduleModalTitle">নতুন মডিউল</h3>
      <input type="hidden" id="moduleEditId" />
      <div class="form-group">
        <label>মডিউলের নাম *</label>
        <input type="text" id="moduleTitleInput" placeholder="যেমন: প্রথম পাঠ" />
      </div>
      <div class="form-group">
        <label>বিবরণ (Optional)</label>
        <textarea id="moduleDescInput" rows="2" placeholder="মডিউলের সংক্ষিপ্ত বিবরণ"></textarea>
      </div>
      <div class="modal-actions">
        <button class="btn-cancel" id="moduleCancelBtn">বাতিল</button>
        <button class="btn-primary" id="moduleSaveBtn">সেভ করুন</button>
      </div>
    </div>
  </div>
</AdminLayout>

<script define:vars={{ courseId: course?.id }}>
  const form = document.getElementById('courseForm');
  const saveBtn = document.getElementById('saveBtn');
  const imageFile = document.getElementById('imageFile');
  const imagePreview = document.getElementById('imagePreview');
  const imageUrlEl = document.getElementById('imageUrl');
  const uploadText = document.getElementById('uploadText');
  const uploadStatus = document.getElementById('uploadStatus');

  function compressImage(file, maxWidth = 1000, quality = 0.8) {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.readAsDataURL(file);
      reader.onload = (e) => {
        const img = new Image();
        img.onload = () => {
          const canvas = document.createElement('canvas');
          let width = img.width;
          let height = img.height;
          if (width > maxWidth) { height = Math.round((height * maxWidth) / width); width = maxWidth; }
          canvas.width = width;
          canvas.height = height;
          const ctx = canvas.getContext('2d');
          if (!ctx) return reject(new Error('Canvas ctx null'));
          ctx.drawImage(img, 0, 0, width, height);
          canvas.toBlob((blob) => {
            if (blob) resolve(new File([blob], file.name.replace(/\.[^/.]+$/, "") + ".webp", { type: 'image/webp' }));
            else reject(new Error('Canvas toBlob failed'));
          }, 'image/webp', quality);
        };
        img.src = e.target?.result;
      };
      reader.onerror = error => reject(error);
    });
  }

  imageFile?.addEventListener('change', async () => {
    const file = imageFile.files?.[0];
    if (!file) return;
    saveBtn.disabled = true;
    uploadStatus.style.display = 'flex';
    uploadText.style.display = 'none';
    try {
      const compressed = await compressImage(file, 1200, 0.85);
      const formData = new FormData();
      formData.append('file', compressed);
      const res = await fetch('/api/admin/upload', { method: 'POST', body: formData });
      const result = await res.json();
      if (res.ok && result.success) {
        imageUrlEl.value = result.url;
        imagePreview.style.backgroundImage = `url(${result.url})`;
      } else {
        alert('ছবি আপলোড ব্যর্থ: ' + (result.error || 'অজানা ত্রুটি'));
      }
    } catch (err) {
      console.error(err);
      alert('ছবি প্রসেসিং সমস্যা।');
    } finally {
      saveBtn.disabled = false;
      uploadStatus.style.display = 'none';
      uploadText.style.display = 'block';
    }
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    saveBtn.disabled = true;
    const prevText = saveBtn.textContent;
    saveBtn.textContent = 'সেভ হচ্ছে...';
    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());
    const payload = {
      ...data,
      students: parseInt(data.students) || 0,
      price: data.price ? parseInt(data.price) : null,
      salePrice: data.salePrice ? parseInt(data.salePrice) : null,
      rating: parseFloat(data.rating) || 0.0,
      certificateEnabled: data.certificateEnabled === 'true'
    };
    const endpoint = data.id === 'new' ? '/api/admin/courses/create' : '/api/admin/courses/update';
    try {
      const res = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const result = await res.json();
      if (res.ok && result.success) {
        if (data.id === 'new' && result.id) {
          window.location.href = `/admin/course-edit?id=${result.id}`;
        } else {
          alert('সফলভাবে সেভ হয়েছে!');
          window.location.reload();
        }
      } else {
        throw new Error(result.error || 'সেভ সমস্যা।');
      }
    } catch (err) {
      alert(err.message);
      saveBtn.disabled = false;
      saveBtn.textContent = prevText;
    }
  });

  // Module toggle
  document.querySelectorAll('[data-toggle]').forEach(el => {
    el.addEventListener('click', () => {
      const moduleId = el.getAttribute('data-toggle');
      const body = document.getElementById(`module-body-${moduleId}`);
      const chevron = document.getElementById(`chevron-${moduleId}`);
      if (body.style.display === 'none') {
        body.style.display = 'block';
        chevron.style.transform = 'rotate(0deg)';
      } else {
        body.style.display = 'none';
        chevron.style.transform = 'rotate(-90deg)';
      }
    });
  });

  // Module modal
  const moduleModal = document.getElementById('moduleModal');
  const moduleTitleInput = document.getElementById('moduleTitleInput');
  const moduleDescInput = document.getElementById('moduleDescInput');
  const moduleEditId = document.getElementById('moduleEditId');
  const moduleModalTitle = document.getElementById('moduleModalTitle');

  function openModuleModal(editId, title, desc) {
    moduleModal.style.display = 'flex';
    moduleEditId.value = editId || '';
    moduleTitleInput.value = title || '';
    moduleDescInput.value = desc || '';
    moduleModalTitle.textContent = editId ? 'মডিউল এডিট করুন' : 'নতুন মডিউল';
  }

  document.getElementById('addModuleBtn')?.addEventListener('click', () => openModuleModal());
  document.getElementById('moduleCancelBtn')?.addEventListener('click', () => { moduleModal.style.display = 'none'; });

  // Edit module buttons
  document.querySelectorAll('[data-edit-module]').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const id = btn.getAttribute('data-edit-module');
      const title = btn.getAttribute('data-title');
      const desc = btn.getAttribute('data-desc');
      openModuleModal(id, title, desc);
    });
  });

  // Save module
  document.getElementById('moduleSaveBtn')?.addEventListener('click', async () => {
    const editId = moduleEditId.value;
    const title = moduleTitleInput.value.trim();
    const description = moduleDescInput.value.trim();
    if (!title) { alert('মডিউলের নাম দিন'); return; }

    const endpoint = editId ? '/api/admin/modules/update' : '/api/admin/modules/create';
    const body = editId ? { id: editId, title, description } : { courseId, title, description };

    try {
      const res = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });
      const result = await res.json();
      if (res.ok && result.success) window.location.reload();
      else alert(result.error || 'সমস্যা হয়েছে।');
    } catch (err) { alert('সার্ভার সমস্যা।'); }
  });

  // Delete module
  document.querySelectorAll('[data-delete-module]').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      e.stopPropagation();
      if (!confirm('এই মডিউল এবং এর সব লেসন/কুইজ ডিলিট হবে। নিশ্চিত?')) return;
      try {
        const res = await fetch('/api/admin/modules/delete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: btn.getAttribute('data-delete-module') })
        });
        const result = await res.json();
        if (res.ok && result.success) window.location.reload();
        else alert(result.error || 'ডিলিট সমস্যা।');
      } catch (err) { alert('সার্ভার সমস্যা।'); }
    });
  });

  // Delete lesson
  document.querySelectorAll('[data-delete-lesson]').forEach(btn => {
    btn.addEventListener('click', async () => {
      if (!confirm('এই লেসন ডিলিট হবে। নিশ্চিত?')) return;
      try {
        const res = await fetch('/api/admin/lessons/delete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: btn.getAttribute('data-delete-lesson') })
        });
        const result = await res.json();
        if (res.ok && result.success) window.location.reload();
        else alert(result.error || 'ডিলিট সমস্যা।');
      } catch (err) { alert('সার্ভার সমস্যা।'); }
    });
  });

  // Delete quiz
  document.querySelectorAll('[data-delete-quiz]').forEach(btn => {
    btn.addEventListener('click', async () => {
      if (!confirm('এই কুইজ ডিলিট হবে। নিশ্চিত?')) return;
      try {
        const res = await fetch('/api/admin/quizzes/delete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: btn.getAttribute('data-delete-quiz') })
        });
        const result = await res.json();
        if (res.ok && result.success) window.location.reload();
        else alert(result.error || 'ডিলিট সমস্যা।');
      } catch (err) { alert('সার্ভার সমস্যা।'); }
    });
  });
</script>

