---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { env as workerEnv } from 'cloudflare:workers';
import { createDb } from '../../db/client.js';
import { getPostBySlug, getRelatedPosts } from '../../lib/posts.js';
import { renderMarkdown, calculateReadingTime } from '../../lib/markdown.js';

export const prerender = false;

const { slug } = Astro.params;
const env = workerEnv || process.env;
const db = createDb(env.DATABASE_URL);

const post = await getPostBySlug(db, slug);
if (!post) {
  return Astro.redirect('/blog');
}

const related = await getRelatedPosts(db, post.category, post.slug, 3);

const contentHtml = renderMarkdown(post.content);
const wordCount = post.content.split(/\s+/).length;
const readingTime = calculateReadingTime(post.content);

// JSON-LD BlogPosting schema
const siteUrl   = Astro.site?.origin || 'https://ruqyah-healing.pages.dev';
const postUrl   = `${siteUrl}/posts/${post.slug}`;
const tags = Array.isArray(post.tags) ? post.tags : [];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type':    'BlogPosting',
  headline:   post.title,
  description: post.excerpt,
  url:          postUrl,
  datePublished: post.date,
  dateModified:  post.date,
  inLanguage:    'bn-BD',
  author: {
    '@type': 'Person',
    name:    'মুফতী মুহাম্মাদ আল-আমীন',
    url:     `${siteUrl}/profile`,
  },
  publisher: {
    '@type': 'Organization',
    name:    'রুকইয়াহ হিলিং সেন্টার',
    url:     siteUrl,
    logo: {
      '@type': 'ImageObject',
      url:     `${siteUrl}/favicon.svg`,
    },
  },
  keywords: tags.join(', '),
  articleSection: post.category,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id':   postUrl,
  },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type':    'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'হোম',  item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'ব্লগ', item: `${siteUrl}/blog` },
    { '@type': 'ListItem', position: 3, name: post.category, item: `${siteUrl}/category/${post.category}` },
    { '@type': 'ListItem', position: 4, name: post.title, item: postUrl },
  ],
};

const formattedDate = new Date(post.date).toLocaleDateString('bn-BD', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---

<BaseLayout
  title={`${post.title} | রুকইয়াহ হিলিং`}
  description={post.excerpt}
  ogType="article"
  articleDate={post.date}
  articleSection={post.category}
  keywords={tags}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />

  <Header />

  <section class="post-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="breadcrumb">
        <a href="/">হোম</a>
        <span aria-hidden="true">›</span>
        <a href="/blog">ব্লগ</a>
        <span aria-hidden="true">›</span>
        <a href={`/category/${post.category}`}>{post.category}</a>
      </nav>
      <span class="cat-badge">{post.category}</span>
      <h1>{post.title}</h1>
      <div class="post-meta-row">
        <time datetime={post.date} class="post-date">
          🗓 {formattedDate}
        </time>
        <span class="reading-time">🕐 {readingTime} মিনিট পড়া</span>
        <span class="word-count">📝 ~{wordCount} শব্দ</span>
      </div>
      <p class="post-excerpt">{post.excerpt}</p>
    </div>
  </section>

  <section class="section-sm">
    <div class="container post-layout">
      <article class="prose" id="post-content" itemscope itemtype="https://schema.org/BlogPosting">
        <meta itemprop="headline" content={post.title} />
        <meta itemprop="datePublished" content={post.date} />
        <Fragment set:html={contentHtml} />
      </article>

      {tags.length > 0 && (
        <div class="post-tags">
          <strong>ট্যাগ:</strong>
          {tags.map((tag) => (
            <span class="tag">#{tag}</span>
          ))}
        </div>
      )}

      <div class="share-bar">
        <span>এই পোস্টটি উপকারী মনে হলে শেয়ার করুন 🤲</span>
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section-sm related-section">
      <div class="container">
        <h2 class="related-title">আরও পড়ুন</h2>
        <div class="grid-3">
          {related.map((rel) => (
            <a href={`/posts/${rel.slug}`} class="rel-card">
              <span class="cat-badge small">{rel.category}</span>
              <h3>{rel.title}</h3>
              <p>{rel.excerpt.substring(0, 100)}…</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <Footer />
</BaseLayout>

<style>
  .post-hero {
    background: linear-gradient(135deg, var(--dark-section) 0%, #065f46 100%);
    color: #fff;
    padding: 64px 0 56px;
  }
  .post-hero .breadcrumb {
    display: flex;
    gap: 8px;
    align-items: center;
    color: rgba(255,255,255,0.55);
    font-size: 13px;
    margin-bottom: 20px;
  }
  .post-hero .breadcrumb a { color: rgba(255,255,255,0.65); }
  .post-hero .breadcrumb a:hover { color: #fff; }
  .post-hero .cat-badge {
    background: rgba(255,255,255,0.15);
    color: #fff;
    margin-bottom: 16px;
    display: inline-block;
    font-size: 12px;
    font-weight: 600;
    padding: 4px 14px;
    border-radius: 20px;
    letter-spacing: 0.5px;
  }
  .post-hero h1 {
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 800;
    line-height: 1.3;
    margin: 12px 0 16px;
    max-width: 780px;
  }
  .post-meta-row {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    align-items: center;
    font-size: 13px;
    color: rgba(255,255,255,0.55);
    margin-bottom: 20px;
  }
  .post-excerpt {
    color: rgba(255,255,255,0.75);
    font-size: 16px;
    max-width: 680px;
    line-height: 1.7;
  }

  .post-layout { max-width: 780px; }

  .post-tags {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    font-size: 14px;
    color: var(--text-muted);
  }
  .tag {
    background: var(--bg-light);
    border: 1px solid var(--border);
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 13px;
    color: var(--primary-dark);
    font-weight: 500;
  }

  .share-bar {
    margin-top: 32px;
    padding: 16px 20px;
    background: var(--primary-light);
    border-radius: var(--radius-md);
    border-left: 4px solid var(--primary);
    font-size: 14px;
    color: var(--primary-dark);
    font-weight: 600;
    text-align: center;
  }

  .related-section { background: var(--bg-light); }
  .related-title { font-size: 1.4rem; font-weight: 700; margin-bottom: 28px; }
  .rel-card {
    background: var(--bg-white);
    border-radius: var(--radius-md);
    padding: 20px;
    box-shadow: var(--shadow-sm);
    display: block;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    border: 1px solid var(--border);
  }
  .rel-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
  .rel-card .cat-badge.small {
    font-size: 11px; padding: 3px 10px; margin-bottom: 10px;
    display: inline-block; background: var(--primary-light);
    color: var(--primary-dark); border-radius: 20px;
  }
  .rel-card h3 { font-size: 15px; font-weight: 700; color: var(--text-dark); margin: 8px 0; line-height: 1.4; }
  .rel-card p { font-size: 13px; color: var(--text-muted); line-height: 1.6; }

  @media (max-width: 768px) {
    .post-hero { padding: 48px 0 40px; }
    .post-meta-row { gap: 12px; }
  }
</style>
