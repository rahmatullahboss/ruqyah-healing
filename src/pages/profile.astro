---
import BaseLayout from '../layouts/BaseLayout.astro';
import { env as workerEnv } from 'cloudflare:workers';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Edit, User, Mail, Phone, MapPin, Calendar, Heart, ArrowRight, Activity } from '@lucide/astro';
import { createDb } from '../db/client.js';
import { appointments as appointmentsSchema, testResults } from '../db/schema';
import { eq, desc } from 'drizzle-orm';

export const prerender = false;

const user = (Astro.locals as App.Locals).user || {
  fullName: 'Loading...',
  email: '',
  phone: '',
  address: '',
  dob: '',
  gender: ''
};


// Fetch dynamic appointments based on user's phone number
let userAppointments: any[] = [];
let userTestResults: any[] = [];
if (user && user.id) {
  try {
    const env = (workerEnv || process.env) as any;
    const db = createDb(env.DATABASE_URL);
    userAppointments = await db.select()
      .from(appointmentsSchema)
      .where(eq(appointmentsSchema.phone, user.phone))
      .orderBy(desc(appointmentsSchema.createdAt));
    userTestResults = await db.select()
      .from(testResults)
      .where(eq(testResults.userId, user.id))
      .orderBy(desc(testResults.createdAt))
      .limit(10);
  } catch (error) {
    console.error("Failed to fetch profile data:", error);
  }
}

// Map db appointments to view model
const appointmentsList = userAppointments.map((appt) => {
  let statusClass = 'upcoming';
  if (appt.status === 'completed' || appt.status === 'সম্পন্ন') statusClass = 'done';
  if (appt.status === 'pending') statusClass = 'pending';
  
  return {
    title: appt.treatmentTypeLabel || 'রুকইয়াহ চিকিৎসা',
    raqi: appt.serviceMode || 'অনলাইন/অফলাইন',
    date: appt.preferredDate || '',
    time: appt.preferredTime || '',
    status: appt.status === 'pending' ? 'পেন্ডিং' : appt.status === 'completed' ? 'সম্পন্ন' : appt.status,
    statusClass
  };
});

// Update stats based on dynamic data
const stats = [
  { label: 'মোট এ্যাপয়নমেন্ট', value: userAppointments.length, color: 'var(--primary)' },
  { label: 'সম্পন্ন সেশন', value: userAppointments.filter((appointment) => appointment.status === 'completed' || appointment.status === 'সম্পন্ন').length, color: '#22c55e' },
  { label: 'পেন্ডিং সেশন', value: userAppointments.filter((appointment) => appointment.status === 'pending').length, color: '#f59e0b' },
];
---

<BaseLayout title="প্রোফাইল | Ruqyah Healing Center" description="আপনার তথ্য এবং এ্যাপয়নমেন্ট ইতিহাস দেখুন।">
  <Header />

  <main>
    <section class="profile-hero">
      <div class="container">
        <h1>প্রোফাইল</h1>
        <p>আপনার তথ্য এবং এ্যাপয়নমেন্ট ইতিহাস দেখুন</p>
      </div>
    </section>

    <section class="profile-section">
      <div class="container">
        <div class="profile-layout">

          <!-- Main content -->
          <div class="profile-main">

            <!-- Personal Info -->
            <div class="info-card">
              <div class="card-top">
                <h2>ব্যক্তিগত তথ্য</h2>
                <a href="/profile/edit" class="edit-btn">
                  <Edit size={16} />
                  সম্পাদনা
                </a>
              </div>

              <div class="info-grid">
                <div class="info-field">
                  <label>নাম</label>
                  <div class="info-value">
                    <User size={16} />
                    {user.fullName}
                  </div>
                </div>
                <div class="info-field">
                  <label>ইমেইল</label>
                  <div class="info-value">
                    <Mail size={16} />
                    {user.email || 'দেওয়া হয়নি'}
                  </div>
                </div>
                <div class="info-field">
                  <label>ফোন</label>
                  <div class="info-value">
                    <Phone size={16} />
                    {user.phone}
                  </div>
                </div>
                <div class="info-field">
                  <label>ঠিকানা</label>
                  <div class="info-value">
                    <MapPin size={16} />
                    {user.address || 'দেওয়া হয়নি'}
                  </div>
                </div>
                <div class="info-field">
                  <label>জন্ম তারিখ</label>
                  <div class="info-value">
                    <Calendar size={16} />
                    {user.dob || 'দেওয়া হয়নি'}
                  </div>
                </div>
                <div class="info-field">
                  <label>লিঙ্গ</label>
                  <div class="info-value">
                    <Heart size={16} />
                    {user.gender}
                  </div>
                </div>
              </div>
            </div>

            <!-- Appointment History -->
            <div class="appt-card">
              <h2>এ্যাপয়নমেন্ট ইতিহাস</h2>
              <div class="appt-list">
                {appointmentsList.length > 0 ? appointmentsList.map((appt: any) => (
                  <div class="appt-item">
                    <div class="appt-body">
                      <h3>{appt.title}</h3>
                      <p class="appt-raqi">{appt.raqi}</p>
                      <div class="appt-meta">
                        <span>🗓 {appt.date}</span>
                        <span>⏰ {appt.time}</span>
                      </div>
                    </div>
                    <span class:list={['appt-status', appt.statusClass]}>{appt.status}</span>
                  </div>
                )) : (
                  <div class="no-appointments">
                    <p style="color: var(--text-muted); padding: 20px 0; text-align: center;">কোনো এ্যাপয়নমেন্ট পাওয়া যায়নি</p>
                  </div>
                )}
              </div>
            </div>

            <!-- Test Results History -->
            <div class="appt-card">
              <h2>রুকইয়াহ ডায়াগনোসিস ইতিহাস</h2>
              <div class="appt-list">
                {userTestResults.length > 0 ? userTestResults.map((tr: any) => (
                  <div class="appt-item">
                    <div class="appt-body">
                      <h3>{tr.testTitle}</h3>
                      <p class="appt-raqi">স্কোর: {tr.score}% | হ্যাঁ: {tr.yesCount} | মাঝে মধ্যে: {tr.maybeCount} | না: {tr.noCount}</p>
                      <div class="appt-meta">
                        <span>🗓 {new Date(tr.createdAt).toLocaleDateString('bn-BD')}</span>
                        <span>📊 {tr.totalQuestions}টি প্রশ্ন</span>
                      </div>
                    </div>
                    <span class:list={['appt-status', tr.resultLevel === 'high' ? 'pending' : tr.resultLevel === 'medium' ? 'upcoming' : 'done']}>
                      {tr.resultLevel === 'high' ? 'উচ্চ' : tr.resultLevel === 'medium' ? 'মাঝারি' : 'স্বাভাবিক'}
                    </span>
                  </div>
                )) : (
                  <div class="no-appointments">
                    <p style="color: var(--text-muted); padding: 20px 0; text-align: center;">কোনো ডায়াগনোসিস রেকর্ড পাওয়া যায়নি</p>
                  </div>
                )}
              </div>
            </div>
          </div>

          <!-- Sidebar -->
          <div class="profile-sidebar">
            <div class="avatar-card">
              <div class="avatar-wrap">
                <div class="avatar-big">
                  <User size={48} stroke="#999" strokeWidth={1.5} />
                </div>
              </div>
              <h3>{user.fullName}</h3>
              <p>{user.email}</p>
              <button class="upload-btn">ছবি আপলোড করুন</button>
            </div>

            <div class="stats-card">
              <h3>পরিসংখ্যান</h3>
              <div class="stats-list">
                {stats.map(stat => (
                  <div class="stat-row">
                    <span class="stat-label">{stat.label}</span>
                    <span class="stat-val" style={`color: ${stat.color}`}>{stat.value}</span>
                  </div>
                ))}
              </div>
            </div>

            <a href="/appointment" class="new-appt-btn">
              + নতুন এ্যাপয়নমেন্ট
            </a>
            <button class="logout-btn" onclick="logout()">
              লগআউট করুন
            </button>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script>
    async function logout() {
      try {
        const res = await fetch('/api/auth/logout', { method: 'POST' });
        if (res.ok) window.location.href = '/login';
      } catch (err) {
        console.error('Logout failed', err);
      }
    }
    // Make it available globally for the inline onclick
    (window as any).logout = logout;
  </script>

  <Footer />
</BaseLayout>

<style>
.profile-hero { padding: 40px 0 24px; }
.profile-hero h1 { font-size: 2rem; font-weight: 700; margin-bottom: 6px; }
.profile-hero p { color: var(--text-muted); }

.profile-section { padding: 24px 0 64px; }
.profile-layout { display: grid; grid-template-columns: 1fr 280px; gap: 24px; }

/* Info card */
.info-card, .appt-card { background: #fff; border: 1px solid var(--border); border-radius: 16px; padding: 24px; margin-bottom: 20px; }
.card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
.card-top h2, .appt-card h2 { font-size: 1.1rem; font-weight: 700; }
.edit-btn { display: flex; align-items: center; gap: 6px; padding: 8px 14px; border: 1px solid var(--border); border-radius: 8px; background: #fff; font-size: 13px; color: var(--primary); font-weight: 600; cursor: pointer; font-family: inherit; transition: all 0.2s; }
.edit-btn:hover { background: var(--primary-light); }

.info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.info-field label { display: block; font-size: 12px; color: var(--text-muted); margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.4px; }
.info-value { display: flex; align-items: center; gap: 10px; padding: 10px 14px; border: 1px solid var(--border); border-radius: 10px; font-size: 14px; color: var(--text-dark); }
.info-value svg { color: var(--text-muted); flex-shrink: 0; }

/* Appointment list */
.appt-card h2 { margin-bottom: 16px; }
.appt-list { display: flex; flex-direction: column; gap: 12px; }
.appt-item { display: flex; align-items: flex-start; justify-content: space-between; padding: 16px; border: 1px solid var(--border); border-radius: 12px; gap: 12px; }
.appt-body h3 { font-size: 15px; font-weight: 600; margin-bottom: 4px; }
.appt-raqi { font-size: 13px; color: var(--text-muted); margin-bottom: 8px; }
.appt-meta { display: flex; gap: 16px; font-size: 13px; color: var(--text-muted); }
.appt-status { padding: 5px 14px; border-radius: 20px; font-size: 13px; font-weight: 600; flex-shrink: 0; }
.appt-status.done { background: #dcfce7; color: #16a34a; }
.appt-status.upcoming { background: #fef9c3; color: #a16207; }

/* Sidebar */
.avatar-card { background: #fff; border: 1px solid var(--border); border-radius: 16px; padding: 24px; text-align: center; margin-bottom: 16px; }
.avatar-wrap { margin-bottom: 16px; }
.avatar-big { width: 96px; height: 96px; border-radius: 50%; background: var(--bg-light); border: 2px solid var(--border); display: flex; align-items: center; justify-content: center; margin: 0 auto; }
.avatar-card h3 { font-size: 16px; font-weight: 700; margin-bottom: 4px; }
.avatar-card p { font-size: 13px; color: var(--text-muted); margin-bottom: 16px; }
.upload-btn { width: 100%; padding: 10px; border: 1px solid var(--primary); border-radius: 10px; background: #fff; color: var(--primary); font-size: 14px; font-weight: 600; cursor: pointer; font-family: inherit; transition: all 0.2s; }
.upload-btn:hover { background: var(--primary-light); }

.stats-card { background: #fff; border: 1px solid var(--border); border-radius: 16px; padding: 20px; margin-bottom: 16px; }
.stats-card h3 { font-size: 15px; font-weight: 700; margin-bottom: 14px; }
.stats-list { display: flex; flex-direction: column; gap: 12px; }
.stat-row { display: flex; justify-content: space-between; align-items: center; }
.stat-label { font-size: 14px; color: var(--text-medium); }
.stat-val { font-size: 1.25rem; font-weight: 700; }

.new-appt-btn { display: block; text-align: center; background: var(--primary); color: #fff; padding: 12px; border-radius: 12px; font-size: 14px; font-weight: 600; text-decoration: none; transition: background 0.2s; margin-bottom: 12px; }
.new-appt-btn:hover { background: var(--primary-dark); }

.logout-btn { display: block; width: 100%; text-align: center; background: #fee2e2; color: #ef4444; padding: 12px; border: 1px solid #fecaca; border-radius: 12px; font-size: 14px; font-weight: 600; cursor: pointer; transition: all 0.2s; }
.logout-btn:hover { background: #fecaca; }

@media (max-width: 900px) {
  .profile-layout { grid-template-columns: 1fr; }
  .profile-sidebar { order: -1; }
  .avatar-card { display: flex; align-items: center; gap: 20px; text-align: left; }
  .avatar-wrap { margin-bottom: 0; }
}
@media (max-width: 560px) {
  .info-grid { grid-template-columns: 1fr; }
  .avatar-card { flex-direction: column; text-align: center; }
}
</style>
