<script is:inline type="application/json" id="treatmentCatalogData" set:html={JSON.stringify(treatmentCatalog)}></script>

<script>
  import { buildAppointmentWhatsappMessage, getWhatsappUrl } from '../data/clinic.js';
  import { serializeAppointmentPayload } from '../lib/appointments.js';

  type TreatmentCatalogItem = {
    value: string;
    label: string;
    options: string[];
  };

  type AppointmentApiResponse = {
    appointmentId?: string;
    eventId?: string;
    message?: string;
  };

  function createEventId() {
    if (window.crypto?.randomUUID) return `lead-${window.crypto.randomUUID()}`;
    return `lead-${Date.now()}-${Math.random().toString(36).slice(2)}`;
  }

  const treatmentCatalogData = document.getElementById('treatmentCatalogData');
  const treatmentCatalog: TreatmentCatalogItem[] = treatmentCatalogData
    ? JSON.parse(treatmentCatalogData.textContent || '[]')
    : [];

  const form = document.getElementById('appt-form');
  const treatmentSelect = document.getElementById('treatmentType');
  const subServicesWrap = document.getElementById('subServicesWrap');
  const subServicesList = document.getElementById('subServicesList');
  const previousTreatmentDetailsWrap = document.getElementById('previousTreatmentDetailsWrap');
  const previousTreatmentDetails = document.getElementById('previousTreatmentDetails');
  const submitStatus = document.getElementById('submitStatus');
  const confirmationGuidelines = document.getElementById('confirmationGuidelines');
  const submitButton = form?.querySelector('button[type="submit"]');
  const stepPanels = Array.from(document.querySelectorAll('[data-booking-step]')) as HTMLElement[];
  const stepPills = Array.from(document.querySelectorAll('[data-step-target]')) as HTMLButtonElement[];
  const prevStepBtn = document.getElementById('prevStepBtn') as HTMLButtonElement | null;
  const nextStepBtn = document.getElementById('nextStepBtn') as HTMLButtonElement | null;
  const preferredDateInput = document.getElementById('preferredDate') as HTMLInputElement | null;
  const preferredTimeSelect = document.getElementById('preferredTime') as HTMLSelectElement | null;
  const slotStatus = document.getElementById('slotAvailabilityStatus');
  const slotButtons = Array.from(document.querySelectorAll('[data-slot-value]')) as HTMLButtonElement[];
  const stepOrder = ['1', '2', '3', '4'];
  let currentStepIndex = 0;

  const escapeHtml = (value: string) =>
    value
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#39;');

  const getCurrentStep = () => stepOrder[currentStepIndex] || stepOrder[0];

  const updateSlotSelection = () => {
    const selected = preferredTimeSelect?.value || '';
    slotButtons.forEach((button) => {
      button.classList.toggle('active', button.dataset.slotValue === selected);
      button.setAttribute('aria-pressed', button.dataset.slotValue === selected ? 'true' : 'false');
    });
  };

  const setSlotStates = (slots: Array<{ value: string; label: string; available: boolean; reason: string }>) => {
    if (!preferredTimeSelect) return;

    const unavailable = new Set(slots.filter((slot) => !slot.available).map((slot) => slot.value));
    Array.from(preferredTimeSelect.options).forEach((option) => {
      if (!option.value) return;
      option.disabled = unavailable.has(option.value);
      const slot = slots.find((item) => item.value === option.value);
      option.textContent = slot && !slot.available ? `${slot.label} (Booked)` : option.value;
    });

    slotButtons.forEach((button) => {
      const value = button.dataset.slotValue || '';
      const slot = slots.find((item) => item.value === value);
      const isAvailable = slot?.available !== false;
      button.disabled = !isAvailable;
      button.classList.toggle('booked', !isAvailable);
      button.title = isAvailable ? 'এই স্লটটি ফাঁকা' : 'এই স্লটটি বুকড';
    });

    if (preferredTimeSelect.value && unavailable.has(preferredTimeSelect.value)) {
      preferredTimeSelect.value = '';
    }
    updateSlotSelection();
  };

  const refreshSlotAvailability = async () => {
    if (!preferredDateInput || !slotStatus) return;

    const date = preferredDateInput.value;
    if (!date) {
      setSlotStates(slotButtons.map((button) => ({
        value: button.dataset.slotValue || '',
        label: button.dataset.slotValue || '',
        available: true,
        reason: '',
      })));
      slotStatus.textContent = 'তারিখ নির্বাচন করলে বুকড স্লটগুলো greyed out হবে। টাইমজোন: Asia/Dhaka.';
      return;
    }

    slotStatus.textContent = 'স্লট availability লোড হচ্ছে...';
    try {
      const response = await fetch(`/api/appointments/slots?date=${encodeURIComponent(date)}`);
      const payload = await response.json();
      if (!response.ok) {
        throw new Error(payload.message || 'স্লট লোড করা যায়নি।');
      }
      setSlotStates(payload.slots || []);
      const openCount = (payload.slots || []).filter((slot: any) => slot.available).length;
      slotStatus.textContent = `${openCount}টি স্লট ফাঁকা আছে। বুকড স্লটগুলো নির্বাচন করা যাবে না। টাইমজোন: ${payload.timezone || 'Asia/Dhaka'}.`;
    } catch (error) {
      slotStatus.textContent = error instanceof Error
        ? error.message
        : 'স্লট লোড করা যায়নি। WhatsApp-এ সময় নিশ্চিত করুন।';
    }
  };

  const validateStep = (step: string) => {
    const panels = stepPanels.filter((panel) => panel.dataset.bookingStep === step);
    for (const panel of panels) {
      const controls = Array.from(panel.querySelectorAll('input, select, textarea')) as Array<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>;
      for (const control of controls) {
        if (control.disabled || control.type === 'hidden') continue;
        if (!control.checkValidity()) {
          control.reportValidity();
          return false;
        }
      }
    }
    return true;
  };

  const showStep = (index: number) => {
    currentStepIndex = Math.max(0, Math.min(index, stepOrder.length - 1));
    const currentStep = getCurrentStep();

    stepPanels.forEach((panel) => {
      panel.hidden = panel.dataset.bookingStep !== currentStep;
    });

    stepPills.forEach((pill) => {
      const pillIndex = stepOrder.indexOf(pill.dataset.stepTarget || '');
      pill.classList.toggle('active', pill.dataset.stepTarget === currentStep);
      pill.classList.toggle('completed', pillIndex > -1 && pillIndex < currentStepIndex);
      pill.disabled = pillIndex > currentStepIndex;
    });

    if (prevStepBtn) prevStepBtn.disabled = currentStepIndex === 0;
    if (nextStepBtn) nextStepBtn.hidden = currentStepIndex === stepOrder.length - 1;
  };

  prevStepBtn?.addEventListener('click', () => {
    showStep(currentStepIndex - 1);
    form?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  nextStepBtn?.addEventListener('click', () => {
    if (!validateStep(getCurrentStep())) return;
    showStep(currentStepIndex + 1);
    form?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  stepPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      const targetIndex = stepOrder.indexOf(pill.dataset.stepTarget || '');
      if (targetIndex < 0 || targetIndex > currentStepIndex) return;
      showStep(targetIndex);
    });
  });

  preferredDateInput?.addEventListener('change', refreshSlotAvailability);
  preferredTimeSelect?.addEventListener('change', updateSlotSelection);
  slotButtons.forEach((button) => {
    button.addEventListener('click', () => {
      if (!preferredTimeSelect || button.disabled) return;
      preferredTimeSelect.value = button.dataset.slotValue || '';
      preferredTimeSelect.dispatchEvent(new Event('change', { bubbles: true }));
    });
  });

  const renderSubServices = () => {
    if (!(treatmentSelect instanceof HTMLSelectElement) || !subServicesWrap || !subServicesList) {
      return;
    }

    const selected = treatmentCatalog.find((item: TreatmentCatalogItem) => item.value === treatmentSelect.value);

    if (!selected) {
      subServicesWrap.hidden = true;
      subServicesList.innerHTML = '';
      return;
    }

    subServicesWrap.hidden = false;
    subServicesList.innerHTML = selected.options
      .map(
        (option: string) => `
          <label class="checkbox-card">
            <input type="checkbox" name="subServices" value="${escapeHtml(option)}" />
            <span>${escapeHtml(option)}</span>
          </label>
        `
      )
      .join('');
  };

  const togglePreviousTreatmentDetails = () => {
    if (!previousTreatmentDetailsWrap || !(previousTreatmentDetails instanceof HTMLTextAreaElement)) {
      return;
    }

    const selected = document.querySelector('input[name="previousTreatment"]:checked');
    const shouldShow = selected instanceof HTMLInputElement && selected.value === 'হ্যাঁ';

    previousTreatmentDetailsWrap.hidden = !shouldShow;
    previousTreatmentDetails.required = shouldShow;

    if (!shouldShow) {
      previousTreatmentDetails.value = '';
    }
  };

  renderSubServices();
  togglePreviousTreatmentDetails();
  showStep(0);
  refreshSlotAvailability();

  treatmentSelect?.addEventListener('change', renderSubServices);
  document.querySelectorAll('input[name="previousTreatment"]').forEach((input) => {
    input.addEventListener('change', togglePreviousTreatmentDetails);
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (!(form instanceof HTMLFormElement) || !submitStatus) {
      return;
    }

    const formData = new FormData(form);
    const treatmentKey = String(formData.get('treatmentType') || '');
    const selectedTreatment = treatmentCatalog.find((item: TreatmentCatalogItem) => item.value === treatmentKey);

    try {
      submitStatus.textContent = 'বুকিং তথ্য ডাটাবেজে সংরক্ষণ করা হচ্ছে...';
      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = true;
      }

      const values = serializeAppointmentPayload({
        fullName: String(formData.get('fullName') || ''),
        nid: String(formData.get('nid') || ''),
        age: String(formData.get('age') || ''),
        weight: String(formData.get('weight') || ''),
        gender: String(formData.get('gender') || ''),
        religion: String(formData.get('religion') || ''),
        duration: String(formData.get('duration') || ''),
        previousTreatment: String(formData.get('previousTreatment') || ''),
        previousTreatmentDetails: String(formData.get('previousTreatmentDetails') || ''),
        serviceMode: String(formData.get('serviceMode') || ''),
        sessionFormat: String(formData.get('sessionFormat') || ''),
        treatmentTypeKey: treatmentKey,
        treatmentTypeLabel: selectedTreatment?.label || treatmentKey,
        subServices: formData.getAll('subServices').map((item) => String(item)),
        preferredDate: String(formData.get('preferredDate') || ''),
        preferredTime: String(formData.get('preferredTime') || ''),
        address: String(formData.get('address') || ''),
        phone: String(formData.get('phone') || ''),
        whatsapp: String(formData.get('whatsapp') || ''),
        problem: String(formData.get('problem') || ''),
        paymentMethod: String(formData.get('paymentMethod') || ''),
        transactionId: String(formData.get('transactionId') || ''),
        paymentTimestamp: String(formData.get('paymentTimestamp') || ''),
        eventId: createEventId(),
      });

      const response = await fetch('/api/appointments', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(values),
      });

      const rawResult = await response
        .json()
        .catch(() => ({} as AppointmentApiResponse));
      const result = rawResult as AppointmentApiResponse;
      if (!response.ok) {
        throw new Error(result.message || 'বুকিং তথ্য সংরক্ষণ করা যায়নি।');
      }

      const appointmentId = result.appointmentId || 'N/A';
      const eventId = result.eventId || values.eventId;

      const message = buildAppointmentWhatsappMessage({
        ...values,
        treatmentType: values.treatmentTypeLabel,
        appointmentId,
      });
      const whatsappUrl = getWhatsappUrl(message);

      submitStatus.textContent = `তথ্য সংরক্ষণ হয়েছে। বুকিং আইডি: ${appointmentId}. এখন WhatsApp-এ পাঠানোর জন্য নতুন ট্যাব খোলা হচ্ছে...`;
      confirmationGuidelines?.removeAttribute('hidden');
      confirmationGuidelines?.scrollIntoView({ behavior: 'smooth', block: 'start' });

      const opened = window.open(whatsappUrl, '_blank', 'noopener,noreferrer');
      if (!opened) {
        submitStatus.textContent = 'ডাটাবেজে সেভ হয়েছে, কিন্তু WhatsApp ট্যাব খুলতে বাধা পেয়েছে। অনুগ্রহ করে pop-up allow করে আবার চেষ্টা করুন।';
      }

      if (window.gtag) {
        window.gtag('event', 'generate_lead', {
          event_category: 'appointment_booking',
          currency: 'BDT',
          value: 500,
        });
      }
      if (window.fbq) {
        window.fbq('track', 'Lead', { content_category: 'ruqyah_booking' }, { eventID: eventId });
      }
    } catch (error) {
      const message = error instanceof Error ? error.message : 'বুকিং তথ্য সংরক্ষণ করা যায়নি। অনুগ্রহ করে আবার চেষ্টা করুন।';
      submitStatus.textContent = message;
    } finally {
      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = false;
      }
    }
  });
</script>

