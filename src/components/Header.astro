---
import { getPageLocale, localeAlternates } from '../lib/i18n.js';

const pageLocale = getPageLocale(Astro.url.pathname);
const alternates = localeAlternates(Astro.url.pathname);
const publicPageUrl = new URL(
  `${Astro.url.pathname}${Astro.url.search}`,
  Astro.site?.origin || 'https://ruqyahhealing.com',
).href;
const encodedPublicPageUrl = encodeURIComponent(publicPageUrl);

const translationOptions = [
  { code: 'bn', shortLabel: 'BN', label: 'বাংলা', href: alternates.bn, external: false },
  { code: 'en', shortLabel: 'EN', label: 'English', href: alternates.en, external: false },
  {
    code: 'ur',
    shortLabel: 'UR',
    label: 'اردو',
    href: `https://translate.google.com/translate?sl=auto&tl=ur&u=${encodedPublicPageUrl}`,
    external: true,
    dir: 'rtl',
  },
  {
    code: 'ar',
    shortLabel: 'AR',
    label: 'العربية',
    href: `https://translate.google.com/translate?sl=auto&tl=ar&u=${encodedPublicPageUrl}`,
    external: true,
    dir: 'rtl',
  },
];

// Grouped navigation structure
const navGroups = pageLocale === 'en'
  ? [
      { label: 'Appointment', href: '/en/appointment', highlight: true },
      { label: 'Home', href: '/en/' },
      { label: 'Conditions', href: '/conditions' },
      {
        label: 'Ruqyah',
        children: [
          { label: 'Ruqyah Diagnosis', href: '/en/ruqyah-diagnosis' },
          { label: 'Symptom Diagnosis', href: '/en/symptom-diagnosis' },
          { label: 'Self Ruqyah', href: '/en/self-ruqyah' },
          { label: 'For Whom', href: '/en/for' },
          { label: 'Our Locations', href: '/en/location' },
        ],
      },
      { label: 'Glossary', href: '/en/glossary' },
      { label: 'Supplements', href: '/en/supplements' },
      {
        label: 'Resources',
        children: [
          { label: 'Blog', href: '/en/blog' },
          { label: 'PDF', href: '/en/pdf' },
        ],
      },
      { label: 'Courses', href: '/en/courses' },
      { label: 'My Courses', href: '/my-courses' },
      {
        label: 'About',
        children: [
          { label: 'Our Team', href: '/en/team' },
          { label: 'Notices', href: '/en/notices' },
        ],
      },
      { label: 'Profile', href: '/en/profile' },
    ]
  : [
      { label: 'অ্যাপয়েন্টমেন্ট', href: '/appointment', highlight: true },
      { label: 'হোম', href: '/' },
      { label: 'সমস্যা ও লক্ষণ', href: '/conditions' },
      {
        label: 'রুকইয়াহ',
        children: [
          { label: 'রুকইয়াহ ডায়াগনোসিস', href: '/ruqyah-diagnosis' },
          { label: 'সিমটম ডায়াগনোসিস', href: '/symptom-diagnosis' },
          { label: 'সেলফ রুকইয়াহ', href: '/self-ruqyah' },
          { label: 'কার জন্য', href: '/for' },
          { label: 'আমাদের এলাকাসমূহ', href: '/location' },
        ],
      },
      { label: 'শব্দকোষ', href: '/glossary' },
      { label: 'রুকইয়াহ সাপ্লিমেন্ট', href: '/supplements' },
      {
        label: 'রিসোর্স',
        children: [
          { label: 'রুকইয়াহ ব্লগ', href: '/blog' },
          { label: 'পিডিএফ', href: '/pdf' },
        ],
      },
      { label: 'কোর্স', href: '/courses' },
      { label: 'আমার কোর্স', href: '/my-courses' },
      {
        label: 'অ্যাবাউট',
        children: [
          { label: 'রাকী পরিচয়', href: '/team' },
          { label: 'নোটিশ', href: '/notices' },
        ],
      },
      { label: 'প্রোফাইল', href: '/profile' },
    ];
---

<header class="site-header" transition:persist>
  <div class="container header-inner">
    <a href={pageLocale === 'en' ? '/en/' : '/'} class="logo">
      <div class="logo-icon" style="background: transparent;">
        <img src="/images/ruqyah-logo.png" alt="Ruqyah Healing Logo" style="width: 100%; height: 100%; object-fit: contain;" />
      </div>
      <div class="logo-text">
        <span class="logo-name">Ruqyah</span>
        <span class="logo-sub">Healing</span>
      </div>
    </a>

    <nav class="main-nav" id="main-nav" aria-label="প্রধান নেভিগেশন">
      {navGroups.map(item => (
        item.children ? (
          <div class="nav-dropdown" data-dropdown>
            <button
              type="button"
              class="nav-link nav-dropdown-toggle"
              data-nav-label={item.label}
              aria-haspopup="true"
              aria-expanded="false"
            >
              {item.label}
              <svg class="dropdown-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div class="dropdown-menu" role="menu">
              <div class="dropdown-inner">
                {item.children.map(child => (
                  <a
                    href={child.href}
                    class="dropdown-link"
                    data-nav-href={child.href}
                    role="menuitem"
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            class:list={[
              'nav-link',
              item.highlight && 'nav-highlight',
            ]}
            data-nav-href={item.href}
            data-nav-highlight={item.highlight ? 'true' : undefined}
          >
            {item.label}
          </a>
        )
      ))}
    </nav>

    <details class="translate-switcher" data-translate-switcher>
      <summary class="translate-toggle" aria-label="Translate this page">
        <span aria-hidden="true">🌐</span>
        <span class="translate-toggle-text">Translate</span>
        <svg class="translate-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
      </summary>
      <div class="translate-menu" role="menu" aria-label="Choose language">
        {translationOptions.map(option => (
          <a
            href={option.href}
            class:list={[
              'translate-option',
              option.code === pageLocale && 'active',
            ]}
            role="menuitem"
            dir={option.dir}
            target={option.external ? '_blank' : undefined}
            rel={option.external ? 'noopener noreferrer' : undefined}
            data-translate-option={option.code}
          >
            <span class="translate-code">{option.shortLabel}</span>
            <span class="translate-label">{option.label}</span>
          </a>
        ))}
      </div>
    </details>

    <button
      class="menu-toggle"
      id="menu-toggle"
      aria-label="মেনু খুলুন"
      aria-expanded="false"
      aria-controls="main-nav"
    >
      <span class="bar bar-1"></span>
      <span class="bar bar-2"></span>
      <span class="bar bar-3"></span>
    </button>
  </div>
</header>

<!-- Dark overlay for mobile menu -->
<div class="nav-overlay" id="nav-overlay" aria-hidden="true"></div>

<style>
.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: #fff;
  border-bottom: 1px solid var(--border);
  height: var(--nav-height);
  display: flex;
  align-items: center;
}

.header-inner {
  display: flex;
  align-items: center;
  gap: 24px;
  height: 100%;
}

/* Logo */
.logo {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
  min-height: 44px;
}
.logo-icon {
  width: 40px;
  height: 40px;
  background: var(--primary);
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.logo-text {
  display: flex;
  flex-direction: column;
  line-height: 1.2;
}
.logo-name {
  font-size: 16px;
  font-weight: 700;
  color: var(--text-dark);
}
.logo-sub {
  font-size: 13px;
  color: var(--text-muted);
}

/* Nav */
.main-nav {
  display: flex;
  align-items: center;
  gap: 4px;
  flex: 1;
}
/* Note: removed overflow-x: auto so dropdown menus aren't clipped */

.nav-link {
  white-space: nowrap;
  font-size: 14px;
  font-weight: 500;
  color: var(--text-medium);
  padding: 7px 12px;
  border-radius: var(--radius-xl);
  transition: all 0.2s;
  min-height: 44px;
  display: flex;
  align-items: center;
  gap: 4px;
  background: none;
  border: none;
  font-family: inherit;
  cursor: pointer;
}
.nav-link:hover { color: var(--primary); background: var(--primary-light); }
.nav-active { color: var(--primary); background: var(--primary-light); }
.nav-highlight {
  background: var(--primary);
  color: #fff !important;
  font-weight: 600;
}
.nav-highlight:hover { background: var(--primary-dark); }

/* Dropdown */
.nav-dropdown {
  position: relative;
}
.nav-dropdown-toggle {
  display: flex;
  align-items: center;
  gap: 4px;
}
.dropdown-chevron {
  transition: transform 0.2s ease;
  flex-shrink: 0;
}
.nav-dropdown:hover .dropdown-chevron,
.nav-dropdown.is-open .dropdown-chevron {
  transform: rotate(180deg);
}

.dropdown-menu {
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translateX(-50%) translateY(-4px);
  min-width: 220px;
  background: transparent;
  border: none;
  border-radius: 0;
  padding: 10px 0 0 0;
  box-shadow: none;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
  z-index: 101;
}
.nav-dropdown:hover .dropdown-menu,
.nav-dropdown.is-open .dropdown-menu {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transform: translateX(-50%) translateY(0);
}

/* Inner card for the actual dropdown content */
.dropdown-inner {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 8px;
  box-shadow: 0 12px 32px rgba(0,0,0,0.12);
  position: relative;
}

/* Little arrow on dropdown */
.dropdown-inner::before {
  content: '';
  position: absolute;
  top: -6px;
  left: 50%;
  transform: translateX(-50%);
  width: 12px;
  height: 12px;
  background: #fff;
  border-left: 1px solid var(--border);
  border-top: 1px solid var(--border);
  transform: translateX(-50%) rotate(45deg);
}

.dropdown-link {
  display: block;
  padding: 8px 14px;
  border-radius: 8px;
  font-size: 14px;
  font-weight: 500;
  color: var(--text-medium);
  text-decoration: none;
  white-space: nowrap;
  transition: all 0.15s;
}
.dropdown-link:hover {
  background: var(--primary-light);
  color: var(--primary);
}
.dropdown-link.nav-active {
  background: var(--primary-light);
  color: var(--primary);
  font-weight: 600;
}

/* Translate switcher */
.translate-switcher {
  position: relative;
  flex-shrink: 0;
}
.translate-switcher[open] .translate-chevron {
  transform: rotate(180deg);
}
.translate-toggle {
  min-height: 40px;
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 8px 12px;
  border: 1px solid var(--border);
  border-radius: 999px;
  background: #f8fafc;
  color: var(--text-dark);
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  list-style: none;
  user-select: none;
  transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
}
.translate-toggle::-webkit-details-marker {
  display: none;
}
.translate-toggle:hover,
.translate-switcher[open] .translate-toggle {
  background: var(--primary-light);
  border-color: rgba(16, 185, 129, 0.35);
  color: var(--primary-dark);
}
.translate-chevron {
  transition: transform 0.2s ease;
  flex-shrink: 0;
}
.translate-menu {
  position: absolute;
  top: calc(100% + 10px);
  right: 0;
  min-width: 190px;
  padding: 8px;
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 14px;
  box-shadow: 0 16px 38px rgba(15, 23, 42, 0.16);
  z-index: 102;
}
.translate-menu::before {
  content: '';
  position: absolute;
  top: -6px;
  right: 22px;
  width: 12px;
  height: 12px;
  background: #fff;
  border-left: 1px solid var(--border);
  border-top: 1px solid var(--border);
  transform: rotate(45deg);
}
.translate-option {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 9px 10px;
  border-radius: 10px;
  color: var(--text-medium);
  font-size: 14px;
  font-weight: 600;
  text-decoration: none;
  transition: background 0.15s ease, color 0.15s ease;
}
.translate-option:hover,
.translate-option.active {
  background: var(--primary-light);
  color: var(--primary-dark);
}
.translate-code {
  min-width: 34px;
  padding: 3px 7px;
  border-radius: 999px;
  background: #eef2f7;
  color: var(--text-dark);
  font-size: 11px;
  font-weight: 800;
  text-align: center;
  letter-spacing: 0.04em;
}
.translate-option.active .translate-code,
.translate-option:hover .translate-code {
  background: #d1fae5;
  color: var(--primary-dark);
}
.translate-label {
  flex: 1;
}

/* Hamburger button */
.menu-toggle {
  display: none;
  flex-direction: column;
  justify-content: center;
  gap: 5px;
  width: 44px;
  height: 44px;
  padding: 10px;
  flex-shrink: 0;
  border-radius: var(--radius-sm);
  transition: background 0.2s;
}
.menu-toggle:hover { background: var(--primary-light); }

.bar {
  width: 22px;
  height: 2px;
  background: var(--text-dark);
  border-radius: 2px;
  transition: all 0.25s ease;
  display: block;
  transform-origin: center;
}

/* Hamburger → X animation */
.menu-toggle.is-open .bar-1 {
  transform: translateY(7px) rotate(45deg);
}
.menu-toggle.is-open .bar-2 {
  opacity: 0;
  transform: scaleX(0);
}
.menu-toggle.is-open .bar-3 {
  transform: translateY(-7px) rotate(-45deg);
}

/* Overlay */
.nav-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.35);
  z-index: 99;
  backdrop-filter: blur(2px);
  -webkit-backdrop-filter: blur(2px);
}
.nav-overlay.active { display: block; }

/* ── Mobile ── */
@media (max-width: 768px) {
  .menu-toggle { display: flex; }

  .header-inner {
    gap: 10px;
  }
  .translate-toggle {
    min-height: 38px;
    padding: 8px 10px;
    font-size: 12px;
  }
  .translate-toggle-text {
    display: none;
  }
  .translate-menu {
    right: -48px;
    min-width: 178px;
  }
  .translate-menu::before {
    right: 70px;
  }

  .main-nav {
    display: none;
    position: fixed;
    top: var(--nav-height);
    left: 0;
    right: 0;
    background: #fff;
    flex-direction: column;
    align-items: stretch;
    padding: 12px 16px 24px;
    border-bottom: 1px solid var(--border);
    box-shadow: var(--shadow-md);
    overflow-x: visible;
    overflow-y: auto;
    max-height: calc(100dvh - var(--nav-height) - 64px);
    z-index: 100;
    transform: translateY(-8px);
    opacity: 0;
    transition: transform 0.25s ease, opacity 0.25s ease;
    gap: 0;
  }

  .main-nav.open {
    display: flex;
    transform: translateY(0);
    opacity: 1;
  }

  .nav-link {
    width: 100%;
    padding: 12px 16px;
    font-size: 15px;
    border-radius: var(--radius-md);
    justify-content: space-between;
  }

  .nav-highlight {
    margin-top: 8px;
    justify-content: center;
    border-radius: var(--radius-xl);
  }

  /* Mobile dropdown */
  .nav-dropdown {
    width: 100%;
  }
  .dropdown-menu {
    position: static;
    transform: none;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    padding: 0 0 0 12px;
    min-width: auto;
    display: none;
    background: transparent;
    margin-top: 4px;
  }
  .dropdown-inner {
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 0;
    box-shadow: none;
  }
  .dropdown-inner::before { display: none; }
  .nav-dropdown.is-open .dropdown-menu {
    display: block;
    transform: none;
    opacity: 1;
    visibility: visible;
  }
  .dropdown-link {
    padding: 10px 14px;
    font-size: 14px;
    color: var(--text-medium);
    display: block;
  }
}
</style>

<script>
const toggle  = document.getElementById('menu-toggle') as HTMLButtonElement | null;
const nav     = document.getElementById('main-nav');
const overlay = document.getElementById('nav-overlay');
const translateSwitcher = document.querySelector('[data-translate-switcher]') as HTMLDetailsElement | null;

function updateHeaderActive() {
  const path = window.location.pathname;
  document.querySelectorAll<HTMLAnchorElement>('[data-nav-href]').forEach(link => {
    const href = link.dataset.navHref ?? '';
    const active = href === '/' ? path === '/' : path.startsWith(href);
    link.classList.toggle('nav-active', active);
    link.setAttribute('aria-current', active ? 'page' : '');
    if (!active) link.removeAttribute('aria-current');
  });
}

function openMenu() {
  nav?.classList.add('open');
  toggle?.classList.add('is-open');
  overlay?.classList.add('active');
  toggle?.setAttribute('aria-expanded', 'true');
  toggle?.setAttribute('aria-label', 'মেনু বন্ধ করুন');
  document.body.style.overflow = 'hidden';
}

function closeMenu() {
  nav?.classList.remove('open');
  toggle?.classList.remove('is-open');
  overlay?.classList.remove('active');
  toggle?.setAttribute('aria-expanded', 'false');
  toggle?.setAttribute('aria-label', 'মেনু খুলুন');
  document.body.style.overflow = '';
  // Close all dropdowns
  document.querySelectorAll('[data-dropdown]').forEach(d => d.classList.remove('is-open'));
}

function closeTranslateSwitcher() {
  if (translateSwitcher) translateSwitcher.open = false;
}

toggle?.addEventListener('click', () => {
  const isOpen = nav?.classList.contains('open');
  closeTranslateSwitcher();
  isOpen ? closeMenu() : openMenu();
});

translateSwitcher?.addEventListener('click', (event) => {
  event.stopPropagation();
});

document.addEventListener('click', closeTranslateSwitcher);

document.querySelectorAll('[data-translate-option]').forEach(link => {
  link.addEventListener('click', closeTranslateSwitcher);
});

// Close on overlay click
overlay?.addEventListener('click', () => {
  closeTranslateSwitcher();
  closeMenu();
});

// Close on nav link click (mobile)
nav?.querySelectorAll('.nav-link:not(.nav-dropdown-toggle), .dropdown-link').forEach(link => {
  link.addEventListener('click', closeMenu);
});

// Close on Escape key
document.addEventListener('keydown', (e) => {
  if (e.key !== 'Escape') return;
  closeTranslateSwitcher();
  if (nav?.classList.contains('open')) closeMenu();
});

// Mobile dropdown toggle
document.querySelectorAll('[data-dropdown]').forEach(dropdown => {
  const toggleBtn = dropdown.querySelector('.nav-dropdown-toggle');
  toggleBtn?.addEventListener('click', (e) => {
    // Stop propagation so hamburger menu doesn't close
    e.stopPropagation();

    // Only on mobile (when dropdown-menu is hidden by CSS)
    const menu = dropdown.querySelector('.dropdown-menu') as HTMLElement;
    if (menu && getComputedStyle(menu).display === 'none') {
      e.preventDefault();
      const isOpen = dropdown.classList.contains('is-open');
      // Close others
      document.querySelectorAll('[data-dropdown]').forEach(d => {
        if (d !== dropdown) d.classList.remove('is-open');
      });
      dropdown.classList.toggle('is-open', !isOpen);
      toggleBtn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
    } else {
      // Dropdown already open - just close it (don't navigate)
      e.preventDefault();
      dropdown.classList.remove('is-open');
      toggleBtn.setAttribute('aria-expanded', 'false');
    }
  });
});

// Also stop propagation on dropdown inner links (mobile)
document.querySelectorAll('.dropdown-link').forEach(link => {
  link.addEventListener('click', (e) => {
    e.stopPropagation();
  });
});

// Update active link on load and after every View Transition
updateHeaderActive();
document.addEventListener('astro:page-load', updateHeaderActive);
</script>
