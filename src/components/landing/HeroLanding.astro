<!-- Three.js CDN — is:inline so Astro doesn't bundle it -->
<script is:inline>
(function () {
  'use strict';

  // Cache Three.js module globally to avoid re-importing on each navigation
  // window.__THREE__ is set after first successful import
  function initThree(THREE) {
    const canvas = document.getElementById('hero-landing-canvas');
    if (!canvas) return;

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    if (typeof window.__heroThreeCleanup === 'function') {
      window.__heroThreeCleanup();
    }

    const { Scene, PerspectiveCamera, WebGLRenderer, BufferGeometry, BufferAttribute, PointsMaterial, Points, AdditiveBlending } = THREE;

    const section = canvas.closest('.hero');
    if (!section) return;
    const W = section.offsetWidth;
    const H = section.offsetHeight;
    if (!W || !H) return;

    const renderer = new WebGLRenderer({ canvas, alpha: true, antialias: false });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
    renderer.setSize(W, H);

    const scene = new Scene();
    const camera = new PerspectiveCamera(60, W / H, 0.1, 100);
    camera.position.z = 30;

    const COUNT = window.innerWidth < 768 ? 60 : 140;
    const positions = new Float32Array(COUNT * 3);
    const sizes = new Float32Array(COUNT);
    for (let i = 0; i < COUNT; i++) {
      positions[i * 3]     = (Math.random() - 0.5) * 60;
      positions[i * 3 + 1] = (Math.random() - 0.5) * 35;
      positions[i * 3 + 2] = (Math.random() - 0.5) * 20;
      sizes[i] = Math.random() * 2.5 + 0.8;
    }

    const geo = new BufferGeometry();
    geo.setAttribute('position', new BufferAttribute(positions, 3));
    geo.setAttribute('size', new BufferAttribute(sizes, 1));

    const mat = new PointsMaterial({
      color: 0x6ee7b7,
      size: 0.35,
      transparent: true,
      opacity: 0.55,
      blending: AdditiveBlending,
      depthWrite: false,
      sizeAttenuation: true,
    });

    const points = new Points(geo, mat);
    scene.add(points);

    let frame;
    let disposed = false;
    let elapsed = 0;
    function animate() {
      if (disposed) return;
      frame = requestAnimationFrame(animate);
      elapsed += 0.004;
      points.rotation.y = elapsed * 0.15;
      points.rotation.x = Math.sin(elapsed * 0.08) * 0.06;
      renderer.render(scene, camera);
    }
    animate();

    const ro = new ResizeObserver(() => {
      const nw = section.offsetWidth;
      const nh = section.offsetHeight;
      if (!nw || !nh || disposed) return;
      camera.aspect = nw / nh;
      camera.updateProjectionMatrix();
      renderer.setSize(nw, nh);
    });
    ro.observe(section);

    window.__heroThreeCleanup = function cleanupHeroThree() {
      disposed = true;
      cancelAnimationFrame(frame);
      ro.disconnect();
      geo.dispose();
      mat.dispose();
      renderer.dispose();
      if (window.__heroThreeCleanup === cleanupHeroThree) {
        window.__heroThreeCleanup = null;
      }
    };

    // Cleanup before next page swap
    document.addEventListener('astro:before-swap', () => {
      if (typeof window.__heroThreeCleanup === 'function') {
        window.__heroThreeCleanup();
      }
    }, { once: true });
  }

  function tryInit() {
    if (window.__THREE__) {
      // Module already loaded — just re-init
      initThree(window.__THREE__);
    } else {
      import('https://cdn.jsdelivr.net/npm/three@0.162.0/build/three.module.min.js')
        .then((THREE) => {
          window.__THREE__ = THREE; // Cache for future navigations
          initThree(THREE);
        })
        .catch(() => {}); // Silent fail
    }
  }

  // Run immediately on first load
  tryInit();
  // Re-run after every View Transition navigation to homepage
  if (!window.__heroThreePageLoadBound) {
    window.__heroThreePageLoadBound = true;
    document.addEventListener('astro:page-load', tryInit);
  }
})();
</script>

<!-- Typewriter effect for hero subtitle -->
<script>
(function () {
  'use strict';

  function initTypewriter() {
    const el = document.querySelector('[data-typewriter]');
    if (!el) return;

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const typingSpeed = prefersReduced ? 0 : 80;
    const deletingSpeed = prefersReduced ? 0 : 40;
    const pauseDuration = prefersReduced ? 0 : 2000;

    let raw = el.dataset.typewriter || '';
    let texts = [];
    try {
      texts = JSON.parse(raw);
    } catch {
      texts = [raw];
    }
    if (!texts.length) texts = [raw];
    if (!el) return;

    let textIndex = 0;
    let isDeleting = false;
    let isPaused = false;

    function type() {
      if (isPaused) return;

      const text = texts[textIndex];

      if (!isDeleting) {
        const currentLength = el.textContent.length;
        if (currentLength < text.length) {
          el.textContent = text.slice(0, currentLength + 1);
          setTimeout(type, typingSpeed);
        } else {
          isPaused = true;
          setTimeout(() => {
            isPaused = false;
            isDeleting = true;
            type();
          }, pauseDuration);
        }
      } else {
        const currentLength = el.textContent.length;
        if (currentLength > 0) {
          el.textContent = text.slice(0, currentLength - 1);
          setTimeout(type, deletingSpeed);
        } else {
          isDeleting = false;
          textIndex = (textIndex + 1) % texts.length;
          setTimeout(type, 500);
        }
      }
    }

    type();
  }

  initTypewriter();
  document.addEventListener('astro:page-load', initTypewriter);
})();
</script>

<!-- Stats counter animation -->
<script>
function animateCounter(el, target, suffix, duration = 1400) {
  const start = performance.now();
  function step(now) {
    const progress = Math.min((now - start) / duration, 1);
    const eased = 1 - Math.pow(1 - progress, 3);
    el.textContent = Math.floor(eased * target) + suffix;
    if (progress < 1) requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
}

function initCounters() {
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (prefersReduced) return;

  const counters = document.querySelectorAll('[data-count]');
  if (!counters.length) return;

  const obs = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (!entry.isIntersecting) return;
      const el = entry.target as HTMLElement;
      const target = parseInt(el.dataset.count ?? '0', 10);
      const suffix = el.dataset.suffix ?? '';
      animateCounter(el, target, suffix);
      obs.unobserve(el);
    });
  }, { threshold: 0.6 });

  counters.forEach(el => obs.observe(el));
}

initCounters();
document.addEventListener('astro:page-load', initCounters);
</script>

<style>
.hero {
  position: relative;
  min-height: 560px;
  display: flex;
  align-items: center;
  background:
    linear-gradient(135deg, rgba(5,150,105,0.88) 0%, rgba(6,95,70,0.92) 50%, rgba(4,120,87,0.88) 100%),
    url('/images/hero-bg.webp') center center / cover no-repeat;
  overflow: hidden;
}

#hero-landing-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 0;
}

.hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    repeating-linear-gradient(45deg, rgba(255,255,255,0.04) 0px, rgba(255,255,255,0.04) 1px, transparent 1px, transparent 48px),
    repeating-linear-gradient(-45deg, rgba(255,255,255,0.04) 0px, rgba(255,255,255,0.04) 1px, transparent 1px, transparent 48px);
  pointer-events: none;
  z-index: 1;
}

.hero-orb {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  animation: float 6s ease-in-out infinite;
  z-index: 1;
}
.hero-orb--1 {
  width: 380px;
  height: 380px;
  top: -120px;
  right: -80px;
  background: radial-gradient(circle, rgba(16,185,129,0.35) 0%, transparent 70%);
  animation-delay: 0s;
}
.hero-orb--2 {
  width: 260px;
  height: 260px;
  bottom: -80px;
  left: 10%;
  background: radial-gradient(circle, rgba(52,211,153,0.25) 0%, transparent 70%);
  animation-delay: 3s;
}

@keyframes float {
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-20px); }
}

.hero-content {
  position: relative;
  z-index: 2;
  text-align: center;
  padding-top: 80px;
  padding-bottom: 80px;
  color: #fff;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: rgba(255,255,255,0.15);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(255,255,255,0.25);
  color: rgba(255,255,255,0.95);
  font-size: 13px;
  font-weight: 600;
  padding: 6px 16px;
  border-radius: 20px;
  margin-bottom: 22px;
  letter-spacing: 0.3px;
}

.hero-title {
  font-family: 'Lora', 'Hind Siliguri', serif;
  font-size: clamp(30px, 5.5vw, 52px);
  font-weight: 700;
  margin-bottom: 14px;
  letter-spacing: -0.5px;
  line-height: 1.15;
}

.hero-subtitle {
  font-size: clamp(20px, 4vw, 32px);
  font-weight: 600;
  margin-bottom: 14px;
  color: rgba(255,255,255,0.92);
  min-height: 1.5em;
}

.hero-desc {
  font-size: 16px;
  color: rgba(255,255,255,0.78);
  max-width: 580px;
  margin: 0 auto 36px;
  line-height: 1.75;
}

.hero-actions {
  display: flex;
  gap: 14px;
  justify-content: center;
  flex-wrap: wrap;
  margin-bottom: 48px;
}

.btn-hero-primary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 13px 28px;
  border-radius: 24px;
  font-size: 15px;
  font-weight: 700;
  cursor: pointer;
  background: #fff;
  color: #059669;
  border: 2px solid #fff;
  transition: all 0.2s ease;
  font-family: inherit;
  min-height: 44px;
}
.btn-hero-primary:hover {
  background: rgba(255,255,255,0.92);
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(0,0,0,0.2);
}

.btn-whatsapp-hero {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 13px 22px;
  border-radius: 24px;
  font-size: 15px;
  font-weight: 700;
  background: #25D366;
  color: #fff;
  border: 2px solid #25D366;
  transition: all 0.2s ease;
  font-family: inherit;
  min-height: 44px;
  text-decoration: none;
}
.btn-whatsapp-hero:hover {
  background: #1ebe5d;
  border-color: #1ebe5d;
  transform: translateY(-2px);
}

.btn-call-hero {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 13px 22px;
  border-radius: 24px;
  font-size: 15px;
  font-weight: 700;
  background: transparent;
  color: #fff;
  border: 2px solid rgba(255,255,255,0.6);
  transition: all 0.2s ease;
  font-family: inherit;
  min-height: 44px;
  text-decoration: none;
}
.btn-call-hero:hover {
  background: rgba(255,255,255,0.15);
  border-color: #fff;
  transform: translateY(-2px);
}

.hero-stats {
  display: inline-flex;
  align-items: center;
  gap: 32px;
  background: rgba(255,255,255,0.1);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 16px;
  padding: 16px 32px;
}
.hero-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
}
.hero-stat-num {
  font-size: 22px;
  font-weight: 700;
  color: #fff;
  line-height: 1;
  font-variant-numeric: tabular-nums;
  min-width: 3ch;
  display: inline-block;
}
.hero-stat-label {
  font-size: 12px;
  color: rgba(255,255,255,0.72);
  white-space: nowrap;
}
.hero-stat-divider {
  width: 1px;
  height: 36px;
  background: rgba(255,255,255,0.2);
}

@media (max-width: 768px) {
  .hero-stats { gap: 16px; padding: 12px 16px; }
  .hero-stat-num { font-size: 18px; }
  .hero-content { padding-top: 56px; padding-bottom: 56px; }
}

@media (max-width: 480px) {
  .hero { min-height: min(520px, 90svh); }
  .hero-actions {
    flex-direction: column;
    gap: 10px;
  }
  .hero-actions .btn,
  .hero-actions .btn-hero-primary,
  .hero-actions .btn-outline-white {
    width: 100%;
    justify-content: center;
  }
  .hero-stats {
    width: 100%;
    justify-content: space-around;
    gap: 8px;
    padding: 12px;
  }
  .hero-stat-divider { display: none; }
}

@media (prefers-reduced-motion: reduce) {
  .hero-orb { animation: none; }
}
</style>
