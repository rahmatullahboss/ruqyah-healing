<div class="sticky-cta" id="stickyCta" aria-label="ক্লিক করুন">
  <div class="sticky-slot-indicator" aria-live="polite">
    <span class="slot-dot"></span>
    <span class="slot-text">আজকের স্লট: ৩টি বাকি</span>
  </div>
  <div class="sticky-btn-row">
    <a href="#" class="sticky-whatsapp" id="stickyWhatsapp" data-gtm-event="landing_book_whatsapp">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="white">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
      WhatsApp বুকিং
    </a>
    <button type="button" class="sticky-form-btn" id="stickyFormBtn">
      ফর্মে বুক করুন
    </button>
  </div>
</div>

<style>
.sticky-cta {
  display: none;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 200;
  background: var(--primary);
  padding: 10px 16px 12px;
  gap: 6px;
  box-shadow: 0 -2px 12px rgba(0,0,0,0.15);
  flex-direction: column;
}

.sticky-slot-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
}

.slot-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #4ade80;
  animation: slotPulse 2s ease-in-out infinite;
  flex-shrink: 0;
}

@keyframes slotPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

.slot-text {
  font-size: 12px;
  font-weight: 600;
  color: rgba(255,255,255,0.95);
}

.sticky-btn-row {
  display: flex;
  gap: 10px;
}

.sticky-whatsapp {
  flex: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 12px 16px;
  background: #25D366;
  border-radius: 8px;
  color: #fff;
  font-weight: 700;
  font-size: 14px;
  text-decoration: none;
  transition: opacity 0.2s;
}

.sticky-whatsapp:hover {
  opacity: 0.9;
}

.sticky-form-btn {
  flex: 1;
  padding: 12px 16px;
  background: rgba(255,255,255,0.15);
  border: 1.5px solid rgba(255,255,255,0.5);
  border-radius: 8px;
  color: #fff;
  font-weight: 700;
  font-size: 14px;
  cursor: pointer;
  transition: background 0.2s;
  font-family: inherit;
}

.sticky-form-btn:hover {
  background: rgba(255,255,255,0.25);
}

@media (max-width: 768px) {
  .sticky-cta {
    display: flex;
  }
}
</style>

<script>
function initStickyCta() {
  const stickyCta = document.getElementById('stickyCta');
  const stickyFormBtn = document.getElementById('stickyFormBtn');
  const bookingSection = document.getElementById('booking-section');

  if (!stickyCta || !stickyFormBtn) return;

  // Scroll to form when "ফর্মে বুক করুন" is clicked
  stickyFormBtn.addEventListener('click', () => {
    bookingSection?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  // Build WhatsApp URL with UTM params
  const urlParams = new URLSearchParams(window.location.search);
  const utmSource = urlParams.get('utm_source') || '';
  const utmMedium = urlParams.get('utm_medium') || '';
  const utmCampaign = urlParams.get('utm_campaign') || '';

  const whatsappMsg = `আসসালামু আলাইকুম, আমি রুকইয়াহ সেবা বুক করতে চাই।${utmSource ? ` (Source: ${utmSource})` : ''}`;
  const whatsappNumber = '8801336202150';
  const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMsg)}`;

  const stickyWhatsapp = document.getElementById('stickyWhatsapp');
  if (stickyWhatsapp) {
    stickyWhatsapp.setAttribute('href', whatsappUrl);
    stickyWhatsapp.setAttribute('target', '_blank');
    stickyWhatsapp.setAttribute('rel', 'noopener noreferrer');
  }

  // Track click
  stickyWhatsapp?.addEventListener('click', async () => {
    // Track via API
    try {
      const eventId = `wa-${Date.now()}-${Math.random().toString(36).slice(2)}`;
      await fetch('/api/tracking/whatsapp-click', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          eventName: 'Contact',
          source: 'sticky_cta_whatsapp',
          campaign: utmCampaign,
          eventId,
        }),
      });
    } catch (e) {
      // Silent fail
    }

    if (window.gtag) {
      window.gtag('event', 'click_book_whatsapp', {
        event_category: 'landing',
        campaign: utmCampaign,
      });
    }
    if (window.fbq) {
      window.fbq('track', 'Book');
    }
  });
}

initStickyCta();
document.addEventListener('astro:page-load', initStickyCta);
</script>