---
import TestimonialCard from './TestimonialCard.astro';

interface Testimonial {
  id: string;
  name: string;
  image?: string | null;
  message: string;
  rating: number;
  role?: string | null;
}

interface Props {
  testimonials: Testimonial[];
}

const { testimonials } = Astro.props;
const display = testimonials.slice(0, 3);
---

<section class="testimonial-section">
  <div class="container">
    <div class="social-proof-bar">
      <div class="fb-badge">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="#1877F2">
          <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
        </svg>
        <span class="fb-followers">৬৫,০০০+ ফলোয়ার</span>
      </div>
      <div class="review-aggregate">
        <span class="stars">★★★★★</span>
        <span class="review-text">২৩০+ সন্তুষ্ট রোগী</span>
      </div>
    </div>
    <h2 class="section-title">আমাদের রোগীদের অভিজ্ঞতা</h2>
    <p class="section-sub">১৮০০+ রোগীর মধ্যে কিছু মতামত</p>
    <div class="testimonial-grid">
      {display.map((t) => (
        <TestimonialCard {...t} />
      ))}
    </div>
  </div>
</section>

<style>
.testimonial-section {
  padding: 64px 0;
  background: var(--bg-light);
}

.social-proof-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24px;
  margin-bottom: 32px;
  flex-wrap: wrap;
}

.fb-badge {
  display: flex;
  align-items: center;
  gap: 8px;
  background: #fff;
  border: 1.5px solid #e4e6eb;
  border-radius: 20px;
  padding: 8px 16px;
  font-size: 14px;
  font-weight: 600;
  color: var(--text-dark);
}

.fb-followers {
  color: var(--text-dark);
}

.review-aggregate {
  display: flex;
  align-items: center;
  gap: 8px;
  background: #fff;
  border: 1.5px solid #e4e6eb;
  border-radius: 20px;
  padding: 8px 16px;
}

.stars {
  color: #F5A623;
  font-size: 14px;
  letter-spacing: 1px;
}

.review-text {
  font-size: 14px;
  font-weight: 600;
  color: var(--text-dark);
}

.container {
  max-width: 960px;
  margin: 0 auto;
  padding: 0 20px;
}

.section-title {
  font-size: clamp(22px, 4vw, 32px);
  font-weight: 700;
  color: var(--text-dark);
  text-align: center;
  margin: 0 0 8px;
}

.section-sub {
  font-size: 16px;
  color: var(--text-muted);
  text-align: center;
  margin: 0 0 40px;
}

.testimonial-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

@media (max-width: 768px) {
  .testimonial-grid {
    grid-template-columns: 1fr;
    gap: 16px;
  }
}
</style>