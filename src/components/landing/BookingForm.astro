---
import { getWhatsappUrl } from '../../data/clinic.js';

interface Props {
  whatsappUrl?: string;
}

const { whatsappUrl: directWhatsappUrl } = Astro.props;

const defaultWhatsappUrl = getWhatsappUrl('আসসালামু আলাইকুম, আমি রুকইয়াহ সেবা বুক করতে চাই।');
---

<section class="booking-section" id="booking-section">
  <div class="container">
    <div class="booking-wrapper">
      <div class="booking-header">
        <h2>এখনই অ্যাপয়েন্টমেন্ট বুক করুন</h2>
        <p>ওয়াটসঅ্যাপে মেসেজ দিন অথবা ফর্ম পূরণ করুন</p>
      </div>

      <div class="booking-body">
        <!-- WhatsApp Primary CTA with pre-filled message preview -->
        <div class="whatsapp-cta-wrap">
          <a
            href={directWhatsappUrl || defaultWhatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="whatsapp-direct-btn"
            id="whatsappDirectBtn"
            data-gtm-event="landing_book_whatsapp_direct"
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="white">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            এখনই WhatsApp-এ মেসেজ করুন — ২ মিনিটে বুকিং
          </a>
          <div class="whatsapp-msg-preview" id="whatsappMsgPreview">
            <span class="preview-label">আপনার মেসেজ প্রিভিউ:</span>
            <p class="preview-text" id="waMsgPreview">আসসালামু আলাইকুম, আমি [আপনার নাম]। আমি রুকইয়াহ সেবা বুক করতে চাই।</p>
          </div>
          <p class="whatsapp-hint">সাধারণত ৩০ মিনিটের মধ্যে উত্তর পাবেন</p>
        </div>

        <div class="divider-text">
          <span>অথবা — ফর্ম পূরণ করুন</span>
        </div>

        <!-- Simplified Inline Form — 3 fields only -->
        <form id="landing-booking-form" class="landing-form" method="post" novalidate>
          <div class="form-row">
            <div class="form-group">
              <label for="fullName">পূর্ণ নাম *</label>
              <input type="text" id="fullName" name="fullName" required placeholder="আপনার পূর্ণ নাম" autocomplete="name" />
              <span class="field-error" id="fullNameError"></span>
            </div>
            <div class="form-group">
              <label for="phone">মোবাইল নাম্বার *</label>
              <input type="tel" id="phone" name="phone" required placeholder="01XXXXXXXXX" autocomplete="tel" />
              <span class="field-error" id="phoneError"></span>
            </div>
          </div>

          <div class="form-group">
            <label for="preferredDate">পছন্দের তারিখ *</label>
            <input type="date" id="preferredDate" name="preferredDate" required />
            <span class="field-error" id="preferredDateError"></span>
          </div>

          <div class="form-agreements">
            <p class="agreement-note">
              <strong>গুরুত্বপূর্ণ:</strong> মহিলা রোগীদের জন্য মাহরাম উপস্থিতি বাধ্যতামূলক। সেশনে তাওহীদের উপর পূর্ণ নির্ভরতা রাখা হয়।
            </p>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn-submit" id="submitBtn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
              </svg>
              ফর্ম সাবমিট করুন
            </button>
          </div>

          <div class="form-status" id="formStatus" role="alert" aria-live="polite"></div>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
.booking-section {
  padding: 64px 0 100px;
  background: var(--bg-white);
}

.container {
  max-width: 680px;
  margin: 0 auto;
  padding: 0 20px;
}

.booking-wrapper {
  background: var(--bg-white);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-lg);
  border: 1px solid var(--border);
  overflow: hidden;
}

.booking-header {
  background: var(--primary);
  color: #fff;
  padding: 28px 32px;
  text-align: center;
}

.booking-header h2 {
  font-size: clamp(20px, 4vw, 26px);
  font-weight: 700;
  margin: 0 0 8px;
  color: #fff;
}

.booking-header p {
  font-size: 14px;
  color: rgba(255,255,255,0.85);
  margin: 0;
}

.booking-body {
  padding: 32px;
  display: flex;
  flex-direction: column;
  gap: 0;
}

.landing-form {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.form-group label {
  font-size: 14px;
  font-weight: 600;
  color: var(--text-dark);
}

.form-group input,
.form-group select,
.form-group textarea {
  padding: 11px 14px;
  border: 1.5px solid var(--border);
  border-radius: var(--radius-md);
  font-size: 15px;
  font-family: inherit;
  color: var(--text-dark);
  background: var(--bg-white);
  transition: border-color 0.2s, box-shadow 0.2s;
  outline: none;
  width: 100%;
  box-sizing: border-box;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.12);
}

.form-group input::placeholder,
.form-group textarea::placeholder {
  color: var(--text-muted);
}

.form-group textarea {
  resize: vertical;
  min-height: 100px;
}

.field-error {
  font-size: 12px;
  color: #ef4444;
  min-height: 16px;
}

.form-agreements {
  background: var(--primary-light);
  border-radius: var(--radius-md);
  padding: 16px;
  border: 1px solid var(--border);
}

.agreement-note {
  font-size: 13px;
  color: var(--text-medium);
  margin: 0;
  line-height: 1.7;
}

.agreement-note strong {
  color: var(--primary-dark);
}

.form-actions {
  display: flex;
  gap: 12px;
}

.btn-submit {
  flex: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 14px 24px;
  background: var(--primary);
  color: #fff;
  border: none;
  border-radius: var(--radius-md);
  font-size: 15px;
  font-weight: 700;
  cursor: pointer;
  transition: background 0.2s, transform 0.15s;
  font-family: inherit;
}

.btn-submit:hover {
  background: var(--primary-dark);
  transform: translateY(-1px);
}

.btn-submit:disabled {
  opacity: 0.6;
  cursor: not-allowed;
  transform: none;
}

.form-status {
  font-size: 14px;
  text-align: center;
  padding: 10px;
  border-radius: var(--radius-sm);
  min-height: 40px;
}

.form-status.success {
  background: #dcfce7;
  color: #166534;
}

.form-status.error {
  background: #fee2e2;
  color: #991b1b;
}

.divider-text {
  display: flex;
  align-items: center;
  gap: 16px;
  margin: 20px 0;
  color: var(--text-muted);
  font-size: 13px;
}

.divider-text::before,
.divider-text::after {
  content: '';
  flex: 1;
  height: 1px;
  background: var(--border);
}

.whatsapp-cta-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
}

.whatsapp-direct-btn {
  width: 100%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 14px 24px;
  background: #25D366;
  color: #fff;
  border-radius: var(--radius-md);
  font-size: 15px;
  font-weight: 700;
  text-decoration: none;
  transition: background 0.2s, transform 0.15s;
}

.whatsapp-direct-btn:hover {
  background: #1ebe5d;
  transform: translateY(-1px);
}

.whatsapp-msg-preview {
  width: 100%;
  background: var(--bg-light);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 12px 16px;
  text-align: center;
}

.preview-label {
  display: block;
  font-size: 11px;
  font-weight: 600;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 6px;
}

.preview-text {
  font-size: 13px;
  color: var(--text-medium);
  margin: 0;
  line-height: 1.6;
  direction: ltr;
  text-align: center;
}

.whatsapp-hint {
  font-size: 12px;
  color: var(--text-muted);
  margin: 0;
}

@media (max-width: 600px) {
  .form-row { grid-template-columns: 1fr; }
  .booking-body { padding: 24px 20px; }
  .booking-header { padding: 20px; }
}
</style>

<script>
function initBookingForm() {
  const form = document.getElementById('landing-booking-form') as HTMLFormElement | null;
  if (!form) return;
  if (form.dataset.initialized === 'true') return;
  form.dataset.initialized = 'true';

  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement | null;
  const statusEl = document.getElementById('formStatus') as HTMLElement | null;
  const whatsappDirectBtn = document.getElementById('whatsappDirectBtn') as HTMLAnchorElement | null;
  const waMsgPreview = document.getElementById('waMsgPreview') as HTMLElement | null;

  function showError(fieldId: string, message: string) {
    const errEl = document.getElementById(`${fieldId}Error`);
    if (errEl) errEl.textContent = message;
  }

  function clearErrors() {
    document.querySelectorAll('.field-error').forEach(el => (el.textContent = ''));
  }

  function getUrlParam(key: string) {
    return new URLSearchParams(window.location.search).get(key) || '';
  }

  function createEventId() {
    if (window.crypto?.randomUUID) return `lead-${window.crypto.randomUUID()}`;
    return `lead-${Date.now()}-${Math.random().toString(36).slice(2)}`;
  }

  function normalizePhone(phone: string) {
    const digits = phone.replace(/[^\d]/g, '');
    if (digits.startsWith('8801') && digits.length === 13) return `0${digits.slice(3)}`;
    if (digits.startsWith('1') && digits.length === 10) return `0${digits}`;
    return digits;
  }

  function validate(values: { fullName: string; phone: string; preferredDate: string }) {
    clearErrors();
    let valid = true;
    if (!values.fullName.trim()) { showError('fullName', 'পূর্ণ নাম প্রয়োজন'); valid = false; }
    if (!values.phone.trim()) { showError('phone', 'মোবাইল নাম্বার প্রয়োজন'); valid = false; }
    else if (!/^01[3-9]\d{8}$/.test(normalizePhone(values.phone))) { showError('phone', 'সঠিক বাংলাদেশি মোবাইল নাম্বার দিন'); valid = false; }
    if (!values.preferredDate) { showError('preferredDate', 'তারিখ নির্বাচন করুন'); valid = false; }
    return valid;
  }

  function prefillFromUrl() {
    const params = new URLSearchParams(window.location.search);
    const fields = ['fullName', 'phone', 'preferredDate'];
    let usedFormParam = false;

    fields.forEach((field) => {
      const input = form.elements.namedItem(field) as HTMLInputElement | null;
      const value = params.get(field);
      if (input && value && !input.value) {
        input.value = field === 'phone' ? normalizePhone(value) : value;
        usedFormParam = true;
      }
    });

    if (usedFormParam) {
      updateWhatsappUrl();
      fields.forEach((field) => params.delete(field));
      const cleanUrl = `${window.location.pathname}${params.toString() ? `?${params}` : ''}${window.location.hash}`;
      window.history.replaceState({}, '', cleanUrl);
    }
  }

  // Update WhatsApp preview and URL with UTM-aware message
  function updateWhatsappUrl() {
    if (!(form instanceof HTMLFormElement)) return;

    const urlParams = new URLSearchParams(window.location.search);
    const utmSource = urlParams.get('utm_source') || '';
    const fullNameInput = form.querySelector('[name="fullName"]') as HTMLInputElement | null;
    const name = fullNameInput?.value?.trim() || '[আপনার নাম]';

    const msg = `আসসালামু আলাইকুম, আমি ${name}। আমি রুকইয়াহ সেবা বুক করতে চাই।${utmSource ? ` (Source: ${utmSource})` : ''}`;

    if (waMsgPreview) {
      waMsgPreview.textContent = msg;
    }

    if (whatsappDirectBtn) {
      const waUrl = `https://wa.me/8801336202150?text=${encodeURIComponent(msg)}`;
      whatsappDirectBtn.href = waUrl;
    }
  }

  // Listen to name input to update WhatsApp preview live
  const fullNameInput = form.querySelector('[name="fullName"]') as HTMLInputElement | null;
  fullNameInput?.addEventListener('input', updateWhatsappUrl);

  // Initialize WhatsApp URL on load
  updateWhatsappUrl();
  prefillFromUrl();

  // WhatsApp direct button — attach UTM-aware URL on load
  if (whatsappDirectBtn) {
    const utmSource = getUrlParam('utm_source');
    const msg = `আসসালামু আলাইকুম, আমি রুকইয়াহ সেবা বুক করতে চাই।${utmSource ? ` (Source: ${utmSource})` : ''}`;
    const waUrl = `https://wa.me/8801336202150?text=${encodeURIComponent(msg)}`;
    whatsappDirectBtn.href = waUrl;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submitBtn || !statusEl) return;

    const formData = new FormData(form);
    const values = {
      fullName: String(formData.get('fullName') || '').trim(),
      phone: normalizePhone(String(formData.get('phone') || '').trim()),
      preferredDate: String(formData.get('preferredDate') || '').trim(),
    };

    if (!validate(values)) return;

    submitBtn.disabled = true;
    statusEl.textContent = 'আপনার বুকিং প্রস্তুত হচ্ছে...';
    statusEl.className = 'form-status';

    try {
      const utmSource = getUrlParam('utm_source');
      const utmMedium = getUrlParam('utm_medium');
      const utmCampaign = getUrlParam('utm_campaign');
      const eventId = createEventId();

      // POST to appointments API
      const response = await fetch('/api/appointments', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          fullName: values.fullName,
          phone: values.phone,
          whatsapp: values.phone,
          preferredDate: values.preferredDate,
          preferredTime: 'সকাল ৯টা - সন্ধ্যা ৬টা',
          treatmentTypeKey: 'ruqyah',
          treatmentTypeLabel: 'রুকইয়াহ',
          serviceMode: 'চেম্বার সেবা',
          sessionFormat: 'ডায়াগনোসিস',
          address: 'Landing page lead',
          problem: 'রুকইয়াহ সেবা বুকিং',
          gender: 'উল্লেখ করা হয়নি',
          religion: 'মুসলিম',
          age: 'উল্লেখ করা হয়নি',
          weight: '',
          nid: '',
          duration: 'উল্লেখ করা হয়নি',
          previousTreatment: 'না',
          previousTreatmentDetails: '',
          subServices: [],
          paymentMethod: 'পরে জানানো হবে',
          transactionId: 'Landing page lead',
          paymentTimestamp: new Date().toISOString(),
          utmSource,
          utmMedium,
          utmCampaign,
          eventId,
        }),
      });

      const result = (await response.json().catch(() => ({}))) as {
        appointmentId?: string;
        message?: string;
      };

      if (!response.ok) {
        throw new Error(result.message || 'বুকিং সংরক্ষণ করা যায়নি।');
      }

      const appointmentId = result.appointmentId || '';

      // Build WhatsApp message with booking details
      const waMsg = `আসসালামু আলাইকুম,

আমি ${values.fullName}।

আমি রুকইয়াহ সেবা বুক করতে চাই।

📅 পছন্দের তারিখ: ${values.preferredDate}${appointmentId ? `\n\nBooking ID: ${appointmentId}` : ''}${utmSource ? `\nSource: ${utmSource}` : ''}`;

      statusEl.textContent = 'আপনার বুকিং সংরক্ষণ হয়েছে! এখন WhatsApp-এ বুকিং পাঠানো হচ্ছে...';
      statusEl.className = 'form-status success';

      const waUrl = `https://wa.me/8801336202150?text=${encodeURIComponent(waMsg)}`;
      window.open(waUrl, '_blank', 'noopener,noreferrer');

      // Fire analytics
      if (window.gtag) {
        window.gtag('event', 'generate_lead', {
          event_category: 'landing_booking',
          currency: 'BDT',
          value: 500,
          campaign: utmCampaign,
        });
      }
      if (window.fbq) {
        window.fbq('track', 'Lead', { content_category: 'ruqyah_booking' }, { eventID: eventId });
      }

      form.reset();
    } catch (err) {
      const msg = err instanceof Error ? err.message : 'কিছু ভুল হয়েছে। আবার চেষ্টা করুন।';
      statusEl.textContent = msg;
      statusEl.className = 'form-status error';
    } finally {
      submitBtn.disabled = false;
    }
  });
}

initBookingForm();
document.addEventListener('astro:page-load', initBookingForm);
</script>
