{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ruqyah-healing",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-03-17",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"ai": {
		"binding": "AI",
		"remote": true
	},
	"kv_namespaces": [
		{
			"binding": "AI_BUDGET",
			"id": "8d493972c8994df0a80c8de40539b222"
		}
	],
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	},
	"observability": {
		"enabled": true
	}
}
